---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
---
<Layout title="九星気学 | 陰陽寮">
  <div class="page">
    <div class="stars" id="stars"></div>
    <div class="page-inner">

      <header class="page-header fade-in-up">
        <div class="header-icon">⭐</div>
        <h1 class="page-title">九星気学</h1>
        <p class="page-desc">生年月日から、あなたの運命の羅針盤を読み解きます</p>
        <div class="header-divider"></div>
      </header>

      <section class="glass-card intro-card fade-in-up delay-1">
        <h2 class="intro-title">宇宙の「気」を読み解く運命学</h2>
        <p class="intro-text">九星気学は、古代中国を起源とする「気（エネルギー）」の法則をもとにした東洋占術です。宇宙のエネルギーを9つの星に分類し、生まれ持った宿命や才能、そして人生のバイオリズムを読み解きます。</p>
        <div class="intro-features">
          <div class="intro-feature">
            <span class="feature-icon">✧</span>
            <div>
              <p class="feature-title">本命星・月命星</p>
              <p class="feature-desc">生まれ年・月から算出する星が、本質と内面を照らします</p>
            </div>
          </div>
          <div class="intro-feature">
            <span class="feature-icon">🧭</span>
            <div>
              <p class="feature-title">吉方位</p>
              <p class="feature-desc">引越し・旅行・転職で使える、あなただけの最強パワースポット</p>
            </div>
          </div>
          <div class="intro-feature">
            <span class="feature-icon">⏳</span>
            <div>
              <p class="feature-title">年運・月運</p>
              <p class="feature-desc">9年・9ヶ月サイクルで変化する人生の波を読み解きます</p>
            </div>
          </div>
        </div>
        <div class="intro-note">
          <p>※ 九星気学では2月3日（節分）を年の区切りとします。1〜2月3日生まれの方は前年の本命星になる場合があります。</p>
        </div>
      </section>

      <section class="glass-card form-card fade-in-up delay-2" id="form-card">
        <div class="autofill-banner" id="autofill-banner" style="display:none"></div>
        <h3 class="form-title">⭐ あなたの「本命星」を無料で調べる</h3>
        <p class="form-sub">生年月日を入力するだけ。本命星と性格を無料で確認できます。</p>
        <div class="date-row">
          <div class="field"><label>生年（西暦）</label><input type="number" id="year" placeholder="1990" min="1900" max="2010" /></div>
          <div class="field"><label>月</label><select id="month">{Array.from({length:12},(_,i)=><option value={i+1}>{i+1}月</option>)}</select></div>
          <div class="field"><label>日</label><select id="day">{Array.from({length:31},(_,i)=><option value={i+1}>{i+1}日</option>)}</select></div>
        </div>
        <p class="error-msg" id="form-error"></p>
        <button class="btn-primary" id="preview-btn" onclick="runPreview()">⭐ 無料で本命星を調べる</button>
      </section>

      <section class="glass-card preview-card" id="preview-card" style="display:none">
        <div class="star-hero">
          <div class="star-badge-wrap">
            <div class="star-badge" id="p-badge"></div>
            <div class="star-glow"></div>
          </div>
          <div class="star-info">
            <p class="star-num-label" id="p-num"></p>
            <h2 class="star-name" id="p-name"></h2>
            <p class="star-sub" id="p-keisha"></p>
          </div>
        </div>

        <div class="star-meta-grid">
          <div class="meta-item">
            <span class="meta-label">月命星</span>
            <span class="meta-value" id="p-tsuki"></span>
          </div>
          <div class="meta-item">
            <span class="meta-label">生年月日</span>
            <span class="meta-value" id="p-birth"></span>
          </div>
        </div>

        <div class="personality-box" id="p-personality"></div>

        <div class="menu-section" id="menu-section" style="display:none">
          <p class="menu-title">✦ この本命星でできる鑑定</p>
          <div class="menu-grid">
            <a href="/fortune/kyuseiki/reading" class="menu-card-item">
              <span class="menu-icon">☽</span>
              <div class="menu-info">
                <p class="menu-name">基本鑑定</p>
                <p class="menu-desc">吉方位・才能・人生テーマ</p>
              </div>
              <span class="menu-cost">2<small>C</small></span>
            </a>
            <a href="/fortune/kyuseiki/yearly" class="menu-card-item">
              <span class="menu-icon">📅</span>
              <div class="menu-info">
                <p class="menu-name">年運詳細</p>
                <p class="menu-desc">今年の運気・恋愛・仕事・金運</p>
              </div>
              <span class="menu-cost">2<small>C</small></span>
            </a>
            <a href="/fortune/kyuseiki/monthly" class="menu-card-item">
              <span class="menu-icon">🌙</span>
              <div class="menu-info">
                <p class="menu-name">月運詳細</p>
                <p class="menu-desc">今月の運気・吉日・日別カレンダー</p>
              </div>
              <span class="menu-cost">2<small>C</small></span>
            </a>
            <a href="/fortune/kyuseiki/daily" class="menu-card-item">
              <span class="menu-icon">☀️</span>
              <div class="menu-info">
                <p class="menu-name">本日の運勢</p>
                <p class="menu-desc">ラッキーカラー・吉方角・おすすめ行動</p>
              </div>
              <span class="menu-cost">1<small>C</small></span>
            </a>
            <a href="/fortune/kyuseiki/compat" class="menu-card-item">
              <span class="menu-icon">❤️</span>
              <div class="menu-info">
                <p class="menu-name">相性鑑定</p>
                <p class="menu-desc">気になる人との恋愛・仕事相性</p>
              </div>
              <span class="menu-cost">3<small>C</small></span>
            </a>
            <a href="/fortune/sukuyo" class="menu-card-item">
              <span class="menu-icon">🌙</span>
              <div class="menu-info">
                <p class="menu-name">宿曜占星術</p>
                <p class="menu-desc">月の宿から深い本質を読む</p>
              </div>
              <span class="menu-cost">2<small>C</small></span>
            </a>
          </div>
          <div class="coin-bar">
            <span class="coin-bar-label">保有コイン</span>
            <span class="coin-bar-value" id="coin-balance">-- コイン</span>
          </div>
        </div>

        <div id="login-note" style="display:none">
          <div class="cta-box">
            <div class="cta-header-row">
              <div class="cta-ornament">✦</div>
              <h3 class="cta-title">あなたの運命を、もっと深く</h3>
              <div class="cta-ornament">✦</div>
            </div>
            <p class="cta-lead">本命星の性格はほんの一端。詳細鑑定では吉方位・年運・月運まで完全に読み解きます。</p>
            <div class="cta-features">
              <div class="cta-feature"><span>🧭</span><span>吉方位・凶方位の詳細解説</span></div>
              <div class="cta-feature"><span>📅</span><span>今年の年運（恋愛・仕事・金運）</span></div>
              <div class="cta-feature"><span>🌙</span><span>今月の月運詳細＋日ごとの運気</span></div>
              <div class="cta-feature"><span>❤️</span><span>気になる人との相性鑑定</span></div>
            </div>
            <a href="/register" class="btn-primary" style="display:block;text-decoration:none;text-align:center">無料登録して詳細鑑定を受ける</a>
            <p class="cta-login-link">すでにアカウントをお持ちの方は<a href="/login">ログイン</a></p>
          </div>
        </div>

        <button class="btn-clear" onclick="resetPreview()">別の生年月日で調べる</button>
      </section>

    </div>
  </div>
</Layout>

<style>
.page { padding: 3rem 1.5rem; min-height: 100vh; position: relative; }
.stars { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
.page-inner { max-width: 680px; margin: 0 auto; position: relative; z-index: 1; }
.page-header { text-align: center; margin-bottom: 2rem; }
.header-icon { font-size: 3.5rem; margin-bottom: 0.75rem; filter: drop-shadow(0 0 20px rgba(212,175,55,0.6)); animation: float 4s ease-in-out infinite; }
@keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }
.page-title { font-family: 'Shippori Mincho', serif; font-size: 2rem; color: #fde68a; text-shadow: 0 0 30px rgba(212,175,55,0.4); margin-bottom: 0.5rem; }
.page-desc { font-size: 14px; color: var(--text-secondary); }
.header-divider { width: 60px; height: 1px; background: linear-gradient(90deg,transparent,var(--gold),transparent); margin: 1rem auto 0; }
.intro-card { border-top: 2px solid var(--gold); background: linear-gradient(180deg, rgba(30,24,8,0.7) 0%, rgba(10,12,16,0.85) 100%); margin-bottom: 1.5rem; }
.intro-title { font-family: 'Shippori Mincho', serif; font-size: 1.25rem; color: #fde68a; margin-bottom: 1rem; text-align: center; }
.intro-text { font-size: 14px; color: var(--text-secondary); line-height: 2; margin-bottom: 1.5rem; }
.intro-features { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.25rem; }
.intro-feature { display: flex; gap: 1rem; align-items: flex-start; background: rgba(212,175,55,0.06); border-radius: var(--radius-md); padding: 0.875rem; border: 0.5px solid rgba(212,175,55,0.15); }
.feature-icon { font-size: 20px; flex-shrink: 0; color: var(--gold); }
.feature-title { font-size: 13px; color: #fde68a; font-family: 'Shippori Mincho', serif; margin-bottom: 2px; }
.feature-desc { font-size: 12px; color: var(--text-secondary); line-height: 1.7; }
.intro-note { background: rgba(255,255,255,0.03); border-radius: var(--radius-md); padding: 0.75rem 1rem; border: 0.5px solid rgba(255,255,255,0.07); }
.intro-note p { font-size: 12px; color: var(--text-secondary); margin: 0; }
.form-card { margin-bottom: 1.25rem; }
.form-title { font-family: 'Shippori Mincho', serif; font-size: 17px; color: #fde68a; margin-bottom: 0.5rem; }
.form-sub { font-size: 13px; color: var(--text-secondary); margin-bottom: 1.25rem; }
.date-row { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 8px; margin-bottom: 1rem; }
.field { display: flex; flex-direction: column; gap: 4px; }
.field label { font-size: 11px; color: var(--text-secondary); }
.autofill-banner { background: rgba(16,185,129,0.1); border: 0.5px solid rgba(16,185,129,0.3); border-radius: var(--radius-md); padding: 0.6rem 1rem; font-size: 13px; color: #6ee7b7; margin-bottom: 1rem; }
.error-msg { font-size: 13px; color: #ff8e8e; min-height: 1.2em; margin: 0 0 0.5rem; }
.preview-card { border-top: 2px solid var(--gold); background: linear-gradient(180deg, rgba(30,24,8,0.8), rgba(10,12,16,0.9)); }
.star-hero { display: flex; align-items: center; gap: 1.5rem; margin-bottom: 1.25rem; }
.star-badge-wrap { position: relative; flex-shrink: 0; }
.star-badge { width: 72px; height: 72px; border-radius: 50%; background: linear-gradient(135deg, #d4af37, #8b6d20); display: flex; align-items: center; justify-content: center; font-family: 'Shippori Mincho', serif; font-size: 26px; color: #000; font-weight: bold; position: relative; z-index: 1; }
.star-glow { position: absolute; inset: -8px; background: radial-gradient(circle, rgba(212,175,55,0.35) 0%, transparent 70%); border-radius: 50%; }
.star-num-label { font-size: 11px; color: var(--gold); letter-spacing: 0.15em; margin-bottom: 4px; }
.star-name { font-family: 'Shippori Mincho', serif; font-size: 1.75rem; color: #f0e6d3; margin-bottom: 4px; }
.star-sub { font-size: 13px; color: var(--text-secondary); }
.star-meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem; }
.meta-item { background: rgba(255,255,255,0.04); border-radius: var(--radius-md); padding: 0.75rem 1rem; display: flex; flex-direction: column; gap: 4px; border: 0.5px solid rgba(255,255,255,0.08); }
.meta-label { font-size: 10px; color: var(--text-secondary); letter-spacing: 0.05em; }
.meta-value { font-size: 15px; color: #f0e6d3; font-family: 'Shippori Mincho', serif; }
.personality-box { background: rgba(212,175,55,0.06); border-left: 3px solid var(--gold); padding: 1.25rem; font-size: 14px; line-height: 2; color: var(--text-secondary); border-radius: 0 var(--radius-md) var(--radius-md) 0; margin-bottom: 1.5rem; }
.menu-section { margin-bottom: 1.25rem; }
.menu-title { font-size: 13px; color: var(--gold); letter-spacing: 0.1em; margin-bottom: 0.75rem; }
.menu-grid { display: flex; flex-direction: column; gap: 0.625rem; margin-bottom: 1.25rem; }
.menu-card-item { display: flex; align-items: center; gap: 1rem; padding: 0.875rem 1.25rem; background: rgba(212,175,55,0.06); border: 0.5px solid rgba(212,175,55,0.18); border-radius: var(--radius-md); text-decoration: none; transition: all 0.2s; }
.menu-card-item:hover { background: rgba(212,175,55,0.12); border-color: rgba(212,175,55,0.4); transform: translateX(4px); }
.menu-icon { font-size: 24px; flex-shrink: 0; }
.menu-info { flex: 1; }
.menu-name { font-family: 'Shippori Mincho', serif; font-size: 15px; color: #f0e6d3; margin-bottom: 2px; }
.menu-desc { font-size: 12px; color: var(--text-secondary); }
.menu-cost { font-size: 1.2rem; font-weight: bold; color: var(--gold); background: rgba(212,175,55,0.1); padding: 5px 10px; border-radius: 10px; border: 0.5px solid rgba(212,175,55,0.25); white-space: nowrap; }
.menu-cost small { font-size: 0.65rem; margin-left: 1px; }
.coin-bar { display: flex; align-items: center; gap: 0.75rem; background: rgba(212,175,55,0.06); border: 0.5px solid rgba(212,175,55,0.18); border-radius: var(--radius-md); padding: 0.6rem 1rem; }
.coin-bar-label { font-size: 12px; color: var(--text-secondary); }
.coin-bar-value { font-size: 16px; color: #fde68a; font-weight: 500; }
.cta-box { background: linear-gradient(160deg, rgba(30,24,8,0.8), rgba(10,12,16,0.9)); border: 0.5px solid rgba(212,175,55,0.25); border-radius: var(--radius-lg); padding: 1.75rem; margin-bottom: 1.25rem; }
.cta-header-row { display: flex; align-items: center; justify-content: center; gap: 0.75rem; margin-bottom: 0.75rem; }
.cta-ornament { font-size: 14px; color: var(--gold); opacity: 0.6; }
.cta-title { font-family: 'Shippori Mincho', serif; font-size: 1.1rem; color: #f0e6d3; margin: 0; }
.cta-lead { font-size: 13px; color: var(--text-secondary); line-height: 1.9; margin-bottom: 1.25rem; text-align: center; }
.cta-features { display: flex; flex-direction: column; gap: 0.625rem; margin-bottom: 1.5rem; background: rgba(255,255,255,0.03); border-radius: var(--radius-md); padding: 1rem; border: 0.5px solid rgba(255,255,255,0.07); }
.cta-feature { display: flex; align-items: center; gap: 0.75rem; font-size: 13px; color: #f0e6d3; }
.cta-feature span:first-child { font-size: 16px; flex-shrink: 0; }
.cta-login-link { font-size: 12px; color: var(--text-secondary); text-align: center; margin-top: 0.75rem; }
.cta-login-link a { color: var(--gold); text-decoration: underline; }
.btn-clear { display: block; width: 100%; margin-top: 1rem; background: none; border: 0.5px solid rgba(255,255,255,0.15); color: var(--text-secondary); padding: 0.6rem; border-radius: var(--radius-md); font-size: 13px; cursor: pointer; font-family: 'Noto Serif JP', serif; transition: all 0.2s; }
.btn-clear:hover { border-color: rgba(255,255,255,0.3); color: #f0e6d3; }
@keyframes twinkle { 0%,100%{opacity:0.15}50%{opacity:0.7} }
</style>

<script is:inline>
const WORKERS_URL = 'https://kyusei-api.seiji-tomizawa.workers.dev';
const STARS = ['一白水星','二黒土星','三碧木星','四緑木星','五黄土星','六白金星','七赤金星','八白土星','九紫火星'];
const STAR_CHARS = { 1:'水',2:'土',3:'木',4:'木',5:'土',6:'金',7:'金',8:'土',9:'火' };

function calcTsuki(honmei, month, day) {
  const setsuiri = {1:6,2:4,3:6,4:5,5:6,6:6,7:7,8:8,9:8,10:8,11:7,12:7};
  let m = month;
  if (day < (setsuiri[month] ?? 6)) m = month === 1 ? 12 : month - 1;
  const group = (honmei - 1) % 3;
  const base = [8,2,5][group];
  const offset = (m === 1 ? 13 : m) - 2;
  return ((base - offset - 1 + 90) % 9) + 1;
}

async function loadBalance(token) {
  try {
    const res = await fetch(`${WORKERS_URL}/api/coins/balance`, { headers: { Authorization: 'Bearer ' + token } });
    const data = await res.json();
    document.getElementById('coin-balance').textContent = data.coins + ' コイン';
  } catch {}
}

// runPreview を先に定義
window.runPreview = async function(auto) {
  const year = document.getElementById('year').value;
  const month = document.getElementById('month').value;
  const day = document.getElementById('day').value;
  const errEl = document.getElementById('form-error');
  if (!year || parseInt(year) < 1900 || parseInt(year) > 2010) {
    if (!auto) errEl.textContent = '生年を正しく入力してください（1900〜2010）';
    return;
  }
  errEl.textContent = '';
  const btn = document.getElementById('preview-btn');
  if (!auto) { btn.textContent = '調べています...'; btn.disabled = true; }
  try {
    const res = await fetch(`${WORKERS_URL}/api/fortune/preview?year=${year}&month=${month}&day=${day}`);
    const data = await res.json();
    const h = data.honmeiseiNumber || 1;
    document.getElementById('p-badge').textContent = STAR_CHARS[h] || '★';
    document.getElementById('p-num').textContent = '第' + h + '星 · 本命星';
    document.getElementById('p-name').textContent = data.honmeisei || STARS[h - 1];
    document.getElementById('p-keisha').textContent = data.keishakyuu || '';
    document.getElementById('p-tsuki').textContent = STARS[calcTsuki(h, parseInt(month), parseInt(day)) - 1];
    document.getElementById('p-birth').textContent = year + '年' + month + '月' + day + '日';
    document.getElementById('p-personality').textContent = data.personality || '';
    const token = localStorage.getItem('kyusei_token');
    if (token) {
      document.getElementById('menu-section').style.display = 'block';
      document.getElementById('login-note').style.display = 'none';
      loadBalance(token);
    } else {
      document.getElementById('menu-section').style.display = 'none';
      document.getElementById('login-note').style.display = 'block';
    }
    document.getElementById('form-card').style.display = 'none';
    document.getElementById('preview-card').style.display = 'block';
    if (!auto) document.getElementById('preview-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
  } catch {
    if (!auto) errEl.textContent = 'エラーが発生しました。しばらくしてお試しください。';
    if (auto) document.getElementById('form-card').style.display = 'block';
  } finally {
    if (!auto) { btn.textContent = '⭐ 無料で本命星を調べる'; btn.disabled = false; }
  }
};

window.resetPreview = function() {
  document.getElementById('preview-card').style.display = 'none';
  document.getElementById('form-card').style.display = 'block';
  document.getElementById('year').value = '';
  document.getElementById('form-error').textContent = '';
  window.scrollTo({ top: 0, behavior: 'smooth' });
};

// runPreview 定義後に init を実行
(function init() {
  const token = localStorage.getItem('kyusei_token');
  const user = JSON.parse(localStorage.getItem('kyusei_user') || 'null');
  if (!user?.birth_date) return;
  const [y, m, d] = user.birth_date.split('-').map(Number);
  document.getElementById('year').value = y;
  document.getElementById('month').value = m;
  document.getElementById('day').value = d;
  const name = user.display_name || user.email?.split('@')[0] || '';
  if (name) {
    const b = document.getElementById('autofill-banner');
    b.textContent = name + 'さんの生年月日を自動入力しました';
    b.style.display = 'block';
  }
  if (token) window.runPreview(true);
})();

const starsEl = document.getElementById('stars');
for (let i = 0; i < 60; i++) {
  const s = document.createElement('div');
  const size = Math.random() * 2 + 1;
  s.style.cssText = `position:absolute;border-radius:50%;background:#fff;width:${size}px;height:${size}px;top:${Math.random()*100}%;left:${Math.random()*100}%;opacity:${Math.random()*0.4+0.1};animation:twinkle ${2+Math.random()*3}s ease-in-out infinite;animation-delay:${Math.random()*3}s;`;
  starsEl.appendChild(s);
}
</script>