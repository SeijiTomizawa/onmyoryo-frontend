<!-- /src/pages/fortune/kyuseiki.astro -->
---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
---

<Layout title="九星気学 鑑定 | 東洋占術">
  <div class="page">
    <div class="stars" id="stars"></div>

    <div class="page-inner">
      <header class="page-header fade-in-up">
        <h1 class="page-title">九星気学</h1>
        <p class="page-desc">生年月日から、あなたの運命の羅針盤を読み解きます</p>
      </header>

      <div class="glass-card intro-card fade-in-up delay-1">
        <h2 class="intro-title">宇宙の「気」を読み解く運命学</h2>

        <div class="intro-section">
          <h3 class="intro-section-title">九星気学とは</h3>
          <p class="intro-text">
            九星気学（きゅうせいきがく）は、古代中国を起源とする「気（エネルギー）」の法則をもとにした東洋占術です。
            宇宙のエネルギーを一白水星・二黒土星・三碧木星・四緑木星・五黄土星・六白金星・七赤金星・八白土星・九紫火星の9つに分類し、
            生まれ持った宿命や才能、そして人生のバイオリズムを読み解きます。
          </p>
        </div>

        <div class="intro-section">
          <h3 class="intro-section-title">本命星・月命星・傾斜宮</h3>
          <p class="intro-text">
            九星気学では主に3つの星を使います。生まれた年から算出する「本命星（ほんめいせい）」があなたの本質と表の性格を表し、
            生まれた月から算出する「月命星（つきめいせい）」が内面と感情パターンを表します。
            この2つの組み合わせを「傾斜宮（けいしゃきゅう）」と呼び、より深い宿命の読み解きに使います。
          </p>
        </div>

        <div class="intro-section">
          <h3 class="intro-section-title">吉方位とは</h3>
          <p class="intro-text">
            九星気学の最大の特徴が「方位学（ほういがく）」です。本命星によって吉方位・凶方位が決まり、
            引越し・旅行・転職・結婚など人生の重要な決断において、吉方位を活用することで運気を大きく引き寄せることができます。
          </p>
        </div>

        <div class="intro-features">
          <div class="intro-feature">
            <span class="feature-icon">✧</span>
            <span><strong>本命星：本質と才能</strong><br>生まれ年から算出する本命星が示す、あなたの真の姿・性格・才能・人生テーマ</span>
          </div>
          <div class="intro-feature">
            <span class="feature-icon">☽</span>
            <span><strong>月命星：内面と感情</strong><br>生まれ月から算出する月命星が示す、感情パターン・対人関係・内なる欲求</span>
          </div>
          <div class="intro-feature">
            <span class="feature-icon">🧭</span>
            <span><strong>吉方位：運を引き寄せる方角</strong><br>引越し・旅行・転職など重要な行動で活用する、あなただけの最強パワースポット</span>
          </div>
          <div class="intro-feature">
            <span class="feature-icon">⏳</span>
            <span><strong>年運・月運：運命の波</strong><br>今は攻める時か、守る時か。9年・9ヶ月サイクルで変化する人生の波を読む</span>
          </div>
        </div>

        <div class="intro-note">
          <p>※ 九星気学では2月3日（節分）を年の区切りとします。1〜2月3日生まれの方は前年の本命星になる場合があります。</p>
        </div>
      </div>

      <!-- 入力フォーム -->
      <div class="glass-card form-card fade-in-up delay-2">
        <div class="autofill-banner" id="autofill-banner" style="display:none"></div>
        <div class="date-row">
          <div class="field">
            <label>生年（西暦）</label>
            <input type="number" id="year" placeholder="1990" min="1900" max="2010" />
          </div>
          <div class="field">
            <label>月</label>
            <select id="month">
              {Array.from({length:12},(_,i)=>(
                <option value={i+1}>{i+1}月</option>
              ))}
            </select>
          </div>
          <div class="field">
            <label>日</label>
            <select id="day">
              {Array.from({length:31},(_,i)=>(
                <option value={i+1}>{i+1}日</option>
              ))}
            </select>
          </div>
        </div>
        <p class="error-msg" id="form-error"></p>
        <button class="btn-primary" id="preview-btn" onclick="runPreview()">✦ 無料鑑定を開始する</button>
      </div>

      <!-- 無料鑑定結果 -->
      <div id="result-section" style="display:none">
        <div class="result-grid">

          <!-- 本命星カード（無料） -->
          <div class="glass-card result-item star-card">
            <p class="star-label" id="res-star-num"></p>
            <h2 class="result-title" id="res-star-name"></h2>
            <p class="star-sub" id="res-keisha"></p>
            <div class="star-grid-info">
              <div class="mini-card">
                <p class="mini-label">月命星</p>
                <p class="mini-value" id="res-tsuki"></p>
              </div>
              <div class="mini-card">
                <p class="mini-label">生年月日</p>
                <p class="mini-value" id="res-birth"></p>
              </div>
            </div>
            <div class="personality-box" id="res-personality"></div>
          </div>

          <!-- 有料誘導CTA -->
          <div class="glass-card result-item premium-cta">
            <div class="cta-header">
              <div class="cta-ornament">✦</div>
              <h3 class="cta-title">あなたの運命を、もっと深く</h3>
              <div class="cta-ornament">✦</div>
            </div>
            <p class="cta-lead">本命星の性格はほんの一端。<br>詳細鑑定では吉方位・今年の年運・今月の運気まで完全に読み解きます。</p>

            <div class="cta-features">
              <div class="cta-feature">
                <span class="cta-feature-icon">🧭</span>
                <div>
                  <p class="cta-feature-name">吉方位・凶方位の詳細解説</p>
                  <p class="cta-feature-desc">引越し・旅行・転職で使える具体的な方位アドバイス</p>
                </div>
              </div>
              <div class="cta-feature">
                <span class="cta-feature-icon">📅</span>
                <div>
                  <p class="cta-feature-name">今年の年運（恋愛・仕事・金運）</p>
                  <p class="cta-feature-desc">2026年のあなたへの詳細なメッセージ</p>
                </div>
              </div>
              <div class="cta-feature">
                <span class="cta-feature-icon">🌙</span>
                <div>
                  <p class="cta-feature-name">今月の月運詳細＋日ごとの運気</p>
                  <p class="cta-feature-desc">吉日・注意日・カレンダーで今月を完全把握</p>
                </div>
              </div>
              <div class="cta-feature">
                <span class="cta-feature-icon">❤️</span>
                <div>
                  <p class="cta-feature-name">気になる人との相性鑑定</p>
                  <p class="cta-feature-desc">恋愛・仕事の相性と縁の深さを読み解く</p>
                </div>
              </div>
            </div>

            <div class="cta-divider"><span>コインをチャージして鑑定する</span></div>

            <div class="cta-plans">
              <div class="cta-plan" onclick="window.location.href='/register'">
                <p class="cta-plan-coin">100C</p>
                <p class="cta-plan-price">¥500</p>
                <p class="cta-plan-note">お試し</p>
              </div>
              <div class="cta-plan cta-plan-featured" onclick="window.location.href='/register'">
                <p class="cta-plan-badge">人気</p>
                <p class="cta-plan-coin">300C</p>
                <p class="cta-plan-price">¥1,200</p>
                <p class="cta-plan-note">おすすめ</p>
              </div>
              <div class="cta-plan" onclick="window.location.href='/register'">
                <p class="cta-plan-coin">500C</p>
                <p class="cta-plan-price">¥1,800</p>
                <p class="cta-plan-note">お得</p>
              </div>
            </div>

            <p class="cta-note">1コイン = ¥5相当 · 期限なし · いつでも利用可能</p>
            <button class="cta-btn" onclick="window.location.href='/register'">
              無料登録して詳細鑑定を受ける
            </button>
            <p class="cta-sub">登録無料 · 1分で完了 · クレジットカード不要</p>
          </div>

          <!-- ログイン済みユーザー向けメニュー -->
          <div class="glass-card result-item paid-menu" id="paid-menu" style="display:none">
            <h3 class="paid-menu-title">✦ 詳細鑑定メニュー</h3>
            <p class="paid-menu-desc">コインを使って、さらに深い鑑定を受けましょう。</p>
            <div class="paid-menu-grid">
              <a href="/fortune/daily" class="paid-menu-btn">
                <span class="paid-menu-icon">☀️</span>
                <div>
                  <p class="paid-menu-name">本日の運勢鑑定</p>
                  <p class="paid-menu-sub">ラッキーカラー・吉方角・おすすめ行動</p>
                </div>
                <span class="paid-menu-cost">1C</span>
              </a>
              <a href="/fortune/monthly" class="paid-menu-btn">
                <span class="paid-menu-icon">🌙</span>
                <div>
                  <p class="paid-menu-name">今月の月運詳細</p>
                  <p class="paid-menu-sub">今月の運気・吉日・日別カレンダー</p>
                </div>
                <span class="paid-menu-cost">2C</span>
              </a>
              <a href="/fortune/compat" class="paid-menu-btn">
                <span class="paid-menu-icon">❤️</span>
                <div>
                  <p class="paid-menu-name">相性鑑定</p>
                  <p class="paid-menu-sub">気になる人との恋愛・仕事相性</p>
                </div>
                <span class="paid-menu-cost">3C</span>
              </a>
              <a href="/fortune/eki" class="paid-menu-btn">
                <span class="paid-menu-icon">☰</span>
                <div>
                  <p class="paid-menu-name">易占い</p>
                  <p class="paid-menu-sub">今の悩みに具体的な答えを</p>
                </div>
                <span class="paid-menu-cost">1C</span>
              </a>
              <a href="/fortune/sukuyo" class="paid-menu-btn">
                <span class="paid-menu-icon">🌙</span>
                <div>
                  <p class="paid-menu-name">宿曜占星術</p>
                  <p class="paid-menu-sub">月の宿から深い本質を読む</p>
                </div>
                <span class="paid-menu-cost">2C</span>
              </a>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
.stars { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
.page { padding: 3rem 1.5rem; min-height: 100vh; position: relative; }
.page-inner { max-width: 680px; margin: 0 auto; position: relative; z-index: 1; }
.page-header { text-align: center; margin-bottom: 2rem; }
.page-title { font-family: 'Shippori Mincho', serif; font-size: 26px; margin-bottom: 0.5rem; }
.page-desc { font-size: 14px; color: var(--text-secondary); }

.result-grid { display: grid; gap: 1.5rem; margin-top: 3rem; }

.intro-card {
  text-align: center; margin-bottom: 2rem;
  border-top: 2px solid var(--gold);
  background: linear-gradient(180deg, rgba(30,36,56,0.5) 0%, rgba(10,12,16,0.8) 100%);
}
.intro-title { font-family: 'Shippori Mincho', serif; font-size: 1.4rem; color: var(--gold); margin-bottom: 1.25rem; }
.intro-text { font-size: 15px; color: var(--text-secondary); line-height: 2; margin-bottom: 1rem; }
.intro-features { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-top: 1.5rem; }
.intro-feature { display: flex; align-items: flex-start; gap: 0.75rem; text-align: left; background: rgba(255,255,255,0.03); padding: 1.25rem 1rem; border-radius: var(--radius-md); border: 1px solid rgba(255,255,255,0.05); flex: 1; min-width: 200px; }
.feature-icon { font-size: 1.4rem; color: var(--gold); line-height: 1; }
.intro-feature span { font-size: 14px; color: var(--text-secondary); line-height: 1.7; }
.intro-feature strong { display: block; color: #fff; font-size: 15px; margin-bottom: 0.25rem; font-family: 'Shippori Mincho', serif; }
.intro-section { margin-bottom: 1.25rem; text-align: left; }
.intro-section-title { font-family: 'Shippori Mincho', serif; font-size: 15px; color: var(--gold); margin-bottom: 0.5rem; }
.intro-note { margin-top: 1.25rem; padding: 0.75rem 1rem; background: rgba(255,255,255,0.03); border-radius: var(--radius-md); border: 0.5px solid rgba(255,255,255,0.08); }
.intro-note p { font-size: 12px; color: var(--text-secondary); margin: 0; }

.form-card { margin-bottom: 2rem; }
.date-row { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 8px; margin-bottom: 1rem; }
.field { display: flex; flex-direction: column; gap: 4px; }
.field label { font-size: 11px; color: var(--text-secondary); }
.autofill-banner { background: rgba(29,158,117,0.12); border: 0.5px solid rgba(29,158,117,0.3); border-radius: var(--radius-md); padding: 0.6rem 1rem; font-size: 13px; color: #1d9e75; margin-bottom: 1rem; }

/* 無料鑑定結果 */
.star-card { text-align: center; border-top: 3px solid var(--gold); padding: 2.5rem; }
.star-label { font-size: 12px; color: var(--gold); letter-spacing: 0.2em; margin-bottom: 0.5rem; }
.star-sub { font-size: 13px; color: var(--text-secondary); margin-bottom: 2rem; }
.star-grid-info { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 1.5rem; }
.mini-card { background: rgba(255,255,255,0.03); padding: 1rem; border-radius: var(--radius-md); border: 1px solid rgba(255,255,255,0.05); }
.mini-label { font-size: 11px; color: var(--text-secondary); margin-bottom: 4px; }
.mini-value { font-size: 15px; font-weight: 500; color: #fff; }
.personality-box { background: rgba(176,141,90,0.08); border-left: 3px solid var(--gold); padding: 1.5rem; font-size: 15px; line-height: 2; text-align: left; border-radius: 0 12px 12px 0; }

/* Premium CTA */
.premium-cta { background: linear-gradient(160deg, rgba(20,16,8,0.95), rgba(30,24,10,0.95)); border: 1px solid rgba(212,175,55,0.3); padding: 2.5rem; text-align: center; position: relative; overflow: hidden; }
.premium-cta::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 0%, rgba(212,175,55,0.08) 0%, transparent 70%); pointer-events: none; }
.cta-header { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-bottom: 1rem; }
.cta-ornament { font-size: 14px; color: var(--gold); opacity: 0.6; }
.cta-title { font-family: 'Shippori Mincho', serif; font-size: 22px; color: #f0e6d3; letter-spacing: 0.05em; margin: 0; }
.cta-lead { font-size: 15px; color: var(--text-secondary); line-height: 1.9; margin-bottom: 2rem; }
.cta-features { display: flex; flex-direction: column; gap: 12px; margin-bottom: 2rem; text-align: left; background: rgba(255,255,255,0.03); border-radius: var(--radius-lg); padding: 1.25rem; border: 0.5px solid rgba(255,255,255,0.08); }
.cta-feature { display: flex; align-items: center; gap: 12px; }
.cta-feature-icon { font-size: 20px; flex-shrink: 0; }
.cta-feature-name { font-size: 14px; color: #f0e6d3; margin: 0 0 2px; font-weight: 500; }
.cta-feature-desc { font-size: 12px; color: var(--text-secondary); margin: 0; }
.cta-divider { display: flex; align-items: center; gap: 12px; margin-bottom: 1.25rem; color: var(--text-muted); font-size: 12px; }
.cta-divider::before, .cta-divider::after { content: ''; flex: 1; height: 0.5px; background: rgba(212,175,55,0.2); }
.cta-plans { display: flex; gap: 10px; margin-bottom: 1rem; }
.cta-plan { flex: 1; background: rgba(255,255,255,0.04); border: 0.5px solid rgba(255,255,255,0.15); border-radius: var(--radius-md); padding: 1rem 0.5rem; cursor: pointer; transition: all 0.2s; position: relative; text-align: center; }
.cta-plan:hover { border-color: var(--gold); background: rgba(212,175,55,0.06); transform: translateY(-2px); }
.cta-plan-featured { border-color: rgba(212,175,55,0.5); background: rgba(212,175,55,0.08); box-shadow: 0 0 20px rgba(212,175,55,0.1); }
.cta-plan-badge { position: absolute; top: -10px; left: 50%; transform: translateX(-50%); background: var(--gold); color: #000; font-size: 10px; font-weight: bold; padding: 2px 10px; border-radius: 999px; white-space: nowrap; }
.cta-plan-coin { font-size: 18px; font-weight: bold; color: #f0e6d3; margin: 0 0 4px; }
.cta-plan-price { font-size: 13px; color: var(--gold); margin: 0 0 4px; }
.cta-plan-note { font-size: 10px; color: var(--text-muted); margin: 0; }
.cta-note { font-size: 11px; color: var(--text-muted); margin-bottom: 1.5rem; }
.cta-btn { width: 100%; padding: 1rem; background: linear-gradient(135deg, #b08d5a, #7a5c2e); color: #fff; border: none; border-radius: var(--radius-md); font-family: 'Shippori Mincho', serif; font-size: 16px; cursor: pointer; letter-spacing: 0.05em; transition: all 0.2s; margin-bottom: 0.75rem; }
.cta-btn:hover { background: linear-gradient(135deg, #c9a96e, #8b6d20); box-shadow: 0 4px 20px rgba(176,141,90,0.3); transform: translateY(-1px); }
.cta-sub { font-size: 12px; color: var(--text-muted); margin: 0; }

/* ログイン済み詳細メニュー */
.paid-menu { border-top: 2px solid var(--gold); }
.paid-menu-title { font-family: 'Shippori Mincho', serif; font-size: 18px; color: #f0e6d3; margin-bottom: 0.5rem; }
.paid-menu-desc { font-size: 13px; color: var(--text-secondary); margin-bottom: 1.25rem; }
.paid-menu-grid { display: flex; flex-direction: column; gap: 10px; }
.paid-menu-btn { display: flex; align-items: center; gap: 1rem; padding: 1rem 1.25rem; background: rgba(255,255,255,0.04); border: 0.5px solid rgba(255,255,255,0.1); border-radius: var(--radius-md); text-decoration: none; transition: all 0.2s; }
.paid-menu-btn:hover { border-color: var(--gold); background: rgba(212,175,55,0.06); transform: translateX(4px); }
.paid-menu-icon { font-size: 24px; flex-shrink: 0; }
.paid-menu-name { font-size: 15px; color: #f0e6d3; margin: 0 0 2px; font-family: 'Shippori Mincho', serif; }
.paid-menu-sub { font-size: 12px; color: var(--text-secondary); margin: 0; }
.paid-menu-cost { margin-left: auto; font-size: 13px; color: var(--gold); background: rgba(212,175,55,0.15); padding: 4px 12px; border-radius: 999px; border: 0.5px solid rgba(212,175,55,0.3); flex-shrink: 0; }

@keyframes twinkle { 0%,100% { opacity: 0.3; transform: scale(0.8); } 50% { opacity: 1; transform: scale(1.1); } }
</style>

<script is:inline>
const STARS = ['一白水星','二黒土星','三碧木星','四緑木星','五黄土星','六白金星','七赤金星','八白土星','九紫火星'];
const DIRECTIONS = {
  1:{lucky:['北','東','南東'],unlucky:['南','北東','南西']},
  2:{lucky:['南西','北西','西'],unlucky:['東','南東','北']},
  3:{lucky:['東','南','北'],unlucky:['西','北西','南西']},
  4:{lucky:['南東','北','東'],unlucky:['北西','西','南']},
  5:{lucky:['北東','南西','中央'],unlucky:['東','南東','西']},
  6:{lucky:['北西','西','南西'],unlucky:['東','北東','南']},
  7:{lucky:['西','北西','北東'],unlucky:['東','南東','南']},
  8:{lucky:['北東','南','北西'],unlucky:['西','南西','東']},
  9:{lucky:['南','東','南東'],unlucky:['北','北西','西']},
};

function calcTsuki(honmei, month, day) {
  const setsuiri = {1:6,2:4,3:6,4:5,5:6,6:6,7:7,8:8,9:8,10:8,11:7,12:7};
  let m = month;
  if (day < (setsuiri[month] ?? 6)) m = month === 1 ? 12 : month - 1;
  const group = (honmei - 1) % 3;
  const base = [8,2,5][group];
  const offset = (m === 1 ? 13 : m) - 2;
  return ((base - offset - 1 + 90) % 9) + 1;
}

// 自動入力
(function() {
  const user = JSON.parse(localStorage.getItem('kyusei_user') || 'null');
  if (!user || !user.birth_date) return;
  const [y, m, d] = user.birth_date.split('-').map(Number);
  const yearEl = document.getElementById('year');
  if (yearEl) yearEl.value = y;
  const monthEl = document.getElementById('month');
  if (monthEl) monthEl.value = m;
  const dayEl = document.getElementById('day');
  if (dayEl) dayEl.value = d;
  const banner = document.getElementById('autofill-banner');
  if (banner) {
    const name = user.display_name || user.email.split('@')[0];
    banner.textContent = `${name}さんの生年月日（${y}年${m}月${d}日）を自動入力しました`;
    banner.style.display = 'block';
  }
})();

window.runPreview = async function() {
  const year = document.getElementById('year').value;
  const month = document.getElementById('month').value;
  const day = document.getElementById('day').value;
  const errEl = document.getElementById('form-error');

  if (!year || parseInt(year) < 1900 || parseInt(year) > 2010) {
    errEl.textContent = '生年を入力してください（1900〜2010）'; return;
  }
  errEl.textContent = '';

  const btn = document.getElementById('preview-btn');
  const originalText = btn.textContent;
  btn.textContent = '運命を読み解き中...'; btn.disabled = true;

  try {
    const res = await fetch(
      `https://kyusei-api.seiji-tomizawa.workers.dev/api/fortune/preview?year=${year}&month=${month}&day=${day}`
    );
    const data = await res.json();

    const h = data.honmeiseiNumber || 1;
    const starName = data.honmeisei || STARS[h-1];

    // 本命星・性格のみ表示
    document.getElementById('res-star-num').textContent = `第${h}星 · 本命星`;
    document.getElementById('res-star-name').textContent = starName;
    document.getElementById('res-tsuki').textContent = STARS[calcTsuki(h, parseInt(month), parseInt(day)) - 1];
    document.getElementById('res-birth').textContent = `${year}年${month}月${day}日`;
    document.getElementById('res-keisha').textContent = data.keishakyuu || '';
    document.getElementById('res-personality').textContent = data.personality;

    // ログイン済みなら詳細メニューを表示、未ログインならCTAを表示
    const token = localStorage.getItem('kyusei_token');
    if (token) {
      document.querySelector('.premium-cta').style.display = 'none';
      document.getElementById('paid-menu').style.display = 'block';
    } else {
      document.querySelector('.premium-cta').style.display = 'block';
      document.getElementById('paid-menu').style.display = 'none';
    }

    const section = document.getElementById('result-section');
    section.style.display = 'block';
    setTimeout(() => {
      section.querySelectorAll('.result-item').forEach((item, idx) => {
        setTimeout(() => item.classList.add('show'), idx * 150);
      });
      section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 100);

  } catch (e) {
    errEl.textContent = 'システムエラーが発生しました。しばらくしてお試しください。';
  } finally {
    btn.textContent = originalText; btn.disabled = false;
  }
};

// 星背景
const starsEl = document.getElementById('stars');
if (starsEl) {
  for (let i = 0; i < 60; i++) {
    const s = document.createElement('div');
    const size = Math.random() * 2 + 1;
    s.style.cssText = `position:absolute;border-radius:50%;background:#fff;width:${size}px;height:${size}px;top:${Math.random()*100}%;left:${Math.random()*100}%;opacity:${Math.random()*0.6+0.1};animation:twinkle ${2+Math.random()*3}s ease-in-out infinite;animation-delay:${Math.random()*3}s;`;
    starsEl.appendChild(s);
  }
}
</script>