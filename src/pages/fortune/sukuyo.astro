---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
---
<Layout title="宿曜占星術 | 陰陽寮">
  <div class="page">
    <div class="stars" id="stars"></div>
    <div class="page-inner">

      <header class="page-header fade-in-up">
        <div class="header-moon">🌙</div>
        <h1 class="page-title">宿曜占星術</h1>
        <p class="page-desc">月の軌跡が刻む、あなたの宿命と本質</p>
        <div class="header-divider"></div>
      </header>

      <!-- イントロ -->
      <section class="glass-card intro-card fade-in-up delay-1">
        <h2 class="intro-title">古代インドから伝わる「月の占星術」</h2>
        <p class="intro-text">宿曜占星術は、月が約27日かけて地球を一周する軌道を27の「宿」に分け、生まれた日に月がどの宿にあったかで本質・才能・運命を読み解く占術です。8世紀に空海によって日本に伝えられ、平安貴族に愛されました。</p>
        <div class="intro-features">
          <div class="intro-feature">
            <span class="feature-icon">🌙</span>
            <div>
              <p class="feature-title">月の位置で読む</p>
              <p class="feature-desc">太陽占星術より深い「内面・本能・潜在意識」を照らします</p>
            </div>
          </div>
          <div class="intro-feature">
            <span class="feature-icon">⭐</span>
            <div>
              <p class="feature-title">27の宿</p>
              <p class="feature-desc">それぞれ固有の性質を持ち、才能・弱点・相性が決まります</p>
            </div>
          </div>
          <div class="intro-feature">
            <span class="feature-icon">🔮</span>
            <div>
              <p class="feature-title">相性の深さ</p>
              <p class="feature-desc">安宿・栄宿・命宿など、宿同士の縁の深さがわかります</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 本宿診断フォーム -->
      <section class="glass-card form-card fade-in-up delay-2" id="form-card">
        <div class="autofill-banner" id="autofill-banner" style="display:none"></div>
        <h3 class="form-title">🌙 あなたの「本宿」を無料で調べる</h3>
        <p class="form-sub">生年月日を入力するだけ。まず本宿名を無料で確認できます。</p>
        <div class="date-row">
          <div class="field"><label>生年（西暦）</label><input type="number" id="year" placeholder="1990" min="1900" max="2010" /></div>
          <div class="field"><label>月</label><select id="month">{Array.from({length:12},(_,i)=><option value={i+1}>{i+1}月</option>)}</select></div>
          <div class="field"><label>日</label><select id="day">{Array.from({length:31},(_,i)=><option value={i+1}>{i+1}日</option>)}</select></div>
        </div>
        <p class="error-msg" id="form-error"></p>
        <button class="btn-primary" id="preview-btn" onclick="runPreview()">🌙 無料で本宿を調べる</button>
      </section>

      <!-- 無料プレビュー -->
      <section class="glass-card preview-card" id="preview-card" style="display:none">
        <p class="preview-label">あなたの本宿</p>
        <div class="preview-shuku">
          <div class="preview-symbol" id="p-symbol"></div>
          <div>
            <p class="preview-num" id="p-num"></p>
            <h2 class="preview-name" id="p-name"></h2>
            <p class="preview-element" id="p-element"></p>
          </div>
        </div>
        <p class="preview-personality" id="p-personality"></p>

        <!-- 鑑定メニュー -->
        <div class="menu-section">
          <p class="menu-title">✦ この宿でできる鑑定</p>
          <div class="menu-grid">
            <a href="/fortune/sukuyo/reading" class="menu-card-item" id="reading-link">
              <span class="menu-icon">🔮</span>
              <div class="menu-info">
                <p class="menu-name">詳細鑑定</p>
                <p class="menu-desc">才能・恋愛・仕事・宿曜相性</p>
              </div>
              <span class="menu-cost">2<small>C</small></span>
            </a>
            <a href="/fortune/sukuyo/yearly" class="menu-card-item" id="yearly-link">
              <span class="menu-icon">📅</span>
              <div class="menu-info">
                <p class="menu-name">年間運勢</p>
                <p class="menu-desc">月別の運気・注意時期・吉月</p>
              </div>
              <span class="menu-cost">3<small>C</small></span>
            </a>
            <a href="/fortune/sukuyo/compatibility" class="menu-card-item" id="compatibility-link">
              <span class="menu-icon">📅</span>
              <div class="menu-info">
                <p class="menu-name">宿曜相性</p>
                <p class="menu-desc">他の宿との相性を詳しく知る</p>
              </div>
              <span class="menu-cost">3<small>C</small></span>
            </a>
          </div>
        </div>

        <div class="coin-bar" id="coin-bar" style="display:none">
          <span class="coin-bar-label">保有コイン</span>
          <span class="coin-bar-value" id="coin-balance">-- コイン</span>
        </div>
        <div id="login-note" style="display:none">
          <p class="login-text">鑑定にはログインが必要です</p>
          <a href="/login" class="btn-primary" style="display:inline-block;text-decoration:none;text-align:center">ログイン・新規登録</a>
        </div>

        <button class="btn-clear" onclick="resetPreview()">別の生年月日で調べる</button>
      </section>

    </div>
  </div>
</Layout>

<style>
.page { padding: 3rem 1.5rem; min-height: 100vh; position: relative; }
.stars { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
.page-inner { max-width: 680px; margin: 0 auto; position: relative; z-index: 1; }
.page-header { text-align: center; margin-bottom: 2rem; }
.header-moon { font-size: 3.5rem; margin-bottom: 0.75rem; filter: drop-shadow(0 0 20px rgba(196,181,253,0.6)); animation: float 4s ease-in-out infinite; }
@keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }
.page-title { font-family: 'Shippori Mincho', serif; font-size: 2rem; color: #c4b5fd; text-shadow: 0 0 30px rgba(124,111,205,0.5); margin-bottom: 0.5rem; }
.page-desc { font-size: 14px; color: var(--text-secondary); }
.header-divider { width: 60px; height: 1px; background: linear-gradient(90deg,transparent,#7c6fcd,transparent); margin: 1rem auto 0; }

.intro-card { border-top: 2px solid #7c6fcd; background: linear-gradient(180deg, rgba(20,16,40,0.7) 0%, rgba(10,12,16,0.85) 100%); margin-bottom: 1.5rem; }
.intro-title { font-family: 'Shippori Mincho', serif; font-size: 1.25rem; color: #c4b5fd; margin-bottom: 1rem; text-align: center; }
.intro-text { font-size: 14px; color: var(--text-secondary); line-height: 2; margin-bottom: 1.5rem; }
.intro-features { display: flex; flex-direction: column; gap: 0.75rem; }
.intro-feature { display: flex; gap: 1rem; align-items: flex-start; background: rgba(124,111,205,0.07); border-radius: var(--radius-md); padding: 0.875rem; border: 0.5px solid rgba(124,111,205,0.18); }
.feature-icon { font-size: 20px; flex-shrink: 0; }
.feature-title { font-size: 13px; color: #c4b5fd; font-family: 'Shippori Mincho', serif; margin-bottom: 2px; }
.feature-desc { font-size: 12px; color: var(--text-secondary); line-height: 1.7; }

.form-card { margin-bottom: 1.25rem; }
.form-title { font-family: 'Shippori Mincho', serif; font-size: 17px; color: #c4b5fd; margin-bottom: 0.5rem; }
.form-sub { font-size: 13px; color: var(--text-secondary); margin-bottom: 1.25rem; }
.date-row { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 8px; margin-bottom: 1rem; }
.field { display: flex; flex-direction: column; gap: 4px; }
.field label { font-size: 11px; color: var(--text-secondary); }
.autofill-banner { background: rgba(16,185,129,0.1); border: 0.5px solid rgba(16,185,129,0.3); border-radius: var(--radius-md); padding: 0.6rem 1rem; font-size: 13px; color: #6ee7b7; margin-bottom: 1rem; }

.preview-card { border-top: 2px solid #7c6fcd; background: linear-gradient(180deg, rgba(20,16,40,0.8), rgba(10,12,16,0.9)); }
.preview-label { font-size: 11px; color: #c4b5fd; letter-spacing: 0.15em; margin-bottom: 1rem; }
.preview-shuku { display: flex; align-items: center; gap: 1.25rem; margin-bottom: 1.25rem; }
.preview-symbol { font-size: 56px; color: #c4b5fd; line-height: 1; filter: drop-shadow(0 0 15px rgba(124,111,205,0.5)); }
.preview-num { font-size: 11px; color: #c4b5fd; letter-spacing: 0.15em; margin-bottom: 4px; }
.preview-name { font-family: 'Shippori Mincho', serif; font-size: 2rem; color: #f0e6d3; margin-bottom: 4px; }
.preview-element { font-size: 13px; color: var(--text-secondary); }
.preview-personality { font-size: 14px; color: var(--text-secondary); line-height: 2; margin-bottom: 1.5rem; border-left: 3px solid rgba(124,111,205,0.4); padding-left: 1rem; }

.menu-section { margin-bottom: 1.25rem; }
.menu-title { font-size: 13px; color: #c4b5fd; letter-spacing: 0.1em; margin-bottom: 0.75rem; }
.menu-grid { display: flex; flex-direction: column; gap: 0.75rem; }
.menu-card-item { display: flex; align-items: center; gap: 1rem; padding: 1rem 1.25rem; background: rgba(124,111,205,0.08); border: 1px solid rgba(124,111,205,0.2); border-radius: var(--radius-lg); text-decoration: none; transition: all 0.2s; }
.menu-card-item:hover { background: rgba(124,111,205,0.15); border-color: rgba(124,111,205,0.45); transform: translateY(-2px); box-shadow: 0 8px 30px rgba(124,111,205,0.15); }
.menu-icon { font-size: 28px; flex-shrink: 0; }
.menu-info { flex: 1; }
.menu-name { font-family: 'Shippori Mincho', serif; font-size: 16px; color: #f0e6d3; margin-bottom: 2px; }
.menu-desc { font-size: 12px; color: var(--text-secondary); }
.menu-cost { font-size: 1.4rem; font-weight: bold; color: #f59e0b; background: rgba(245,158,11,0.1); padding: 6px 12px; border-radius: 12px; border: 0.5px solid rgba(245,158,11,0.25); white-space: nowrap; }
.menu-cost small { font-size: 0.7rem; margin-left: 1px; }

.coin-bar { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; background: rgba(255,255,255,0.04); border: 0.5px solid rgba(255,255,255,0.1); border-radius: var(--radius-md); padding: 0.6rem 1rem; }
.coin-bar-label { font-size: 12px; color: var(--text-secondary); }
.coin-bar-value { font-size: 16px; color: #c4b5fd; font-weight: 500; }
.login-text { font-size: 13px; color: var(--text-secondary); text-align: center; margin-bottom: 0.75rem; }
.btn-clear { display: block; width: 100%; margin-top: 1rem; background: none; border: 0.5px solid rgba(255,255,255,0.15); color: var(--text-secondary); padding: 0.6rem; border-radius: var(--radius-md); font-size: 13px; cursor: pointer; font-family: 'Noto Serif JP', serif; transition: all 0.2s; }
.btn-clear:hover { border-color: rgba(255,255,255,0.3); color: #f0e6d3; }
.error-msg { font-size: 13px; color: #ff8e8e; min-height: 1.2em; margin: 0 0 0.5rem; }
@keyframes twinkle { 0%,100%{opacity:0.15}50%{opacity:0.7} }
</style>

<script is:inline>
const WORKERS_URL = 'https://kyusei-api.seiji-tomizawa.workers.dev';

(function init() {
  const token = localStorage.getItem('kyusei_token');
  const user = JSON.parse(localStorage.getItem('kyusei_user') || 'null');
  if (!user?.birth_date) return;
  const [y, m, d] = user.birth_date.split('-').map(Number);
  document.getElementById('year').value = y;
  document.getElementById('month').value = m;
  document.getElementById('day').value = d;
  const name = user.display_name || user.email?.split('@')[0] || '';
  if (name) {
    const b = document.getElementById('autofill-banner');
    b.textContent = name + 'さんの生年月日を自動入力しました';
    b.style.display = 'block';
  }
  if (token) runPreview(true);
})();

window.runPreview = async function(auto) {
  const year = document.getElementById('year').value;
  const month = document.getElementById('month').value;
  const day = document.getElementById('day').value;
  const errEl = document.getElementById('form-error');
  if (!year || parseInt(year) < 1900 || parseInt(year) > 2010) {
    if (!auto) errEl.textContent = '生年を正しく入力してください（1900〜2010）';
    return;
  }
  errEl.textContent = '';
  const btn = document.getElementById('preview-btn');
  if (!auto) { btn.textContent = '調べています...'; btn.disabled = true; }
  try {
    const res = await fetch(`${WORKERS_URL}/api/sukuyo/preview?year=${year}&month=${month}&day=${day}`);
    const data = await res.json();
    document.getElementById('p-symbol').textContent = data.symbol || '🌙';
    document.getElementById('p-num').textContent = '第' + (data.shukuIndex + 1) + '宿';
    document.getElementById('p-name').textContent = data.shuku;
    document.getElementById('p-element').textContent = data.element + 'の気';
    document.getElementById('p-personality').textContent = data.personality || '';

    // リンクにパラメータを付与
    const params = `?year=${year}&month=${month}&day=${day}`;
    document.getElementById('reading-link').href = '/fortune/sukuyo/reading' + params;
    document.getElementById('yearly-link').href = '/fortune/sukuyo/yearly' + params;

    const token = localStorage.getItem('kyusei_token');
    if (token) {
      document.getElementById('coin-bar').style.display = 'flex';
      document.getElementById('login-note').style.display = 'none';
      loadBalance(token);
    } else {
      document.getElementById('login-note').style.display = 'block';
      document.getElementById('coin-bar').style.display = 'none';
    }
    document.getElementById('preview-card').style.display = 'block';
    if (!auto) document.getElementById('preview-card').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  } catch {
    if (!auto) errEl.textContent = 'エラーが発生しました。しばらくしてお試しください。';
  } finally {
    if (!auto) { btn.textContent = '🌙 無料で本宿を調べる'; btn.disabled = false; }
  }
};

async function loadBalance(token) {
  try {
    const res = await fetch(`${WORKERS_URL}/api/coins/balance`, { headers: { Authorization: 'Bearer ' + token } });
    const data = await res.json();
    document.getElementById('coin-balance').textContent = data.coins + ' コイン';
  } catch {}
}

window.resetPreview = function() {
  document.getElementById('preview-card').style.display = 'none';
  document.getElementById('year').value = '';
  document.getElementById('form-error').textContent = '';
  window.scrollTo({ top: 0, behavior: 'smooth' });
};

const starsEl = document.getElementById('stars');
for (let i = 0; i < 60; i++) {
  const s = document.createElement('div');
  const size = Math.random() * 2 + 1;
  s.style.cssText = `position:absolute;border-radius:50%;background:#fff;width:${size}px;height:${size}px;top:${Math.random()*100}%;left:${Math.random()*100}%;opacity:${Math.random()*0.4+0.1};animation:twinkle ${2+Math.random()*3}s ease-in-out infinite;animation-delay:${Math.random()*3}s;`;
  starsEl.appendChild(s);
}
</script>