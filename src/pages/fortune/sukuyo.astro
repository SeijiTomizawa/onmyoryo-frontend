---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
---
<Layout title="宿曜占星術 | 陰陽寮">
  <div class="page">
    <div class="stars" id="stars"></div>
    <div class="page-inner">

      <header class="page-header fade-in-up">
        <h1 class="page-title">宿曜占星術</h1>
        <p class="page-desc">月の軌跡が刻む、あなたの宿命と本質</p>
      </header>

      <!-- イントロ -->
      <div class="glass-card intro-card fade-in-up delay-1">
        <div class="intro-moon">🌙</div>
        <h2 class="intro-title">古代インドから伝わる「月の占星術」</h2>
        <p class="intro-text">宿曜占星術は、月が約27日かけて地球を一周する軌道を27の「宿」に分け、生まれた日に月がどの宿にあったかで本質・才能・運命を読み解く占術です。8世紀に空海によって日本に伝えられ、平安貴族に愛されました。</p>
        <div class="intro-points">
          <div class="intro-point">
            <span class="point-icon">🌙</span>
            <div>
              <p class="point-title">月の位置で読む</p>
              <p class="point-desc">太陽占星術より深い「内面・本能・潜在意識」を照らします</p>
            </div>
          </div>
          <div class="intro-point">
            <span class="point-icon">⭐</span>
            <div>
              <p class="point-title">27の宿</p>
              <p class="point-desc">それぞれ固有の性質を持ち、才能・弱点・相性が決まります</p>
            </div>
          </div>
          <div class="intro-point">
            <span class="point-icon">🔮</span>
            <div>
              <p class="point-title">相性の深さ</p>
              <p class="point-desc">安宿・栄宿・命宿など、宿同士の縁の深さがわかります</p>
            </div>
          </div>
        </div>
      </div>

      <!-- 入力フォーム -->
      <div class="glass-card form-card fade-in-up delay-2" id="form-card">
        <div class="autofill-banner" id="autofill-banner" style="display:none"></div>
        <h3 class="form-title">生年月日を入力してください</h3>
        <div class="date-row">
          <div class="field"><label>生年（西暦）</label><input type="number" id="year" placeholder="1990" min="1900" max="2010" /></div>
          <div class="field"><label>月</label><select id="month">{Array.from({length:12},(_,i)=><option value={i+1}>{i+1}月</option>)}</select></div>
          <div class="field"><label>日</label><select id="day">{Array.from({length:31},(_,i)=><option value={i+1}>{i+1}日</option>)}</select></div>
        </div>
        <p class="error-msg" id="form-error"></p>
        <button class="btn-primary" id="preview-btn" onclick="runPreview()">🌙 無料で本宿を調べる</button>
      </div>

      <!-- 無料プレビュー -->
      <div class="glass-card preview-card" id="preview-card" style="display:none">
        <div class="preview-shuku">
          <div class="preview-symbol" id="p-symbol"></div>
          <div>
            <p class="preview-num" id="p-num"></p>
            <h2 class="preview-name" id="p-name"></h2>
            <p class="preview-element" id="p-element"></p>
          </div>
        </div>
        <p class="preview-personality" id="p-personality"></p>
        <div class="preview-lock">
          <div class="lock-items">
            <span class="lock-item">💎 才能・弱点</span>
            <span class="lock-item">❤️ 恋愛傾向</span>
            <span class="lock-item">💼 仕事・天職</span>
            <span class="lock-item">🧭 吉方位・ラッキー</span>
            <span class="lock-item">🌟 宿曜相性</span>
          </div>
          <p class="lock-text">詳細鑑定（2コイン）で公開</p>
        </div>
        <div class="coin-bar" id="coin-bar" style="display:none">
          <span class="coin-bar-label">保有コイン</span>
          <span class="coin-bar-value" id="coin-balance">-- コイン</span>
          <span class="coin-bar-cost">詳細鑑定 2コイン</span>
        </div>
        <div id="login-note" style="display:none;text-align:center;margin-top:1rem">
          <p style="font-size:14px;color:var(--text-secondary);margin-bottom:0.75rem">鑑定にはログインが必要です</p>
          <a href="/login" class="btn-primary" style="display:inline-block;text-decoration:none">ログイン・新規登録</a>
        </div>
        <button class="btn-primary reading-btn" id="reading-btn" onclick="runReading()">🔮 詳細鑑定を受ける（2コイン）</button>
        <p class="error-msg" id="reading-error"></p>
      </div>

      <!-- 詳細鑑定結果 -->
      <div id="result-section" style="display:none">
        <div class="result-grid">

          <!-- 本宿ヒーローカード -->
          <div class="glass-card shuku-hero-card">
            <div class="hero-top">
              <div class="hero-symbol-wrap">
                <div class="hero-symbol" id="r-symbol"></div>
                <div class="hero-glow"></div>
              </div>
              <div class="hero-info">
                <p class="hero-num" id="r-num"></p>
                <h2 class="hero-name" id="r-name"></h2>
                <p class="hero-element" id="r-element"></p>
                <p class="hero-birth" id="r-birth"></p>
              </div>
            </div>
            <p class="hero-personality" id="r-personality"></p>
          </div>

          <!-- 才能 -->
          <div class="glass-card result-block talent-block">
            <div class="block-header">
              <span class="block-icon">💎</span>
              <h3 class="block-title">あなたの才能</h3>
            </div>
            <p class="block-text" id="r-talent"></p>
          </div>

          <!-- 弱点 -->
          <div class="glass-card result-block weakness-block">
            <div class="block-header">
              <span class="block-icon">🌱</span>
              <h3 class="block-title">やさしい注意点</h3>
            </div>
            <p class="block-text" id="r-weakness"></p>
          </div>

          <!-- 恋愛 -->
          <div class="glass-card result-block love-block">
            <div class="block-header">
              <span class="block-icon">❤️</span>
              <h3 class="block-title">恋愛でのあなたらしさ</h3>
            </div>
            <p class="block-text" id="r-love"></p>
          </div>

          <!-- 仕事 -->
          <div class="glass-card result-block work-block">
            <div class="block-header">
              <span class="block-icon">💼</span>
              <h3 class="block-title">仕事・天職</h3>
            </div>
            <p class="block-text" id="r-work"></p>
          </div>

          <!-- ラッキー -->
          <div class="glass-card result-block lucky-block">
            <div class="block-header">
              <span class="block-icon">🧭</span>
              <h3 class="block-title">吉方位・ラッキー</h3>
            </div>
            <div class="lucky-chips" id="r-lucky"></div>
          </div>

          <!-- 相性 -->
          <div class="glass-card result-block compat-block">
            <div class="block-header">
              <span class="block-icon">🌟</span>
              <h3 class="block-title">宿曜相性</h3>
            </div>
            <div class="compat-list" id="r-compat"></div>
          </div>

          <!-- 次のアクション -->
          <div class="glass-card result-block next-block" style="text-align:center">
            <p class="next-title">他の鑑定と組み合わせて、さらに深く読み解きましょう</p>
            <div class="next-grid">
              <a href="/fortune/compat" class="next-btn"><span>❤️</span><span>相性鑑定</span><span class="next-cost">3C</span></a>
              <a href="/fortune/monthly" class="next-btn"><span>🌙</span><span>月運詳細</span><span class="next-cost">2C</span></a>
              <a href="/fortune/daily" class="next-btn"><span>☀️</span><span>本日の運勢</span><span class="next-cost">1C</span></a>
            </div>
            <button class="btn-secondary" onclick="resetReading()" style="margin-top:1.25rem">別の生年月日で調べる</button>
          </div>

        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
.page { padding: 3rem 1.5rem; min-height: 100vh; position: relative; }
.stars { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
.page-inner { max-width: 680px; margin: 0 auto; position: relative; z-index: 1; }
.page-header { text-align: center; margin-bottom: 2rem; }
.page-title { font-family: 'Shippori Mincho', serif; font-size: 26px; margin-bottom: 0.5rem; }
.page-desc { font-size: 14px; color: var(--text-secondary); }

/* イントロ */
.intro-card { text-align: center; margin-bottom: 2rem; border-top: 2px solid #7c6fcd; background: linear-gradient(180deg, rgba(20,16,40,0.7) 0%, rgba(10,12,16,0.85) 100%); }
.intro-moon { font-size: 48px; margin-bottom: 1rem; }
.intro-title { font-family: 'Shippori Mincho', serif; font-size: 1.3rem; color: #c4b5fd; margin-bottom: 1rem; }
.intro-text { font-size: 15px; color: var(--text-secondary); line-height: 2; margin-bottom: 1.5rem; }
.intro-points { display: flex; flex-direction: column; gap: 0.75rem; text-align: left; }
.intro-point { display: flex; gap: 1rem; align-items: flex-start; background: rgba(124,111,205,0.08); border-radius: var(--radius-md); padding: 1rem; border: 0.5px solid rgba(124,111,205,0.2); }
.point-icon { font-size: 22px; flex-shrink: 0; }
.point-title { font-size: 14px; color: #c4b5fd; font-family: 'Shippori Mincho', serif; margin-bottom: 2px; }
.point-desc { font-size: 13px; color: var(--text-secondary); line-height: 1.7; }

/* フォーム */
.form-card { margin-bottom: 1.25rem; }
.form-title { font-family: 'Shippori Mincho', serif; font-size: 16px; color: #c4b5fd; margin-bottom: 1rem; }
.date-row { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 8px; margin-bottom: 1rem; }
.field { display: flex; flex-direction: column; gap: 4px; }
.field label { font-size: 11px; color: var(--text-secondary); }
.autofill-banner { background: rgba(29,158,117,0.12); border: 0.5px solid rgba(29,158,117,0.3); border-radius: var(--radius-md); padding: 0.6rem 1rem; font-size: 13px; color: #1d9e75; margin-bottom: 1rem; }

/* プレビュー */
.preview-card { margin-bottom: 1.25rem; border-top: 2px solid #7c6fcd; }
.preview-shuku { display: flex; align-items: center; gap: 1.25rem; margin-bottom: 1.25rem; }
.preview-symbol { font-size: 52px; color: #c4b5fd; line-height: 1; }
.preview-num { font-size: 11px; color: #c4b5fd; letter-spacing: 0.15em; margin-bottom: 4px; }
.preview-name { font-family: 'Shippori Mincho', serif; font-size: 28px; color: #f0e6d3; margin-bottom: 4px; }
.preview-element { font-size: 13px; color: var(--text-secondary); }
.preview-personality { font-size: 15px; color: var(--text-secondary); line-height: 2; margin-bottom: 1.25rem; }
.preview-lock { background: rgba(124,111,205,0.08); border: 1px dashed rgba(124,111,205,0.3); border-radius: var(--radius-md); padding: 1rem; margin-bottom: 1.25rem; }
.lock-items { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 0.75rem; }
.lock-item { font-size: 13px; padding: 4px 12px; border-radius: 999px; background: rgba(124,111,205,0.12); color: #c4b5fd; border: 0.5px solid rgba(124,111,205,0.25); }
.lock-text { font-size: 12px; color: #c4b5fd; text-align: center; }
.coin-bar { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; background: rgba(255,255,255,0.04); border: 0.5px solid rgba(255,255,255,0.1); border-radius: var(--radius-md); padding: 0.6rem 1rem; }
.coin-bar-label { font-size: 12px; color: var(--text-secondary); }
.coin-bar-value { font-size: 16px; color: #c4b5fd; font-weight: 500; }
.coin-bar-cost { font-size: 11px; color: var(--text-muted); margin-left: auto; }
.reading-btn { max-width: 100%; }

/* 結果グリッド */
.result-grid { display: flex; flex-direction: column; gap: 1.25rem; margin-top: 1.25rem; }
.result-block { padding: 1.5rem; }
.block-header { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; padding-bottom: 0.75rem; border-bottom: 0.5px solid rgba(124,111,205,0.25); }
.block-icon { font-size: 20px; }
.block-title { font-family: 'Shippori Mincho', serif; font-size: 17px; color: #c4b5fd; margin: 0; }
.block-text { font-size: 16px; color: var(--text-secondary); line-height: 2.1; }

/* ヒーローカード */
.shuku-hero-card { border-top: 3px solid #7c6fcd; padding: 2rem; background: linear-gradient(160deg, rgba(20,16,40,0.9), rgba(10,12,16,0.95)); }
.hero-top { display: flex; align-items: center; gap: 1.5rem; margin-bottom: 1.5rem; }
.hero-symbol-wrap { position: relative; flex-shrink: 0; }
.hero-symbol { font-size: 64px; color: #c4b5fd; line-height: 1; position: relative; z-index: 1; }
.hero-glow { position: absolute; inset: -10px; background: radial-gradient(circle, rgba(124,111,205,0.3) 0%, transparent 70%); border-radius: 50%; }
.hero-num { font-size: 11px; color: #c4b5fd; letter-spacing: 0.15em; margin-bottom: 4px; }
.hero-name { font-family: 'Shippori Mincho', serif; font-size: 36px; color: #f0e6d3; margin-bottom: 6px; }
.hero-element { font-size: 14px; color: #c4b5fd; margin-bottom: 6px; }
.hero-birth { font-size: 12px; color: var(--text-muted); }
.hero-personality { font-size: 16px; color: #d4c5a9; line-height: 2.1; border-left: 3px solid #7c6fcd; padding-left: 1rem; }

/* 各ブロック色分け */
.talent-block { border-left: 3px solid #5ef0c5; }
.weakness-block { border-left: 3px solid #f59e0b; }
.love-block { border-left: 3px solid #fda4af; }
.work-block { border-left: 3px solid #93c5fd; }
.lucky-block { background: linear-gradient(135deg, rgba(20,16,40,0.6), rgba(10,12,16,0.8)); }
.compat-block {}

/* ラッキー */
.lucky-chips { display: flex; flex-wrap: wrap; gap: 8px; }
.lucky-chip { font-size: 14px; padding: 6px 16px; border-radius: 999px; background: rgba(124,111,205,0.12); color: #c4b5fd; border: 0.5px solid rgba(124,111,205,0.3); }

/* 相性 */
.compat-list { display: flex; flex-direction: column; gap: 0.875rem; }
.compat-item { background: rgba(255,255,255,0.03); border-radius: var(--radius-md); padding: 1rem; border: 0.5px solid rgba(255,255,255,0.08); }
.compat-top { display: flex; align-items: center; gap: 0.875rem; margin-bottom: 0.5rem; }
.compat-name { font-family: 'Shippori Mincho', serif; font-size: 18px; color: #f0e6d3; }
.compat-badge { font-size: 11px; padding: 3px 10px; border-radius: 999px; font-weight: 500; }
.badge-best { background: rgba(94,240,197,0.15); color: #5ef0c5; border: 0.5px solid rgba(94,240,197,0.3); }
.badge-good { background: rgba(124,111,205,0.15); color: #c4b5fd; border: 0.5px solid rgba(124,111,205,0.3); }
.badge-friend { background: rgba(249,168,212,0.15); color: #f9a8d4; border: 0.5px solid rgba(249,168,212,0.3); }
.badge-normal { background: rgba(255,255,255,0.06); color: var(--text-secondary); border: 0.5px solid rgba(255,255,255,0.1); }
.compat-desc { font-size: 14px; color: var(--text-secondary); line-height: 1.8; }

/* 次のアクション */
.next-block { background: linear-gradient(135deg, rgba(20,16,40,0.6), rgba(10,12,16,0.8)); }
.next-title { font-size: 14px; color: var(--text-secondary); margin-bottom: 1.25rem; line-height: 1.8; }
.next-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.next-btn { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 1rem 0.5rem; background: rgba(255,255,255,0.04); border: 0.5px solid rgba(255,255,255,0.1); border-radius: var(--radius-md); text-decoration: none; transition: all 0.2s; font-size: 13px; color: #f0e6d3; }
.next-btn:hover { border-color: #7c6fcd; background: rgba(124,111,205,0.08); transform: translateY(-2px); }
.next-btn span:first-child { font-size: 22px; }
.next-cost { font-size: 11px; color: #c4b5fd; background: rgba(124,111,205,0.15); padding: 2px 10px; border-radius: 999px; }
.btn-secondary { background: transparent; border: 0.5px solid rgba(255,255,255,0.2); color: var(--text-secondary); padding: 0.6rem 1.5rem; border-radius: var(--radius-md); font-size: 14px; cursor: pointer; font-family: 'Noto Serif JP', serif; }

@keyframes twinkle { 0%,100%{opacity:0.2}50%{opacity:0.8} }
</style>

<script is:inline>
const WORKERS_URL = 'https://kyusei-api.seiji-tomizawa.workers.dev';

// 自動入力・ログイン済みは自動鑑定
(function() {
  const token = localStorage.getItem('kyusei_token');
  const user = JSON.parse(localStorage.getItem('kyusei_user') || 'null');
  if (!user || !user.birth_date) return;

  const [y, m, d] = user.birth_date.split('-').map(Number);
  document.getElementById('year').value = y;
  document.getElementById('month').value = m;
  document.getElementById('day').value = d;

  if (token) {
    document.getElementById('form-card').style.display = 'none';
    autoRunSukuyo(y, m, d, token);
  } else {
    const name = user.display_name || user.email.split('@')[0];
    const banner = document.getElementById('autofill-banner');
    banner.textContent = name + 'さんの生年月日を自動入力しました';
    banner.style.display = 'block';
    document.getElementById('login-note').style.display = 'block';
    document.getElementById('reading-btn').style.display = 'none';
  }
})();

async function autoRunSukuyo(year, month, day, token) {
  try {
    // 保存済みデータがあれば復元
    const savedKey = 'sukuyo_reading_' + year + '_' + month + '_' + day;
    const saved = localStorage.getItem(savedKey);
    if (saved) {
      try {
        displayResult(JSON.parse(saved));
        return;
      } catch(e) {}
    }

    // プレビューのみ表示してコインバーを出す
    const res = await fetch(WORKERS_URL + '/api/sukuyo/preview?year=' + year + '&month=' + month + '&day=' + day);
    const data = await res.json();
    showPreview(data);
    document.getElementById('coin-bar').style.display = 'flex';
    loadBalance(token);
    document.getElementById('preview-card').style.display = 'block';
  } catch(e) {
    document.getElementById('form-card').style.display = 'block';
  }
}

async function loadBalance(token) {
  try {
    const res = await fetch(WORKERS_URL + '/api/coins/balance', { headers: { Authorization: 'Bearer ' + token } });
    const data = await res.json();
    document.getElementById('coin-balance').textContent = data.coins + ' コイン';
  } catch {}
}

function showPreview(data) {
  document.getElementById('p-symbol').textContent = data.symbol || '🌙';
  document.getElementById('p-num').textContent = '第' + (data.shukuIndex + 1) + '宿';
  document.getElementById('p-name').textContent = data.shuku;
  document.getElementById('p-element').textContent = data.element + 'の気';
  document.getElementById('p-personality').textContent = data.personality || '';
}

window.runPreview = async function() {
  const year = document.getElementById('year').value;
  const month = document.getElementById('month').value;
  const day = document.getElementById('day').value;
  const errEl = document.getElementById('form-error');
  if (!year || parseInt(year) < 1900 || parseInt(year) > 2010) { errEl.textContent = '生年を正しく入力してください（1900〜2010）'; return; }
  errEl.textContent = '';
  const btn = document.getElementById('preview-btn');
  btn.textContent = '調べています...'; btn.disabled = true;
  try {
    const res = await fetch(WORKERS_URL + '/api/sukuyo/preview?year=' + year + '&month=' + month + '&day=' + day);
    const data = await res.json();
    showPreview(data);

    const token = localStorage.getItem('kyusei_token');
    if (token) {
      document.getElementById('coin-bar').style.display = 'flex';
      document.getElementById('reading-btn').style.display = 'block';
      document.getElementById('login-note').style.display = 'none';
      loadBalance(token);
    } else {
      document.getElementById('login-note').style.display = 'block';
      document.getElementById('reading-btn').style.display = 'none';
      document.getElementById('coin-bar').style.display = 'none';
    }
    document.getElementById('preview-card').style.display = 'block';
    document.getElementById('preview-card').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  } catch {
    errEl.textContent = 'エラーが発生しました。しばらくしてお試しください。';
  } finally {
    btn.textContent = '🌙 無料で本宿を調べる'; btn.disabled = false;
  }
};

window.runReading = async function() {
  const token = localStorage.getItem('kyusei_token');
  if (!token) { window.location.href = '/login'; return; }
  const year = document.getElementById('year').value;
  const month = document.getElementById('month').value;
  const day = document.getElementById('day').value;
  const errEl = document.getElementById('reading-error');
  const btn = document.getElementById('reading-btn');
  errEl.textContent = '';
  btn.textContent = '鑑定中...'; btn.disabled = true;
  try {
    const res = await fetch(WORKERS_URL + '/api/sukuyo/reading', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
      body: JSON.stringify({ year: parseInt(year), month: parseInt(month), day: parseInt(day) }),
    });
    const data = await res.json();
    if (!res.ok) { errEl.textContent = data.error || 'エラーが発生しました'; return; }

    // localStorageに保存
    const savedKey = 'sukuyo_reading_' + year + '_' + month + '_' + day;
    localStorage.setItem(savedKey, JSON.stringify(data));

    displayResult(data);
  } catch {
    errEl.textContent = '通信エラーが発生しました。';
  } finally {
    btn.textContent = '🔮 詳細鑑定を受ける（2コイン）'; btn.disabled = false;
  }
};

function displayResult(data) {
  document.getElementById('r-symbol').textContent = data.symbol || '🌙';
  document.getElementById('r-num').textContent = '第' + (data.shukuIndex + 1) + '宿';
  document.getElementById('r-name').textContent = data.shuku;
  document.getElementById('r-element').textContent = data.element + 'の気';
  document.getElementById('r-birth').textContent = data.birthDate || '';
  document.getElementById('r-personality').textContent = data.personality || '';
  document.getElementById('r-talent').textContent = data.talent || '';
  document.getElementById('r-weakness').textContent = data.weakness || '';
  document.getElementById('r-love').textContent = data.love || '';
  document.getElementById('r-work').textContent = data.work || '';

  // ラッキー
  const luckyEl = document.getElementById('r-lucky');
  luckyEl.innerHTML = (data.lucky || '').split('・').map(function(l) {
    return '<span class="lucky-chip">' + l + '</span>';
  }).join('');

  // 相性
  const BADGE_MAP = {
    '安宿': 'badge-best', '栄宿': 'badge-good', '命宿': 'badge-friend',
    '友宿': 'badge-good', '業宿': 'badge-normal', '衰宿': 'badge-normal'
  };
  const compatEl = document.getElementById('r-compat');
  compatEl.innerHTML = (data.compatibility || []).map(function(c) {
    const badgeClass = BADGE_MAP[c.relation] || 'badge-normal';
    return '<div class="compat-item">' +
      '<div class="compat-top">' +
        '<span class="compat-name">' + c.name + '</span>' +
        '<span class="compat-badge ' + badgeClass + '">' + c.relation + '</span>' +
      '</div>' +
      '<p class="compat-desc">' + c.desc + '</p>' +
    '</div>';
  }).join('');

  if (data.remainingCoins !== undefined) {
    document.getElementById('coin-balance').textContent = data.remainingCoins + ' コイン';
  }

  document.getElementById('form-card').style.display = 'none';
  document.getElementById('preview-card').style.display = 'none';
  document.getElementById('result-section').style.display = 'block';
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

window.resetReading = function() {
  document.getElementById('result-section').style.display = 'none';
  document.getElementById('preview-card').style.display = 'none';
  document.getElementById('form-card').style.display = 'block';
  document.getElementById('year').value = '';
  document.getElementById('form-error').textContent = '';
  window.scrollTo({ top: 0, behavior: 'smooth' });
};

// 星背景
const starsEl = document.getElementById('stars');
for (let i = 0; i < 60; i++) {
  const s = document.createElement('div');
  const size = Math.random() * 2 + 1;
  s.style.cssText = 'position:absolute;border-radius:50%;background:#fff;width:' + size + 'px;height:' + size + 'px;top:' + (Math.random()*100) + '%;left:' + (Math.random()*100) + '%;opacity:' + (Math.random()*0.4+0.1) + ';animation:twinkle ' + (2+Math.random()*3) + 's ease-in-out infinite;animation-delay:' + (Math.random()*3) + 's;';
  starsEl.appendChild(s);
}
</script>
