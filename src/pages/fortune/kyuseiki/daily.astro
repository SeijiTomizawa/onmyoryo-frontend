---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
---
<Layout title="本日の運勢鑑定 | 陰陽寮">
  <div class="page">
    <div class="stars" id="stars"></div>
    <div class="page-inner">

      <header class="page-header fade-in-up">
        <h1 class="page-title">本日の運勢</h1>
        <p class="page-desc" id="today-date">今日の運気を詳しく読み解きます</p>
      </header>

      <section class="glass-card intro-card fade-in-up delay-1">
        <h2 class="intro-title">今日一日の流れを、星が教えてくれる</h2>
        <p class="intro-text">
          九星気学では、毎日変わる「日盤の星」とあなたの本命星の組み合わせで、
          その日の運気が決まります。本日の運勢鑑定では、今日の吉凶だけでなく、
          ラッキーカラー・ラッキーアイテム・ラッキーフード・吉方角・
          おすすめの行動・避けるべき行動まで、今日一日を最高に過ごすための
          具体的な指針をお伝えします。
        </p>
      </section>

      <aside class="coin-balance-bar" id="balance-bar" style="display:none">
        <span class="balance-label">保有コイン</span>
        <span class="balance-value" id="coin-balance">-- コイン</span>
        <span class="balance-cost">日運鑑定 1コイン（¥100相当）</span>
      </aside>

      <section id="form-section">
        <div class="glass-card form-card fade-in-up delay-2" style="text-align:center">
          <div class="autofill-banner" id="autofill-banner" style="display:none"></div>
          <p class="form-desc">今日一日を最高に過ごすための具体的な指針を鑑定します。</p>
          <div id="login-note" style="display:none">
            <p style="font-size:14px;color:var(--text-secondary);margin-bottom:0.75rem">鑑定にはログインが必要です</p>
            <a href="/login" class="btn-primary" style="display:inline-block;text-decoration:none">ログイン・新規登録</a>
          </div>
          <button class="btn-primary cast-btn" id="cast-btn" onclick="runDaily()">
            ☀️ 本日の運勢を鑑定する（1コイン）
          </button>
        </div>
      </section>

      <!-- 結果表示セクション -->
      <section id="result-section" style="display:none">
        <div class="result-grid">

          <section class="glass-card result-block score-card">
            <div class="score-layout">
              <div class="score-left">
                <p class="score-date" id="r-date"></p>
                <h2 class="score-title" id="r-score-label"></h2>
                <p class="score-star" id="r-star"></p>
              </div>
              <div class="score-right">
                <div class="score-ring">
                  <svg viewBox="0 0 100 100" class="ring-svg">
                    <circle cx="50" cy="50" r="42" fill="none" stroke="#ffffff10" stroke-width="7"/>
                    <circle cx="50" cy="50" r="42" fill="none" stroke-width="7"
                      stroke-dasharray="263.9" stroke-linecap="round"
                      transform="rotate(-90 50 50)" id="score-circle" stroke="#f59e0b"/>
                  </svg>
                  <div class="ring-score" id="r-score">--</div>
                </div>
                <p class="ring-label">今日の運気</p>
              </div>
            </div>
          </section>

          <section class="glass-card result-block message-block">
            <h3 class="block-title">☀️ 今日のあなたへ</h3>
            <p class="block-text message-text" id="r-message"></p>
          </section>

          <section class="glass-card result-block lucky-block">
            <h3 class="block-title">✦ 今日のラッキー</h3>
            <div class="lucky-grid">
              <div class="lucky-item">
                <div class="lucky-icon-wrap color-icon"><span class="lucky-icon">🎨</span></div>
                <p class="lucky-label">ラッキーカラー</p>
                <div class="lucky-colors" id="r-colors"></div>
              </div>
              <div class="lucky-item">
                <div class="lucky-icon-wrap item-icon"><span class="lucky-icon">💎</span></div>
                <p class="lucky-label">ラッキーアイテム</p>
                <p class="lucky-value" id="r-item"></p>
              </div>
              <div class="lucky-item">
                <div class="lucky-icon-wrap food-icon"><span class="lucky-icon">🍽️</span></div>
                <p class="lucky-label">ラッキーフード</p>
                <p class="lucky-value" id="r-food"></p>
              </div>
              <div class="lucky-item">
                <div class="lucky-icon-wrap dir-icon"><span class="lucky-icon">🧭</span></div>
                <p class="lucky-label">吉方角</p>
                <p class="lucky-value direction-value" id="r-direction"></p>
              </div>
              <div class="lucky-item">
                <div class="lucky-icon-wrap spot-icon"><span class="lucky-icon">📍</span></div>
                <p class="lucky-label">ラッキースポット</p>
                <p class="lucky-value" id="r-spot"></p>
              </div>
            </div>
          </section>

          <section class="glass-card result-block action-block">
            <h3 class="block-title">✦ 今日おすすめの行動</h3>
            <div class="action-list" id="r-actions"></div>
          </section>

          <section class="glass-card result-block caution-block">
            <h3 class="block-title">⚠ 今日避けるべきこと</h3>
            <div class="caution-list" id="r-cautions"></div>
          </section>

          <aside class="glass-card result-block next-block" style="text-align:center">
            <p class="next-title">他の鑑定も組み合わせて、今日をさらに充実させましょう</p>
            <div class="next-grid">
              <a href="/fortune/monthly" class="next-btn">
                <span>🌙</span><span>今月の月運詳細</span><span class="next-cost">2C</span>
              </a>
              <a href="/fortune/compat" class="next-btn">
                <span>❤️</span><span>相性鑑定</span><span class="next-cost">3C</span>
              </a>
              <a href="/fortune/eki" class="next-btn">
                <span>☰</span><span>易占い</span><span class="next-cost">1C</span>
              </a>
            </div>
            <button class="btn-secondary" onclick="resetAll()" style="margin-top:1.25rem">明日また鑑定する</button>
          </aside>

        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
.page { padding: 3rem 1.5rem; min-height: 100vh; position: relative; }
.stars { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
.page-inner { max-width: 680px; margin: 0 auto; position: relative; z-index: 1; }
.page-header { text-align: center; margin-bottom: 2rem; }
.page-title { font-family: 'Shippori Mincho', serif; font-size: 26px; margin-bottom: 0.5rem; }
.page-desc { font-size: 14px; color: var(--text-secondary); }
.intro-card { text-align: center; margin-bottom: 2rem; border-top: 2px solid #f59e0b; background: linear-gradient(180deg, rgba(30,24,10,0.6) 0%, rgba(10,12,16,0.8) 100%); }
.intro-title { font-family: 'Shippori Mincho', serif; font-size: 1.3rem; color: #fde68a; margin-bottom: 1rem; }
.intro-text { font-size: 15px; color: var(--text-secondary); line-height: 2; }
.coin-balance-bar { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; background: var(--dark-card); border: 0.5px solid #ffffff15; border-radius: var(--radius-md); padding: 0.6rem 1rem; }
.balance-label { font-size: 12px; color: var(--text-secondary); }
.balance-value { font-size: 16px; color: #f59e0b; font-weight: 500; }
.balance-cost { font-size: 11px; color: var(--text-muted); margin-left: auto; }
.autofill-banner { background: rgba(29,158,117,0.12); border: 0.5px solid rgba(29,158,117,0.3); border-radius: var(--radius-md); padding: 0.5rem 0.875rem; font-size: 13px; color: #1d9e75; margin-bottom: 1rem; }
.form-desc { font-size: 15px; color: var(--text-secondary); line-height: 1.9; margin-bottom: 1.25rem; }
.cast-btn { max-width: 100%; font-size: 16px; }
.result-grid { display: flex; flex-direction: column; gap: 1.25rem; margin-top: 2rem; }
.result-block { padding: 1.75rem; }
.block-title { font-family: 'Shippori Mincho', serif; font-size: 16px; color: #f59e0b; margin-bottom: 1.25rem; padding-bottom: 0.75rem; border-bottom: 0.5px solid rgba(245,158,11,0.3); }
.block-text { font-size: 15px; color: var(--text-secondary); line-height: 2; }
.score-card { border-top: 3px solid #f59e0b; background: linear-gradient(135deg, rgba(30,24,10,0.9), rgba(10,12,16,0.9)); }
.score-layout { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
.score-date { font-size: 13px; color: var(--text-secondary); margin-bottom: 6px; }
.score-title { font-family: 'Shippori Mincho', serif; font-size: 20px; color: #fde68a; margin-bottom: 6px; }
.score-star { font-size: 13px; color: #f59e0b; }
.score-right { display: flex; flex-direction: column; align-items: center; gap: 4px; flex-shrink: 0; }
.score-ring { position: relative; width: 100px; height: 100px; }
.ring-svg { width: 100px; height: 100px; }
.ring-score { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 28px; font-weight: bold; color: #f59e0b; }
.ring-label { font-size: 11px; color: var(--text-secondary); text-align: center; }
.message-block { background: linear-gradient(135deg, rgba(30,24,10,0.6), rgba(10,12,16,0.8)); border-left: 3px solid #f59e0b; }
.message-text { font-size: 16px; line-height: 2.1; color: #f0e6d3; }
.lucky-block { background: linear-gradient(135deg, rgba(20,18,8,0.8), rgba(10,12,16,0.9)); }
.lucky-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
@media (max-width: 480px) { .lucky-grid { grid-template-columns: repeat(2, 1fr); } }
.lucky-item { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 1rem 0.5rem; background: rgba(255,255,255,0.04); border-radius: var(--radius-md); border: 0.5px solid rgba(245,158,11,0.15); text-align: center; }
.lucky-icon-wrap { width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.color-icon { background: rgba(245,158,11,0.2); }
.item-icon { background: rgba(124,111,205,0.2); }
.food-icon { background: rgba(29,158,117,0.2); }
.dir-icon { background: rgba(59,130,246,0.2); }
.spot-icon { background: rgba(244,63,94,0.2); }
.lucky-icon { font-size: 20px; }
.lucky-label { font-size: 11px; color: var(--text-muted); }
.lucky-value { font-size: 14px; color: #f0e6d3; font-family: 'Shippori Mincho', serif; font-weight: 500; }
.direction-value { font-size: 22px; color: #f59e0b; }
.lucky-colors { display: flex; gap: 6px; justify-content: center; flex-wrap: wrap; }
.color-chip { font-size: 12px; padding: 3px 10px; border-radius: 999px; background: rgba(245,158,11,0.15); color: #fde68a; border: 0.5px solid rgba(245,158,11,0.3); }
.action-block { border-left: 3px solid #1d9e75; }
.action-list { display: flex; flex-direction: column; gap: 10px; }
.action-item { display: flex; align-items: center; gap: 12px; padding: 0.875rem 1rem; background: rgba(29,158,117,0.08); border-radius: var(--radius-md); border: 0.5px solid rgba(29,158,117,0.2); }
.action-check { width: 24px; height: 24px; border-radius: 50%; background: rgba(29,158,117,0.2); display: flex; align-items: center; justify-content: center; font-size: 12px; color: #1d9e75; flex-shrink: 0; }
.action-text { font-size: 15px; color: #f0e6d3; }
.caution-block { border-left: 3px solid #f59e0b; }
.caution-list { display: flex; flex-direction: column; gap: 10px; }
.caution-item { display: flex; align-items: center; gap: 12px; padding: 0.875rem 1rem; background: rgba(245,158,11,0.06); border-radius: var(--radius-md); border: 0.5px solid rgba(245,158,11,0.2); }
.caution-icon { width: 24px; height: 24px; border-radius: 50%; background: rgba(245,158,11,0.15); display: flex; align-items: center; justify-content: center; font-size: 12px; color: #f59e0b; flex-shrink: 0; }
.caution-text { font-size: 15px; color: var(--text-secondary); }
.next-block { background: linear-gradient(135deg, rgba(20,18,8,0.8), rgba(10,12,16,0.9)); }
.next-title { font-size: 14px; color: var(--text-secondary); margin-bottom: 1.25rem; line-height: 1.8; }
.next-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.next-btn { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 1rem 0.5rem; background: rgba(255,255,255,0.04); border: 0.5px solid rgba(255,255,255,0.1); border-radius: var(--radius-md); text-decoration: none; transition: all 0.2s; font-size: 13px; color: #f0e6d3; }
.next-btn:hover { border-color: var(--gold); background: rgba(212,175,55,0.06); transform: translateY(-2px); }
.next-btn span:first-child { font-size: 22px; }
.next-cost { font-size: 11px; color: var(--gold); background: rgba(212,175,55,0.15); padding: 2px 10px; border-radius: 999px; }
.btn-secondary { background: transparent; border: 0.5px solid rgba(255,255,255,0.2); color: var(--text-secondary); padding: 0.6rem 1.5rem; border-radius: var(--radius-md); font-size: 14px; cursor: pointer; font-family: 'Noto Serif JP', serif; }
@keyframes twinkle { 0%,100% { opacity: 0.2; } 50% { opacity: 0.8; } }
</style>

<script is:inline>
const WORKERS_URL = 'https://kyusei-api.seiji-tomizawa.workers.dev';
const STAR_NAMES = {
  1:'一白水星',2:'二黒土星',3:'三碧木星',4:'四緑木星',5:'五黄土星',
  6:'六白金星',7:'七赤金星',8:'八白土星',9:'九紫火星'
};

function init() {
  const now = new Date();
  const days = ['日','月','火','水','木','金','土'];
  document.getElementById('today-date').textContent =
    now.getFullYear() + '年' + (now.getMonth()+1) + '月' + now.getDate() + '日（' + days[now.getDay()] + '）の運気';

  const token = localStorage.getItem('kyusei_token');
  const user = JSON.parse(localStorage.getItem('kyusei_user') || 'null');

  if (!token) {
    document.getElementById('cast-btn').style.display = 'none';
    document.getElementById('login-note').style.display = 'block';
    return;
  }

  document.getElementById('balance-bar').style.display = 'flex';
  loadBalance(token);

  if (user) {
    const name = user.display_name || user.email.split('@')[0];
    const banner = document.getElementById('autofill-banner');
    banner.textContent = name + 'さんの本日の運勢を鑑定します';
    banner.style.display = 'block';
  }
}

async function loadBalance(token) {
  try {
    const res = await fetch(WORKERS_URL + '/api/coins/balance', { headers: { Authorization: 'Bearer ' + token } });
    const data = await res.json();
    document.getElementById('coin-balance').textContent = data.coins + ' コイン';
  } catch {}
}

window.runDaily = async function() {
  const token = localStorage.getItem('kyusei_token');
  if (!token) { window.location.href = '/login'; return; }
  const btn = document.getElementById('cast-btn');
  btn.textContent = '鑑定中...'; btn.disabled = true;
  try {
    const res = await fetch(WORKERS_URL + '/api/ai_fortune/daily', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
      body: JSON.stringify({}),
    });
    const data = await res.json();
    if (!res.ok) { alert(data.error || 'エラーが発生しました'); return; }
    displayResult(data);
  } catch {
    alert('通信エラーが発生しました。しばらくしてお試しください。');
  } finally {
    btn.textContent = '☀️ 本日の運勢を鑑定する（1コイン）';
    btn.disabled = false;
  }
};

function displayResult(data) {
  document.getElementById('r-date').textContent = data.date;
  document.getElementById('r-score-label').textContent = data.scoreLabel;
  document.getElementById('r-star').textContent = (STAR_NAMES[data.honmei] || '') + ' × 日盤第' + data.dayStar + '星';
  document.getElementById('r-score').textContent = data.score;

  const circle = document.getElementById('score-circle');
  const offset = 263.9 - (263.9 * data.score / 100);
  circle.setAttribute('stroke-dashoffset', String(offset));
  if (data.score >= 85) circle.setAttribute('stroke', '#1d9e75');
  else if (data.score >= 70) circle.setAttribute('stroke', '#f59e0b');
  else if (data.score >= 55) circle.setAttribute('stroke', '#fb923c');
  else circle.setAttribute('stroke', '#f43f5e');

  document.getElementById('r-message').textContent = data.message;

  document.getElementById('r-colors').innerHTML = (data.luckyColor || []).map(function(c) {
    return '<span class="color-chip">' + c + '</span>';
  }).join('');
  document.getElementById('r-item').textContent = data.luckyItem;
  document.getElementById('r-food').textContent = data.luckyFood;
  document.getElementById('r-direction').textContent = data.luckyDirection;
  document.getElementById('r-spot').textContent = data.luckySpot;

  document.getElementById('r-actions').innerHTML = (data.recommendedActions || []).map(function(a) {
    return '<div class="action-item"><div class="action-check">✓</div><p class="action-text">' + a + '</p></div>';
  }).join('');

  document.getElementById('r-cautions').innerHTML = (data.cautionActions || []).map(function(a) {
    return '<div class="caution-item"><div class="caution-icon">!</div><p class="caution-text">' + a + '</p></div>';
  }).join('');

  document.getElementById('coin-balance').textContent = data.remainingCoins + ' コイン';

  document.getElementById('form-section').style.display = 'none';
  document.getElementById('result-section').style.display = 'block';
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

window.resetAll = function() {
  document.getElementById('result-section').style.display = 'none';
  document.getElementById('form-section').style.display = 'block';
  loadBalance(localStorage.getItem('kyusei_token'));
  window.scrollTo({ top: 0, behavior: 'smooth' });
};

const starsEl = document.getElementById('stars');
for (let i = 0; i < 50; i++) {
  const s = document.createElement('div');
  const size = Math.random() * 2 + 1;
  s.style.cssText = 'position:absolute;border-radius:50%;background:#fff;width:' + size + 'px;height:' + size + 'px;top:' + (Math.random()*100) + '%;left:' + (Math.random()*100) + '%;opacity:' + (Math.random()*0.5+0.1) + ';animation:twinkle ' + (2+Math.random()*3) + 's ease-in-out infinite;animation-delay:' + (Math.random()*3) + 's;';
  starsEl.appendChild(s);
}

init();
</script>
