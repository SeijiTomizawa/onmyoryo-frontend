---
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/global.css';
---
<Layout title="九星気学 相性鑑定 | 陰陽寮">
  <div class="page">
    <div class="stars" id="stars"></div>
    <div class="page-inner">

      <header class="page-header fade-in-up">
        <div class="header-icon">❤️</div>
        <h1 class="page-title">九星気学 相性鑑定</h1>
        <p class="page-desc">二つの星の気が織りなす、運命の縁を読み解きます</p>
        <div class="header-divider"></div>
      </header>

      <div class="glass-card intro-card fade-in-up delay-1">
        <h2 class="intro-title">あの人との縁は、必然ですか？</h2>
        <p class="intro-text">九星気学の相性鑑定では、あなたと気になる相手の本命星の「五行の気」の関係から、二人の縁の深さ・恋愛・仕事における相性を読み解きます。相性が良い・悪いだけでなく、「この縁にどんな意味があるか」まで丁寧に伝えます。</p>
        <div class="intro-features">
          <div class="intro-feature">
            <span class="feature-icon">❤️</span>
            <div>
              <p class="feature-title">恋愛相性</p>
              <p class="feature-desc">二人の縁の深さと、恋愛を長続きさせるためのポイント</p>
            </div>
          </div>
          <div class="intro-feature">
            <span class="feature-icon">💼</span>
            <div>
              <p class="feature-title">仕事相性</p>
              <p class="feature-desc">ビジネスパートナー・上司・部下としての相性と活かし方</p>
            </div>
          </div>
          <div class="intro-feature">
            <span class="feature-icon">🌟</span>
            <div>
              <p class="feature-title">縁の意味</p>
              <p class="feature-desc">なぜ二人は出会ったのか。この縁があなたにもたらす成長</p>
            </div>
          </div>
        </div>
      </div>

      <div class="coin-bar fade-in-up" id="coin-bar" style="display:none">
        <span class="coin-bar-label">保有コイン</span>
        <span class="coin-bar-value" id="coin-balance">-- コイン</span>
        <span class="coin-bar-cost">相性鑑定 3コイン</span>
      </div>

      <div id="form-section">
        <div class="glass-card form-card fade-in-up delay-2">

          <div class="person-section my-section">
            <div class="person-label-row">
              <span class="person-icon">⭐</span>
              <span class="person-label">あなた</span>
              <span class="person-star-preview" id="my-star-preview"></span>
            </div>
            <div class="autofill-banner" id="autofill-banner" style="display:none"></div>
            <div class="date-row">
              <div class="field"><label>生年（西暦）</label><input type="number" id="my-year" placeholder="1990" min="1900" max="2010" onchange="updateMyStarPreview()" /></div>
              <div class="field"><label>月</label><select id="my-month">{Array.from({length:12},(_,i)=><option value={i+1}>{i+1}月</option>)}</select></div>
              <div class="field"><label>日</label><select id="my-day">{Array.from({length:31},(_,i)=><option value={i+1}>{i+1}日</option>)}</select></div>
            </div>
          </div>

          <div class="vs-divider">
            <div class="vs-line"></div>
            <span class="vs-text">VS</span>
            <div class="vs-line"></div>
          </div>

          <div class="person-section target-section">
            <div class="person-label-row">
              <span class="person-icon">💫</span>
              <span class="person-label">お相手</span>
              <span class="person-star-preview" id="target-star-preview"></span>
            </div>
            <div class="field" style="margin-bottom:0.75rem">
              <label>ニックネーム（任意）</label>
              <input type="text" id="target-name" placeholder="例：Aさん" maxlength="10" />
            </div>
            <div class="field">
              <label>生年（西暦）</label>
              <input type="number" id="target-year" placeholder="1988" min="1900" max="2010" onchange="updateTargetStarPreview()" />
            </div>
            <p class="form-note">※ 九星気学の本命星は生まれ年のみで決まります</p>
          </div>

          <div id="star-preview-section" style="display:none" class="star-preview-section">
            <div class="preview-stars">
              <div class="preview-star">
                <div class="preview-badge" id="ps-my-badge"></div>
                <p class="preview-star-name" id="ps-my-name"></p>
              </div>
              <div class="preview-arrow">⟺</div>
              <div class="preview-star">
                <div class="preview-badge target" id="ps-target-badge"></div>
                <p class="preview-star-name" id="ps-target-name"></p>
              </div>
            </div>
            <p class="preview-hint">詳細な相性は鑑定でご確認ください</p>
          </div>

          <p class="error-msg" id="form-error"></p>

          <div id="login-note" style="display:none">
            <p class="login-text">鑑定にはログインが必要です</p>
            <a href="/login" class="btn-primary" style="display:inline-block;text-decoration:none;text-align:center">ログイン・新規登録</a>
          </div>

          <button class="btn-primary cast-btn" id="cast-btn" onclick="runCompat()" style="display:none">
            ❤️ 相性を鑑定する（3コイン）
          </button>
        </div>
      </div>

      <div id="result-section" style="display:none">
        <div class="result-grid">

          <div class="glass-card score-card fade-in-up">
            <div class="score-header">
              <div class="score-person">
                <div class="person-star-badge" id="r-my-badge"></div>
                <p class="person-star-name" id="r-my-star"></p>
                <p class="person-label">あなた</p>
              </div>
              <div class="score-center">
                <div class="score-ring">
                  <svg viewBox="0 0 120 120" class="ring-svg">
                    <circle cx="60" cy="60" r="50" fill="none" stroke="#ffffff0d" stroke-width="10"/>
                    <circle cx="60" cy="60" r="50" fill="none" stroke-width="10"
                      stroke-dasharray="314.2" stroke-dashoffset="314.2"
                      stroke-linecap="round" transform="rotate(-90 60 60)"
                      id="score-circle" stroke="#f43f5e"
                      style="transition: stroke-dashoffset 1.5s ease, stroke 0.5s ease"/>
                  </svg>
                  <div class="score-inner">
                    <span class="score-num" id="r-score">--</span>
                    <span class="score-pt">点</span>
                  </div>
                </div>
                <p class="score-label" id="r-compat-label">--</p>
              </div>
              <div class="score-person">
                <div class="person-star-badge target-badge" id="r-target-badge"></div>
                <p class="person-star-name" id="r-target-star"></p>
                <p class="person-label" id="r-target-name-label">お相手</p>
              </div>
            </div>
          </div>

          <div class="glass-card result-block element-block fade-in-up">
            <h3 class="block-title">✦ 五行の関係</h3>
            <div class="element-display">
              <div class="element-item">
                <p class="element-label">あなたの気</p>
                <p class="element-name" id="r-my-element"></p>
              </div>
              <div class="element-relation" id="r-element-relation"></div>
              <div class="element-item">
                <p class="element-label">お相手の気</p>
                <p class="element-name" id="r-target-element"></p>
              </div>
            </div>
          </div>

          <div class="glass-card result-block fade-in-up">
            <h3 class="block-title">✦ 二人の縁・総合相性</h3>
            <p class="block-text" id="r-overall"></p>
          </div>

          <div class="glass-card result-block love-block fade-in-up">
            <h3 class="block-title">✦ 恋愛相性</h3>
            <p class="block-text" id="r-love"></p>
          </div>

          <div class="glass-card result-block work-block fade-in-up">
            <h3 class="block-title">✦ 仕事・協力関係</h3>
            <p class="block-text" id="r-work"></p>
          </div>

          <div class="glass-card result-block advice-block fade-in-up">
            <h3 class="block-title">✦ この縁をより豊かにするために</h3>
            <p class="block-text" id="r-advice"></p>
          </div>

          <div class="glass-card result-block next-block fade-in-up" style="text-align:center">
            <p class="next-title">さらに深く読み解きましょう</p>
            <div class="next-grid">
              <a href="/fortune/sukuyo/compat" class="next-btn"><span>🌙</span><span>宿曜相性</span><span class="next-cost">3C</span></a>
              <a href="/fortune/kyuseiki" class="next-btn"><span>⭐</span><span>年運詳細</span><span class="next-cost">2C</span></a>
              <a href="/fortune/eki" class="next-btn"><span>☯️</span><span>易占い</span><span class="next-cost">1C</span></a>
            </div>
            <button class="btn-secondary" onclick="resetAll()" style="margin-top:1.25rem">別の相手を鑑定する</button>
          </div>

        </div>
      </div>

    </div>
  </div>
</Layout>

<style>
.page { padding: 3rem 1.5rem; min-height: 100vh; position: relative; }
.stars { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
.page-inner { max-width: 680px; margin: 0 auto; position: relative; z-index: 1; }
.page-header { text-align: center; margin-bottom: 1.75rem; }
.header-icon { font-size: 3rem; margin-bottom: 0.75rem; filter: drop-shadow(0 0 20px rgba(244,63,94,0.6)); animation: float 4s ease-in-out infinite; }
@keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }
.page-title { font-family: 'Shippori Mincho', serif; font-size: 2rem; color: #fda4af; text-shadow: 0 0 30px rgba(244,63,94,0.4); margin-bottom: 0.5rem; }
.page-desc { font-size: 14px; color: var(--text-secondary); }
.header-divider { width: 60px; height: 1px; background: linear-gradient(90deg,transparent,#f43f5e,transparent); margin: 1rem auto 0; }
.intro-card { border-top: 2px solid #f43f5e; background: linear-gradient(180deg, rgba(40,10,20,0.7) 0%, rgba(10,12,16,0.85) 100%); margin-bottom: 1.5rem; }
.intro-title { font-family: 'Shippori Mincho', serif; font-size: 1.25rem; color: #fda4af; margin-bottom: 1rem; text-align: center; }
.intro-text { font-size: 14px; color: var(--text-secondary); line-height: 2; margin-bottom: 1.5rem; }
.intro-features { display: flex; flex-direction: column; gap: 0.75rem; }
.intro-feature { display: flex; gap: 1rem; align-items: flex-start; background: rgba(244,63,94,0.06); border-radius: var(--radius-md); padding: 0.875rem; border: 0.5px solid rgba(244,63,94,0.15); }
.feature-icon { font-size: 20px; flex-shrink: 0; }
.feature-title { font-size: 13px; color: #fda4af; font-family: 'Shippori Mincho', serif; margin-bottom: 2px; }
.feature-desc { font-size: 12px; color: var(--text-secondary); line-height: 1.7; }
.coin-bar { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem; background: rgba(244,63,94,0.07); border: 0.5px solid rgba(244,63,94,0.2); border-radius: var(--radius-md); padding: 0.75rem 1rem; }
.coin-bar-label { font-size: 12px; color: var(--text-secondary); }
.coin-bar-value { font-size: 16px; color: #fda4af; font-weight: 500; }
.coin-bar-cost { font-size: 11px; color: var(--text-muted); margin-left: auto; }
.form-card { border-top: 2px solid #f43f5e; margin-bottom: 1.25rem; }
.person-section { padding: 1.25rem; border-radius: var(--radius-md); margin-bottom: 0.75rem; }
.my-section { background: rgba(212,175,55,0.06); border: 0.5px solid rgba(212,175,55,0.2); }
.target-section { background: rgba(244,63,94,0.06); border: 0.5px solid rgba(244,63,94,0.18); }
.person-label-row { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.875rem; }
.person-icon { font-size: 18px; }
.person-label { font-family: 'Shippori Mincho', serif; font-size: 15px; color: #f0e6d3; }
.person-star-preview { font-size: 12px; color: #fde68a; margin-left: auto; background: rgba(212,175,55,0.12); padding: 3px 10px; border-radius: 999px; min-height: 22px; }
.date-row { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 8px; }
.field { display: flex; flex-direction: column; gap: 4px; }
.field label { font-size: 11px; color: var(--text-secondary); }
.form-note { font-size: 11px; color: var(--text-muted); margin-top: 0.5rem; }
.autofill-banner { background: rgba(16,185,129,0.1); border: 0.5px solid rgba(16,185,129,0.3); border-radius: var(--radius-md); padding: 0.5rem 0.875rem; font-size: 12px; color: #6ee7b7; margin-bottom: 0.75rem; }
.vs-divider { display: flex; align-items: center; gap: 1rem; margin: 0.5rem 0 0.75rem; }
.vs-line { flex: 1; height: 1px; background: linear-gradient(90deg, transparent, rgba(244,63,94,0.35), transparent); }
.vs-text { font-family: 'Shippori Mincho', serif; font-size: 20px; color: #f43f5e; letter-spacing: 0.2em; }
.star-preview-section { background: rgba(244,63,94,0.05); border: 0.5px solid rgba(244,63,94,0.18); border-radius: var(--radius-md); padding: 1rem; margin-bottom: 1.25rem; }
.preview-stars { display: flex; align-items: center; justify-content: center; gap: 1.5rem; margin-bottom: 0.5rem; }
.preview-star { display: flex; flex-direction: column; align-items: center; gap: 6px; }
.preview-badge { width: 48px; height: 48px; border-radius: 50%; background: linear-gradient(135deg, var(--gold), #8b6d20); display: flex; align-items: center; justify-content: center; font-family: 'Shippori Mincho', serif; font-size: 18px; color: #000; font-weight: bold; }
.preview-badge.target { background: linear-gradient(135deg, #f43f5e, #9f1239); color: #fff; }
.preview-star-name { font-size: 12px; color: var(--text-secondary); text-align: center; }
.preview-arrow { font-size: 24px; color: rgba(244,63,94,0.5); }
.preview-hint { font-size: 11px; color: var(--text-secondary); text-align: center; }
.error-msg { font-size: 13px; color: #ff8e8e; min-height: 1.2em; margin: 0.5rem 0; }
.login-text { font-size: 13px; color: var(--text-secondary); text-align: center; margin-bottom: 0.75rem; }
.cast-btn { width: 100%; margin-top: 0.5rem; background: linear-gradient(135deg, rgba(244,63,94,0.8), rgba(190,24,93,0.8)); border-color: #f43f5e; font-size: 16px; }
.cast-btn:hover { background: linear-gradient(135deg, #f43f5e, #be185d); }
.result-grid { display: flex; flex-direction: column; gap: 1.25rem; }
.result-block { padding: 1.5rem; }
.block-title { font-family: 'Shippori Mincho', serif; font-size: 16px; color: #fda4af; margin-bottom: 1rem; padding-bottom: 0.75rem; border-bottom: 0.5px solid rgba(244,63,94,0.2); }
.block-text { font-size: 15px; color: var(--text-secondary); line-height: 2.1; }
.score-card { border-top: 3px solid #f43f5e; padding: 2rem; background: linear-gradient(135deg, rgba(40,10,20,0.9), rgba(10,12,16,0.95)); }
.score-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
.score-person { display: flex; flex-direction: column; align-items: center; gap: 8px; flex: 1; }
.person-star-badge { width: 56px; height: 56px; border-radius: 50%; background: linear-gradient(135deg, var(--gold), #8b6d20); display: flex; align-items: center; justify-content: center; font-family: 'Shippori Mincho', serif; font-size: 20px; color: #000; font-weight: bold; margin: 0 auto; filter: drop-shadow(0 4px 12px rgba(212,175,55,0.4)); }
.target-badge { background: linear-gradient(135deg, #f43f5e, #9f1239); color: #fff !important; filter: drop-shadow(0 4px 12px rgba(244,63,94,0.4)); }
.person-star-name { font-family: 'Shippori Mincho', serif; font-size: 13px; color: #f0e6d3; text-align: center; }
.person-label { font-size: 11px; color: var(--text-secondary); }
.score-center { display: flex; flex-direction: column; align-items: center; gap: 8px; flex-shrink: 0; }
.score-ring { position: relative; width: 110px; height: 110px; }
.ring-svg { width: 110px; height: 110px; }
.score-inner { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px; }
.score-num { font-family: 'Shippori Mincho', serif; font-size: 2rem; font-weight: bold; color: #f0e6d3; line-height: 1; }
.score-pt { font-size: 11px; color: var(--text-secondary); }
.score-label { font-family: 'Shippori Mincho', serif; font-size: 14px; color: #fda4af; }
.element-block { background: rgba(255,255,255,0.02); }
.element-display { display: flex; align-items: center; justify-content: center; gap: 1.5rem; padding: 0.5rem 0; }
.element-item { text-align: center; }
.element-label { font-size: 11px; color: var(--text-secondary); margin-bottom: 6px; }
.element-name { font-family: 'Shippori Mincho', serif; font-size: 20px; color: #f0e6d3; }
.element-relation { display: flex; flex-direction: column; align-items: center; gap: 4px; }
.element-relation-icon { font-size: 20px; }
.element-relation-text { font-size: 11px; color: #fda4af; white-space: nowrap; }
.love-block { border-left: 3px solid #fda4af; }
.work-block { border-left: 3px solid #93c5fd; }
.advice-block { border-left: 3px solid #f59e0b; background: linear-gradient(135deg, rgba(40,20,5,0.5), rgba(10,8,3,0.7)); }
.next-block { background: linear-gradient(135deg, rgba(20,10,20,0.6), rgba(10,8,16,0.8)); }
.next-title { font-size: 14px; color: var(--text-secondary); margin-bottom: 1.25rem; }
.next-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.next-btn { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 1rem 0.5rem; background: rgba(255,255,255,0.04); border: 0.5px solid rgba(255,255,255,0.1); border-radius: var(--radius-md); text-decoration: none; transition: all 0.2s; font-size: 13px; color: #f0e6d3; }
.next-btn:hover { border-color: #f43f5e; background: rgba(244,63,94,0.08); transform: translateY(-2px); }
.next-btn span:first-child { font-size: 22px; }
.next-cost { font-size: 11px; color: #fda4af; background: rgba(244,63,94,0.12); padding: 2px 10px; border-radius: 999px; }
.btn-secondary { background: transparent; border: 0.5px solid rgba(255,255,255,0.2); color: var(--text-secondary); padding: 0.6rem 1.5rem; border-radius: var(--radius-md); font-size: 14px; cursor: pointer; font-family: 'Noto Serif JP', serif; }
@media (max-width: 600px) {
  .score-ring { width: 90px; height: 90px; }
  .ring-svg { width: 90px; height: 90px; }
  .score-num { font-size: 1.6rem; }
  .person-star-badge { width: 48px; height: 48px; font-size: 16px; }
}
@keyframes twinkle { 0%,100%{opacity:0.15}50%{opacity:0.7} }
</style>

<script is:inline>
const WORKERS_URL = 'https://kyusei-api.seiji-tomizawa.workers.dev';
const ELEMENT_NAMES = { water:'水（水）', wood:'木（木）', fire:'火（火）', earth:'土（土）', metal:'金（金）' };
const STAR_CHARS = { 1:'水',2:'土',3:'木',4:'木',5:'土',6:'金',7:'金',8:'土',9:'火' };
const STAR_NAMES = { 1:'一白水星',2:'二黒土星',3:'三碧木星',4:'四緑木星',5:'五黄土星',6:'六白金星',7:'七赤金星',8:'八白土星',9:'九紫火星' };

function getHonmei(year) {
  const map = { 0:9,1:8,2:7,3:6,4:5,5:4,6:3,7:2,8:1 };
  return map[year % 9] ?? 5;
}

(function init() {
  const token = localStorage.getItem('kyusei_token');
  const user = JSON.parse(localStorage.getItem('kyusei_user') || 'null');
  if (!token) {
    document.getElementById('cast-btn').style.display = 'none';
    document.getElementById('login-note').style.display = 'block';
    return;
  }
  document.getElementById('coin-bar').style.display = 'flex';
  document.getElementById('cast-btn').style.display = 'block';
  loadBalance(token);
  if (user?.birth_date) {
    const [y, m, d] = user.birth_date.split('-').map(Number);
    document.getElementById('my-year').value = y;
    document.getElementById('my-month').value = m;
    document.getElementById('my-day').value = d;
    const name = user.display_name || user.email?.split('@')[0] || '';
    if (name) { const b = document.getElementById('autofill-banner'); b.textContent = name + 'さんの生年月日を自動入力しました'; b.style.display = 'block'; }
    updateMyStarPreview();
  }
})();

async function loadBalance(token) {
  try {
    const res = await fetch(`${WORKERS_URL}/api/coins/balance`, { headers: { Authorization: 'Bearer ' + token } });
    const data = await res.json();
    document.getElementById('coin-balance').textContent = data.coins + ' コイン';
  } catch {}
}

window.updateMyStarPreview = function() {
  const year = parseInt(document.getElementById('my-year').value);
  if (!year || year < 1900 || year > 2010) return;
  const h = getHonmei(year);
  document.getElementById('my-star-preview').textContent = STAR_NAMES[h] || '';
  document.getElementById('ps-my-badge').textContent = STAR_CHARS[h] || '';
  document.getElementById('ps-my-name').textContent = STAR_NAMES[h] || '';
  tryShowPreview();
};

window.updateTargetStarPreview = function() {
  const year = parseInt(document.getElementById('target-year').value);
  if (!year || year < 1900 || year > 2010) return;
  const h = getHonmei(year);
  document.getElementById('target-star-preview').textContent = STAR_NAMES[h] || '';
  document.getElementById('ps-target-badge').textContent = STAR_CHARS[h] || '';
  document.getElementById('ps-target-name').textContent = STAR_NAMES[h] || '';
  tryShowPreview();
};

function tryShowPreview() {
  const my = parseInt(document.getElementById('my-year').value);
  const tg = parseInt(document.getElementById('target-year').value);
  if (my >= 1900 && tg >= 1900) document.getElementById('star-preview-section').style.display = 'block';
}

window.runCompat = async function() {
  const token = localStorage.getItem('kyusei_token');
  if (!token) { window.location.href = '/login'; return; }
  const myYear = document.getElementById('my-year').value;
  const targetYear = document.getElementById('target-year').value;
  const targetName = document.getElementById('target-name').value || 'お相手';
  const errEl = document.getElementById('form-error');
  errEl.textContent = '';
  if (!myYear || parseInt(myYear) < 1900) { errEl.textContent = 'あなたの生年を入力してください'; return; }
  if (!targetYear || parseInt(targetYear) < 1900) { errEl.textContent = '相手の生年を入力してください'; return; }
  const btn = document.getElementById('cast-btn');
  btn.textContent = '鑑定中...'; btn.disabled = true;
  try {
    const res = await fetch(`${WORKERS_URL}/api/ai_fortune/compat`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
      body: JSON.stringify({ target_year: parseInt(targetYear), target_name: targetName }),
    });
    const data = await res.json();
    if (!res.ok) { errEl.textContent = data.error || 'エラーが発生しました'; return; }
    displayResult(data, targetName);
  } catch {
    errEl.textContent = '通信エラーが発生しました。';
  } finally {
    btn.textContent = '❤️ 相性を鑑定する（3コイン）'; btn.disabled = false;
  }
};

function displayResult(data, targetName) {
  const compat = data.compat;
  document.getElementById('r-my-badge').textContent = STAR_CHARS[data.myHonmei] || '★';
  document.getElementById('r-my-star').textContent = data.myStarName || STAR_NAMES[data.myHonmei] || '';
  document.getElementById('r-target-badge').textContent = STAR_CHARS[data.targetHonmei] || '★';
  document.getElementById('r-target-star').textContent = data.targetStarName || STAR_NAMES[data.targetHonmei] || '';
  document.getElementById('r-target-name-label').textContent = targetName;
  const score = compat.score || 0;
  document.getElementById('r-score').textContent = score;
  document.getElementById('r-compat-label').textContent = compat.label || '';
  const circle = document.getElementById('score-circle');
  const color = score >= 85 ? '#5ef0c5' : score >= 70 ? '#f59e0b' : score >= 50 ? '#fb923c' : '#f43f5e';
  circle.style.stroke = color;
  setTimeout(() => { circle.style.strokeDashoffset = (314.2 - 314.2 * score / 100).toString(); }, 100);
  document.getElementById('r-my-element').textContent = ELEMENT_NAMES[compat.myElement] || compat.myElement || '';
  document.getElementById('r-target-element').textContent = ELEMENT_NAMES[compat.targetElement] || compat.targetElement || '';
  const isPos = score >= 65;
  document.getElementById('r-element-relation').innerHTML = `<span class="element-relation-icon">${isPos ? '🌊' : '⚡'}</span><span class="element-relation-text">${isPos ? '相生（助け合う）' : '相剋（刺激し合う）'}</span>`;
  document.getElementById('r-overall').textContent = compat.overall || '';
  document.getElementById('r-love').textContent = compat.love || '';
  document.getElementById('r-work').textContent = compat.work || '';
  document.getElementById('r-advice').textContent = compat.advice || '';
  if (data.remainingCoins !== undefined) document.getElementById('coin-balance').textContent = data.remainingCoins + ' コイン';
  document.getElementById('form-section').style.display = 'none';
  document.getElementById('result-section').style.display = 'block';
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

window.resetAll = function() {
  document.getElementById('result-section').style.display = 'none';
  document.getElementById('form-section').style.display = 'block';
  document.getElementById('target-year').value = '';
  document.getElementById('target-name').value = '';
  document.getElementById('target-star-preview').textContent = '';
  document.getElementById('form-error').textContent = '';
  document.getElementById('star-preview-section').style.display = 'none';
  loadBalance(localStorage.getItem('kyusei_token'));
  window.scrollTo({ top: 0, behavior: 'smooth' });
};

const starsEl = document.getElementById('stars');
for (let i = 0; i < 60; i++) {
  const s = document.createElement('div');
  const size = Math.random() * 2 + 1;
  s.style.cssText = `position:absolute;border-radius:50%;background:#fff;width:${size}px;height:${size}px;top:${Math.random()*100}%;left:${Math.random()*100}%;opacity:${Math.random()*0.4+0.1};animation:twinkle ${2+Math.random()*3}s ease-in-out infinite;animation-delay:${Math.random()*3}s;`;
  starsEl.appendChild(s);
}
</script>