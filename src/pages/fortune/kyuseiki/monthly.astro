---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
---
<Layout title="月運詳細鑑定 | 陰陽寮">
  <div class="page">
    <div class="stars" id="stars"></div>
    <div class="page-inner">

      <header class="page-header fade-in-up">
        <h1 class="page-title">今月の詳細月運</h1>
        <p class="page-desc" id="month-label">今月の運気の流れを詳しく読み解きます</p>
      </header>

      <section class="glass-card intro-card fade-in-up delay-1">
        <h2 class="intro-title">今月、あなたはどんな時期にいますか？</h2>
        <p class="intro-text">
          九星気学では、毎月訪れる「月盤の星」があなたの本命星と交差することで、
          その月特有のエネルギーが生まれます。月運詳細鑑定では、今月のテーマ・恋愛運・仕事運・
          金運・健康運・吉日・注意日・そして日ごとの運気グラフまで、今月の運気を完全に読み解きます。
        </p>
      </section>

      <!-- コイン残高 -->
      <aside class="coin-balance-bar" id="balance-bar" style="display:none">
        <span class="balance-label">保有コイン</span>
        <span class="balance-value" id="coin-balance">-- コイン</span>
        <span class="balance-cost">月運詳細 2コイン（¥200相当）</span>
      </aside>

      <!-- 鑑定ボタン -->
      <section id="form-section">
        <div class="glass-card form-card fade-in-up delay-2" style="text-align:center">
          <div class="autofill-banner" id="autofill-banner" style="display:none"></div>
          <p class="form-desc">今月の詳細な運気を鑑定します。生年月日を登録済みの方はワンクリックで鑑定できます。</p>
          <div id="login-note" style="display:none">
            <p style="font-size:14px;color:var(--text-secondary);margin-bottom:0.75rem">鑑定にはログインが必要です</p>
            <a href="/login" class="btn-primary" style="display:inline-block;text-decoration:none">ログイン・新規登録</a>
          </div>
          <button class="btn-primary cast-btn" id="cast-btn" onclick="runMonthly()">
            🌙 今月の詳細月運を鑑定する（2コイン）
          </button>
        </div>
      </section>

      <!-- 結果セクション -->
      <section id="result-section" style="display:none">
        <div class="result-grid">

          <!-- 月運スコア -->
          <section class="glass-card result-block score-card">
            <div class="score-layout">
              <div class="score-left">
                <p class="score-month" id="r-month"></p>
                <h2 class="score-star" id="r-star"></h2>
                <p class="score-month-star" id="r-month-star"></p>
              </div>
              <div class="score-right">
                <div class="score-ring">
                  <svg viewBox="0 0 100 100" class="ring-svg">
                    <circle cx="50" cy="50" r="42" fill="none" stroke="#ffffff10" stroke-width="7"/>
                    <circle cx="50" cy="50" r="42" fill="none" stroke-width="7"
                      stroke-dasharray="263.9" stroke-linecap="round"
                      transform="rotate(-90 50 50)" id="score-circle" stroke="#7c6fcd"/>
                  </svg>
                  <div class="ring-score" id="r-score">--</div>
                </div>
                <p class="ring-label">今月の運気</p>
              </div>
            </div>
          </section>

          <!-- 今月の概要 -->
          <section   class="glass-card result-block">
            <h3 class="block-title">🌙 今月のテーマ・全体運</h3>
            <p class="block-text" id="r-overview"></p>
          </section>

          <!-- 各分野 -->
          <section class="glass-card result-block">
            <h3 class="block-title">✦ 各分野の運気</h3>
            <div class="field-grid">
              <div class="field-item">
                <h4 class="field-label love">❤️ 恋愛運</h4>
                <p class="field-text" id="r-love"></p>
              </div>
              <div class="field-item">
                <h4 class="field-label work">💼 仕事運</h4>
                <p class="field-text" id="r-work"></p>
              </div>
              <div class="field-item">
                <h4 class="field-label money">💰 金運</h4>
                <p class="field-text" id="r-money"></p>
              </div>
              <div class="field-item">
                <h4 class="field-label health">🌿 健康運</h4>
                <p class="field-text" id="r-health"></p>
              </div>
            </div>
          </section>

          <!-- 吉日・注意日 -->
          <section class="glass-card result-block">
            <h3 class="block-title">✦ 吉日・注意日</h3>
            <div class="days-layout">
              <div class="days-group">
                <p class="days-label lucky-label">✦ 吉日（積極的に動く日）</p>
                <div class="days-chips" id="r-lucky-days"></div>
              </div>
              <div class="days-group">
                <p class="days-label caution-label">⚠ 注意日（慎重に過ごす日）</p>
                <div class="days-chips" id="r-caution-days"></div>
              </div>
            </div>
          </section>

          <!-- 日ごとの運気グラフ -->
          <section class="glass-card result-block">
            <h3 class="block-title">✦ 日ごとの運気カレンダー</h3>
            <div class="calendar-grid" id="r-calendar"></div>
          </section>

          <!-- アドバイス -->
          <section class="glass-card result-block advice-block">
            <h3 class="block-title">✦ 今月のあなたへ</h3>
            <p class="block-text advice-text" id="r-advice"></p>
          </section>

          <!-- 再鑑定 -->
          <aside class="glass-card result-block" style="text-align:center">
            <a href="/fortune/compat" class="btn-primary" style="display:block;text-decoration:none;max-width:300px;margin:0 auto 0.75rem;text-align:center">
              ❤️ 相性鑑定も試してみる
            </a>
            <a href="/mypage" class="btn-outline" style="display:block;max-width:300px;margin:0 auto;text-align:center">マイページへ</a>
          </aside>
        </section>
      </div>
    </div>
  </div>
</Layout>

<style>
.page { padding: 3rem 1.5rem; min-height: 100vh; position: relative; }
.stars { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
.page-inner { max-width: 680px; margin: 0 auto; position: relative; z-index: 1; }
.page-header { text-align: center; margin-bottom: 2rem; }
.page-title { font-family: 'Shippori Mincho', serif; font-size: 26px; margin-bottom: 0.5rem; }
.page-desc { font-size: 14px; color: var(--text-secondary); }

.intro-card { text-align: center; margin-bottom: 2rem; border-top: 2px solid #7c6fcd; background: linear-gradient(180deg, rgba(20,15,40,0.6) 0%, rgba(10,12,16,0.8) 100%); }
.intro-title { font-family: 'Shippori Mincho', serif; font-size: 1.3rem; color: #c4b5fd; margin-bottom: 1rem; }
.intro-text { font-size: 15px; color: var(--text-secondary); line-height: 2; }

.coin-balance-bar { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; background: var(--dark-card); border: 0.5px solid #ffffff15; border-radius: var(--radius-md); padding: 0.6rem 1rem; }
.balance-label { font-size: 12px; color: var(--text-secondary); }
.balance-value { font-size: 16px; color: #7c6fcd; font-weight: 500; }
.balance-cost { font-size: 11px; color: var(--text-muted); margin-left: auto; }

.autofill-banner { background: rgba(29,158,117,0.12); border: 0.5px solid rgba(29,158,117,0.3); border-radius: var(--radius-md); padding: 0.5rem 0.875rem; font-size: 13px; color: #1d9e75; margin-bottom: 1rem; }
.form-desc { font-size: 15px; color: var(--text-secondary); line-height: 1.9; margin-bottom: 1.25rem; }
.cast-btn { max-width: 100%; background: linear-gradient(135deg, rgba(124,111,205,0.8), rgba(79,70,229,0.8)); border-color: #7c6fcd; font-size: 16px; }
.cast-btn:hover { background: linear-gradient(135deg, #7c6fcd, #4f46e5); }

/* 結果 */
.result-grid { display: flex; flex-direction: column; gap: 1.25rem; margin-top: 2rem; }
.result-block { padding: 1.75rem; }
.block-title { font-family: 'Shippori Mincho', serif; font-size: 16px; color: #c4b5fd; margin-bottom: 1rem; padding-bottom: 0.75rem; border-bottom: 0.5px solid rgba(124,111,205,0.3); }
.block-text { font-size: 15px; color: var(--text-secondary); line-height: 2; }

.score-card { border-top: 3px solid #7c6fcd; background: linear-gradient(135deg, rgba(20,15,40,0.9), rgba(10,12,16,0.9)); }
.score-layout { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
.score-month { font-size: 12px; color: var(--text-secondary); margin-bottom: 4px; }
.score-star { font-family: 'Shippori Mincho', serif; font-size: 22px; color: #f0e6d3; margin-bottom: 4px; }
.score-month-star { font-size: 13px; color: #c4b5fd; }
.score-ring { position: relative; width: 100px; height: 100px; }
.ring-svg { width: 100px; height: 100px; }
.ring-score { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 26px; font-weight: bold; color: #c4b5fd; }
.ring-label { font-size: 11px; color: var(--text-secondary); text-align: center; margin-top: 4px; }

.field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.field-item { background: rgba(255,255,255,0.03); border-radius: var(--radius-md); padding: 1rem; }
.field-label { font-size: 13px; margin-bottom: 0.5rem; }
.field-label.love { color: #fda4af; }
.field-label.work { color: #93c5fd; }
.field-label.money { color: #fde68a; }
.field-label.health { color: #6ee7b7; }
.field-text { font-size: 14px; color: var(--text-secondary); line-height: 1.9; }

.days-layout { display: flex; flex-direction: column; gap: 1rem; }
.days-label { font-size: 12px; margin-bottom: 0.5rem; }
.lucky-label { color: #1d9e75; }
.caution-label { color: #f59e0b; }
.days-chips { display: flex; flex-wrap: wrap; gap: 8px; }
.day-chip { font-size: 13px; padding: 4px 12px; border-radius: 999px; }
.lucky-chip { background: rgba(29,158,117,0.15); color: #1d9e75; border: 0.5px solid rgba(29,158,117,0.3); }
.caution-chip { background: rgba(245,158,11,0.15); color: #f59e0b; border: 0.5px solid rgba(245,158,11,0.3); }

/* カレンダー */
.calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
.cal-header { text-align: center; font-size: 10px; color: var(--text-muted); padding: 4px 0; }
.cal-day { text-align: center; padding: 6px 2px; border-radius: 6px; }
.cal-day-num { font-size: 11px; color: var(--text-secondary); display: block; }
.cal-day-label { font-size: 9px; display: block; margin-top: 2px; }
.cal-great { background: rgba(29,158,117,0.2); }
.cal-great .cal-day-num { color: #1d9e75; }
.cal-great .cal-day-label { color: #1d9e75; }
.cal-good { background: rgba(124,111,205,0.15); }
.cal-good .cal-day-label { color: #c4b5fd; }
.cal-normal .cal-day-label { color: var(--text-muted); }
.cal-caution { background: rgba(245,158,11,0.1); }
.cal-caution .cal-day-label { color: #f59e0b; }

.advice-block { background: linear-gradient(135deg, rgba(20,15,40,0.6), rgba(10,12,16,0.8)); border-left: 3px solid #7c6fcd; }
.advice-text { font-size: 16px; line-height: 2.1; color: #f0e6d3; }

.btn-outline { background: transparent; color: #7c6fcd; border: 0.5px solid #7c6fcd; border-radius: var(--radius-md); padding: 0.6rem 1.5rem; font-size: 14px; cursor: pointer; font-family: 'Noto Serif JP', serif; transition: all 0.2s; }
.btn-outline:hover { background: #7c6fcd; color: #fff; }

@keyframes twinkle { 0%,100% { opacity: 0.2; } 50% { opacity: 0.8; } }
</style>

<script is:inline>
const WORKERS_URL = 'https://kyusei-api.seiji-tomizawa.workers.dev';

function init() {
  const token = localStorage.getItem('kyusei_token');
  const user = JSON.parse(localStorage.getItem('kyusei_user') || 'null');
  const now = new Date();

  document.getElementById('month-label').textContent =
    `${now.getFullYear()}年${now.getMonth()+1}月の運気を詳しく読み解きます`;

  if (!token) {
    document.getElementById('cast-btn').style.display = 'none';
    document.getElementById('login-note').style.display = 'block';
    return;
  }

  document.getElementById('balance-bar').style.display = 'flex';
  loadBalance(token);

  if (user) {
    const name = user.display_name || user.email.split('@')[0];
    const banner = document.getElementById('autofill-banner');
    banner.textContent = `${name}さんの鑑定を行います`;
    banner.style.display = 'block';
  }
}

async function loadBalance(token) {
  try {
    const res = await fetch(`${WORKERS_URL}/api/coins/balance`, { headers: { Authorization: `Bearer ${token}` } });
    const data = await res.json();
    document.getElementById('coin-balance').textContent = `${data.coins} コイン`;
  } catch {}
}

window.runMonthly = async function() {
  const token = localStorage.getItem('kyusei_token');
  if (!token) { window.location.href = '/login'; return; }

  const btn = document.getElementById('cast-btn');
  btn.textContent = '鑑定中...'; btn.disabled = true;

  try {
    const res = await fetch(`${WORKERS_URL}/api/ai_fortune/monthly`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({}),
    });
    const data = await res.json();

    if (!res.ok) {
      alert(data.error || 'エラーが発生しました');
      return;
    }

    displayResult(data);
  } catch {
    alert('通信エラーが発生しました。しばらくしてお試しください。');
  } finally {
    btn.textContent = '🌙 今月の詳細月運を鑑定する（2コイン）';
    btn.disabled = false;
  }
};

function displayResult(data) {
  const now = new Date();

  // スコア
  document.getElementById('r-month').textContent = `${data.year}年${data.month}月`;
  document.getElementById('r-star').textContent = data.starName || `第${data.honmei}星`;
  document.getElementById('r-month-star').textContent = `月盤：第${data.monthStar}星の月`;
  document.getElementById('r-score').textContent = data.score;

  const circle = document.getElementById('score-circle');
  const offset = 263.9 - (263.9 * data.score / 100);
  circle.setAttribute('stroke-dashoffset', offset.toString());
  if (data.score >= 85) circle.setAttribute('stroke', '#1d9e75');
  else if (data.score >= 70) circle.setAttribute('stroke', '#7c6fcd');
  else if (data.score >= 55) circle.setAttribute('stroke', '#f59e0b');
  else circle.setAttribute('stroke', '#f43f5e');

  // テキスト
  document.getElementById('r-overview').textContent = data.overview;
  document.getElementById('r-love').textContent = data.love;
  document.getElementById('r-work').textContent = data.work;
  document.getElementById('r-money').textContent = data.money;
  document.getElementById('r-health').textContent = data.health;
  document.getElementById('r-advice').textContent = data.advice;

  // 吉日・注意日
  document.getElementById('r-lucky-days').innerHTML = (data.luckyDay || []).map(d =>
    `<span class="day-chip lucky-chip">${data.month}月${d}日</span>`
  ).join('');
  document.getElementById('r-caution-days').innerHTML = (data.cautionDay || []).map(d =>
    `<span class="day-chip caution-chip">${data.month}月${d}日</span>`
  ).join('');

  // カレンダー
  const calEl = document.getElementById('r-calendar');
  const days = ['日','月','火','水','木','金','土'];
  let calHtml = days.map(d => `<div class="cal-header">${d}</div>`).join('');

  // 月の最初の曜日
  const firstDay = new Date(data.year, data.month - 1, 1).getDay();
  for (let i = 0; i < firstDay; i++) calHtml += '<div></div>';

  (data.dayFortunes || []).forEach(df => {
    const cls = df.score >= 85 ? 'cal-great' : df.score >= 70 ? 'cal-good' : df.score >= 55 ? 'cal-normal' : 'cal-caution';
    calHtml += `<div class="cal-day ${cls}">
      <span class="cal-day-num">${df.day}</span>
      <span class="cal-day-label">${df.label}</span>
    </div>`;
  });
  calEl.innerHTML = calHtml;

  // コイン残高更新
  document.getElementById('coin-balance').textContent = `${data.remainingCoins} コイン`;

  document.getElementById('form-section').style.display = 'none';
  document.getElementById('result-section').style.display = 'block';
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// 星背景
const starsEl = document.getElementById('stars');
for (let i = 0; i < 50; i++) {
  const s = document.createElement('div');
  const size = Math.random() * 2 + 1;
  s.style.cssText = `position:absolute;border-radius:50%;background:#fff;width:${size}px;height:${size}px;top:${Math.random()*100}%;left:${Math.random()*100}%;opacity:${Math.random()*0.5+0.1};animation:twinkle ${2+Math.random()*3}s ease-in-out infinite;animation-delay:${Math.random()*3}s;`;
  starsEl.appendChild(s);
}

init();
</script>
