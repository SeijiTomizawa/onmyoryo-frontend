<!-- /src/pages/fortune/shichu.astro -->
---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
---
<Layout title="四柱推命・算命学 | 東洋占術">
  <div class="page">
    <div class="stars" id="stars"></div>
    <div class="page-inner">

      <header class="page-header fade-in-up">
        <h1 class="page-title">四柱推命・算命学</h1>
        <p class="page-desc">あなたの宿命の設計図と、真の才能を読み解きます</p>
      </header>

      <div class="glass-card intro-card fade-in-up delay-1">
        <h2 class="intro-title">魂の設計図を解読する「占いの帝王」</h2>
        <div class="intro-section">
          <h3 class="intro-section-title">四柱推命・算命学とは</h3>
          <p class="intro-text">四柱推命（しちゅうすいめい）と算命学（さんめいがく）は、あなたがこの世に生まれ落ちた瞬間に刻まれた「宿命」を極めて緻密に割り出す東洋占術の最高峰です。中国で数千年の歴史を持ち、生年・月・日・時の「四つの柱」と十干十二支の組み合わせから命式（めいしき）と呼ばれる設計図を作成します。</p>
        </div>
        <div class="intro-section">
          <h3 class="intro-section-title">日干（にっかん）とは</h3>
          <p class="intro-text">四柱推命の核心は「日干」です。生まれた日の十干（甲・乙・丙・丁・戊・己・庚・辛・壬・癸）がその人の本質を表します。それぞれ大樹・草花・太陽・灯火・山・大地・鋼鉄・宝石・海・雨という自然界のシンボルに例えられ、あなたの根本的な性格・才能・弱点・恋愛観・仕事への向き合い方を決定します。</p>
        </div>
        <div class="intro-section">
          <h3 class="intro-section-title">天中殺（てんちゅうさつ）とは</h3>
          <p class="intro-text">天中殺とは誰にでも訪れる「冬の時代」のことで、算命学の中核となる概念です。この時期の過ごし方が人生の大きな分岐点となります。天中殺を正しく理解することで、逆境を力に変えることができます。</p>
        </div>
        <div class="intro-features">
          <div class="intro-feature">
            <span class="feature-icon">🌳</span>
            <span><strong>命式盤：宿命の設計図</strong><br>年・月・日・時の四柱から作成する、あなただけの宿命の地図</span>
          </div>
          <div class="intro-feature">
            <span class="feature-icon">🌊</span>
            <span><strong>日干：本質と真の才能</strong><br>自然界のシンボルで表される、あなたの根本的な性質と才能</span>
          </div>
          <div class="intro-feature">
            <span class="feature-icon">⛓️</span>
            <span><strong>天中殺：冬の時代の活かし方</strong><br>誰にでも訪れる試練の時期を、成長の機会に変える知恵</span>
          </div>
        </div>
        <div class="intro-note">
          <p>※ 出生時間が不明でも鑑定できますが、時間が分かる場合はより精密な命式が作成できます。</p>
        </div>
      </div>

      <!-- 入力フォーム -->
      <div class="glass-card form-card fade-in-up delay-2" id="form-card">
        <div class="autofill-banner" id="autofill-banner" style="display:none"></div>
        <div class="date-row">
          <div class="field"><label>生年</label><input type="number" id="year" placeholder="1990" min="1900" max="2010" /></div>
          <div class="field">
            <label>月</label>
            <select id="month">{Array.from({length:12},(_,i)=><option value={i+1}>{i+1}月</option>)}</select>
          </div>
          <div class="field">
            <label>日</label>
            <select id="day">{Array.from({length:31},(_,i)=><option value={i+1}>{i+1}日</option>)}</select>
          </div>
        </div>
        <div class="date-row">
          <div class="field">
            <label>出生時間（不明でも可）</label>
            <select id="time">
              <option value="unknown">不明</option>
              {Array.from({length:24},(_,i)=><option value={i}>{i}時台</option>)}
            </select>
          </div>
          <div class="field">
            <label>性別</label>
            <select id="gender">
              <option value="f">女性</option>
              <option value="m">男性</option>
            </select>
          </div>
        </div>
        <p class="error-msg" id="form-error"></p>
        <button class="btn-primary" id="btn" onclick="runShichu()">✦ 命式を作成する（無料）</button>
      </div>

      <!-- 無料鑑定結果 -->
      <div id="result-section" style="display:none">
        <div class="result-grid">

          <!-- 命式盤 -->
          <div class="glass-card result-item meishiki-card">
            <h3 class="card-subtitle">命式盤</h3>
            <div class="meishiki-table">
              <div class="meishiki-col">
                <p class="col-label">時柱</p>
                <p class="col-kan" id="jichu-kan">--</p>
                <p class="col-shi" id="jichu-shi">--</p>
                <p class="col-tsuhen" id="jichu-tsuhen"></p>
              </div>
              <div class="meishiki-col">
                <p class="col-label">日柱</p>
                <p class="col-kan nikkan-highlight" id="nichu-kan"></p>
                <p class="col-shi" id="nichu-shi"></p>
                <p class="col-tsuhen">（本人）</p>
              </div>
              <div class="meishiki-col">
                <p class="col-label">月柱</p>
                <p class="col-kan" id="getchu-kan"></p>
                <p class="col-shi" id="getchu-shi"></p>
                <p class="col-tsuhen" id="getchu-tsuhen"></p>
              </div>
              <div class="meishiki-col">
                <p class="col-label">年柱</p>
                <p class="col-kan" id="nenchu-kan"></p>
                <p class="col-shi" id="nenchu-shi"></p>
                <p class="col-tsuhen" id="nenchu-tsuhen"></p>
              </div>
            </div>
            <div class="meishiki-meta">
              <span class="meta-chip" id="juniun-chip"></span>
              <span class="meta-chip" id="gogyo-chip"></span>
              <span class="meta-chip" id="inyo-chip"></span>
            </div>
          </div>

          <!-- 日干カード -->
          <div class="glass-card result-item nikkan-card">
            <p class="star-label" id="nikkan-label"></p>
            <h2 class="result-title" id="nikkan-name"></h2>
            <p class="star-sub" id="nikkan-gogyo"></p>
            <div class="personality-box" id="nikkan-personality"></div>
          </div>

          <!-- 天中殺 -->
          <div class="glass-card result-item">
            <h3 class="card-subtitle">算命学・天中殺</h3>
            <div class="tenchusatsu-box">
              <p class="tenchusatsu-name" id="tenchusatsu-name"></p>
              <p class="tenchusatsu-desc" id="tenchusatsu-desc"></p>
              <div class="tenchusatsu-detail" id="tenchusatsu-detail" style="display:none">
                <div class="tenchusatsu-section">
                  <p class="tenchusatsu-section-title">✦ 強み</p>
                  <p class="tenchusatsu-section-text" id="tenchusatsu-strength"></p>
                </div>
                <div class="tenchusatsu-section">
                  <p class="tenchusatsu-section-title">⚠ 天中殺の時期の注意点</p>
                  <p class="tenchusatsu-section-text" id="tenchusatsu-caution"></p>
                </div>
                <div class="tenchusatsu-section">
                  <p class="tenchusatsu-section-title">💡 天中殺の活かし方</p>
                  <p class="tenchusatsu-section-text" id="tenchusatsu-advice"></p>
                </div>
              </div>
            </div>
          </div>

          <!-- 有料誘導CTA（未ログイン） -->
          <div class="glass-card result-item premium-cta" id="premium-cta">
            <div class="cta-header">
              <div class="cta-ornament">✦</div>
              <h3 class="cta-title">さらに深く、あなたの宿命を読み解く</h3>
              <div class="cta-ornament">✦</div>
            </div>
            <p class="cta-lead">命式盤と日干・天中殺はほんの入口。詳細鑑定では、あなたの才能・弱点・恋愛・仕事・天職・大運まで完全に読み解きます。</p>
            <div class="cta-features">
              <div class="cta-feature">
                <span class="cta-feature-icon">💼</span>
                <div>
                  <p class="cta-feature-name">才能・天職の詳細</p>
                  <p class="cta-feature-desc">あなたが最も輝ける仕事・天職・具体的な職種</p>
                </div>
              </div>
              <div class="cta-feature">
                <span class="cta-feature-icon">❤️</span>
                <div>
                  <p class="cta-feature-name">恋愛・結婚運の詳細</p>
                  <p class="cta-feature-desc">恋愛パターン・理想のパートナー・結婚への道</p>
                </div>
              </div>
              <div class="cta-feature">
                <span class="cta-feature-icon">🌊</span>
                <div>
                  <p class="cta-feature-name">大運（10年の流れ）</p>
                  <p class="cta-feature-desc">10年ごとに変わる運気の流れと黄金期</p>
                </div>
              </div>
              <div class="cta-feature">
                <span class="cta-feature-icon">✨</span>
                <div>
                  <p class="cta-feature-name">今のあなたへのメッセージ</p>
                  <p class="cta-feature-desc">宿命から読み解く、今のあなたへの特別な言葉</p>
                </div>
              </div>
            </div>
            <div class="cta-divider"><span>コインをチャージして鑑定する</span></div>
            <div class="cta-plans">
              <div class="cta-plan" onclick="window.location.href='/register'">
                <p class="cta-plan-coin">100C</p>
                <p class="cta-plan-price">¥500</p>
                <p class="cta-plan-note">お試し</p>
              </div>
              <div class="cta-plan cta-plan-featured" onclick="window.location.href='/register'">
                <p class="cta-plan-badge">人気</p>
                <p class="cta-plan-coin">300C</p>
                <p class="cta-plan-price">¥1,200</p>
                <p class="cta-plan-note">おすすめ</p>
              </div>
              <div class="cta-plan" onclick="window.location.href='/register'">
                <p class="cta-plan-coin">500C</p>
                <p class="cta-plan-price">¥1,800</p>
                <p class="cta-plan-note">お得</p>
              </div>
            </div>
            <p class="cta-note">1コイン = ¥5相当 · 期限なし</p>
            <button class="cta-btn" onclick="window.location.href='/register'">無料登録して詳細鑑定を受ける</button>
            <p class="cta-sub">登録無料 · 1分で完了 · クレジットカード不要</p>
          </div>

          <!-- ログイン済み詳細鑑定ボタン -->
          <div class="glass-card result-item paid-menu" id="paid-menu" style="display:none">
            <h3 class="paid-menu-title">✦ 詳細鑑定を受ける</h3>
            <p class="paid-menu-desc">才能・弱点・恋愛・仕事・大運など、あなたの宿命をさらに深く読み解きます。</p>
            <div id="coin-bar" class="coin-bar">
              <span class="coin-bar-label">保有コイン</span>
              <span class="coin-bar-value" id="coin-balance">-- コイン</span>
              <span class="coin-bar-cost">詳細鑑定 3コイン</span>
            </div>
            <button class="btn-primary reading-btn" id="reading-btn" onclick="runReading()">
              🌳 詳細鑑定を受ける（3コイン）
            </button>
            <p class="error-msg" id="reading-error"></p>
          </div>

          <!-- 詳細鑑定結果（有料） -->
          <div id="premium-result" style="display:none">

            <!-- 才能 -->
            <div class="glass-card result-item talent-section">
              <h3 class="card-subtitle" id="talent-title">才能・特性</h3>
              <p class="talent-desc" id="talent-desc"></p>
            </div>

            <!-- 弱点 -->
            <div class="glass-card result-item weakness-section">
              <h3 class="card-subtitle" id="weakness-title">あなたへのやさしい注意点</h3>
              <p class="talent-desc" id="weakness-desc"></p>
            </div>

            <!-- 恋愛 -->
            <div class="glass-card result-item love-section">
              <h3 class="card-subtitle" id="love-title">恋愛でのあなたらしさ</h3>
              <p class="talent-desc" id="love-desc"></p>
            </div>

            <!-- 仕事 -->
            <div class="glass-card result-item work-section">
              <h3 class="card-subtitle" id="work-title">仕事でのあなたの輝き方</h3>
              <p class="talent-desc" id="work-desc"></p>
            </div>

            <!-- 天職 -->
            <div class="glass-card result-item career-section">
              <h3 class="card-subtitle">天職・向いている職種</h3>
              <div class="career-list" id="career-list"></div>
            </div>

            <!-- 大運 -->
            <div class="glass-card result-item daiun-section">
              <h3 class="card-subtitle">大運（10年ごとの運勢の流れ）</h3>
              <p class="daiun-intro">あなたの人生は10年ごとに異なるテーマを持つ「大運」が訪れます。それぞれの時期の流れを知ることで、今という時期をより深く理解できます。</p>
              <div class="daiun-list" id="daiun-list"></div>
            </div>

            <!-- メッセージ -->
            <div class="glass-card result-item message-card">
              <h3 class="card-subtitle">✦ 今のあなたへのメッセージ</h3>
              <p class="key-message-text" id="key-message"></p>
            </div>

          </div>

        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
.page { padding: 3rem 1.5rem; min-height: 100vh; position: relative; }
.stars { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
.page-inner { max-width: 680px; margin: 0 auto; position: relative; z-index: 1; }
.page-header { text-align: center; margin-bottom: 2rem; }
.page-title { font-family: 'Shippori Mincho', serif; font-size: 26px; margin-bottom: 0.5rem; }
.page-desc { font-size: 14px; color: var(--text-secondary); }

.intro-card { text-align: center; margin-bottom: 2rem; border-top: 2px solid var(--gold); background: linear-gradient(180deg, rgba(30,36,56,0.5) 0%, rgba(10,12,16,0.8) 100%); }
.intro-title { font-family: 'Shippori Mincho', serif; font-size: 1.4rem; color: var(--gold); margin-bottom: 1.25rem; }
.intro-text { font-size: 15px; color: var(--text-secondary); line-height: 2; margin-bottom: 1rem; }
.intro-features { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-top: 1.5rem; }
.intro-feature { display: flex; align-items: flex-start; gap: 0.75rem; text-align: left; background: rgba(255,255,255,0.03); padding: 1.25rem 1rem; border-radius: var(--radius-md); border: 1px solid rgba(255,255,255,0.05); flex: 1; min-width: 200px; }
.feature-icon { font-size: 1.4rem; line-height: 1; }
.intro-feature span { font-size: 14px; color: var(--text-secondary); line-height: 1.7; }
.intro-feature strong { display: block; color: #fff; font-size: 15px; margin-bottom: 0.25rem; font-family: 'Shippori Mincho', serif; }
.intro-section { margin-bottom: 1.25rem; text-align: left; }
.intro-section-title { font-family: 'Shippori Mincho', serif; font-size: 15px; color: var(--gold); margin-bottom: 0.5rem; }
.intro-note { margin-top: 1.25rem; padding: 0.75rem 1rem; background: rgba(255,255,255,0.03); border-radius: var(--radius-md); border: 0.5px solid rgba(255,255,255,0.08); }
.intro-note p { font-size: 12px; color: var(--text-secondary); margin: 0; }

.form-card { margin-bottom: 2rem; }
.date-row { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 8px; margin-bottom: 1rem; }
.field { display: flex; flex-direction: column; gap: 4px; }
.field label { font-size: 11px; color: var(--text-secondary); }
.autofill-banner { background: rgba(29,158,117,0.12); border: 0.5px solid rgba(29,158,117,0.3); border-radius: var(--radius-md); padding: 0.6rem 1rem; font-size: 13px; color: #1d9e75; margin-bottom: 1rem; }

.result-grid { display: flex; flex-direction: column; gap: 1.25rem; margin-top: 2rem; }
.card-subtitle { font-family: 'Shippori Mincho', serif; color: var(--gold); font-size: 17px; margin-bottom: 1.25rem; text-align: center; }

/* 命式盤 */
.meishiki-card { padding: 1.75rem; }
.meishiki-table { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 1rem; }
.meishiki-col { background: #ffffff06; border: 0.5px solid #ffffff15; border-radius: var(--radius-md); padding: 1rem 0.5rem; text-align: center; }
.col-label { font-size: 11px; color: var(--text-secondary); margin-bottom: 8px; }
.col-kan { font-family: 'Shippori Mincho', serif; font-size: 22px; margin-bottom: 6px; color: #f0e6d3; }
.col-shi { font-size: 18px; color: var(--text-secondary); margin-bottom: 6px; }
.col-tsuhen { font-size: 11px; color: var(--gold); }
.nikkan-highlight { color: var(--gold) !important; font-size: 26px !important; }
.meishiki-meta { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
.meta-chip { font-size: 13px; padding: 4px 12px; border-radius: 999px; background: rgba(176,141,90,0.15); color: var(--gold); border: 0.5px solid rgba(176,141,90,0.3); }

/* 日干カード */
.nikkan-card { text-align: center; border-top: 3px solid var(--gold); padding: 2rem; }
.star-label { font-size: 12px; color: var(--gold); letter-spacing: 0.2em; margin-bottom: 0.5rem; }
.star-sub { font-size: 13px; color: var(--text-secondary); margin-bottom: 1.25rem; }
.personality-box { background: rgba(176,141,90,0.08); border-left: 3px solid var(--gold); padding: 1.25rem; font-size: 15px; line-height: 2; text-align: left; border-radius: 0 var(--radius-md) var(--radius-md) 0; }

/* 天中殺 */
.tenchusatsu-box { background: rgba(255,255,255,0.03); border-radius: var(--radius-md); padding: 1.25rem; }
.tenchusatsu-name { font-family: 'Shippori Mincho', serif; font-size: 22px; color: var(--gold); margin-bottom: 0.75rem; text-align: center; }
.tenchusatsu-desc { font-size: 15px; color: var(--text-secondary); line-height: 2; }
.tenchusatsu-detail { margin-top: 1.25rem; display: flex; flex-direction: column; gap: 1rem; }
.tenchusatsu-section { background: rgba(255,255,255,0.03); border-radius: var(--radius-md); padding: 1rem; }
.tenchusatsu-section-title { font-size: 13px; color: var(--gold); margin-bottom: 0.5rem; }
.tenchusatsu-section-text { font-size: 15px; color: var(--text-secondary); line-height: 2; }

/* 有料CTA */
.premium-cta { background: linear-gradient(160deg, rgba(20,16,8,0.95), rgba(30,24,10,0.95)); border: 1px solid rgba(212,175,55,0.3); padding: 2.5rem; text-align: center; }
.cta-header { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-bottom: 1rem; }
.cta-ornament { font-size: 14px; color: var(--gold); opacity: 0.6; }
.cta-title { font-family: 'Shippori Mincho', serif; font-size: 20px; color: #f0e6d3; margin: 0; }
.cta-lead { font-size: 15px; color: var(--text-secondary); line-height: 1.9; margin-bottom: 2rem; }
.cta-features { display: flex; flex-direction: column; gap: 12px; margin-bottom: 2rem; text-align: left; background: rgba(255,255,255,0.03); border-radius: var(--radius-lg); padding: 1.25rem; border: 0.5px solid rgba(255,255,255,0.08); }
.cta-feature { display: flex; align-items: center; gap: 12px; }
.cta-feature-icon { font-size: 20px; flex-shrink: 0; }
.cta-feature-name { font-size: 14px; color: #f0e6d3; margin: 0 0 2px; font-weight: 500; }
.cta-feature-desc { font-size: 12px; color: var(--text-secondary); margin: 0; }
.cta-divider { display: flex; align-items: center; gap: 12px; margin-bottom: 1.25rem; color: var(--text-muted); font-size: 12px; }
.cta-divider::before, .cta-divider::after { content: ''; flex: 1; height: 0.5px; background: rgba(212,175,55,0.2); }
.cta-plans { display: flex; gap: 10px; margin-bottom: 1rem; }
.cta-plan { flex: 1; background: rgba(255,255,255,0.04); border: 0.5px solid rgba(255,255,255,0.15); border-radius: var(--radius-md); padding: 1rem 0.5rem; cursor: pointer; transition: all 0.2s; position: relative; text-align: center; }
.cta-plan:hover { border-color: var(--gold); transform: translateY(-2px); }
.cta-plan-featured { border-color: rgba(212,175,55,0.5); background: rgba(212,175,55,0.08); }
.cta-plan-badge { position: absolute; top: -10px; left: 50%; transform: translateX(-50%); background: var(--gold); color: #000; font-size: 10px; font-weight: bold; padding: 2px 10px; border-radius: 999px; white-space: nowrap; }
.cta-plan-coin { font-size: 18px; font-weight: bold; color: #f0e6d3; margin: 0 0 4px; }
.cta-plan-price { font-size: 13px; color: var(--gold); margin: 0 0 4px; }
.cta-plan-note { font-size: 10px; color: var(--text-muted); margin: 0; }
.cta-note { font-size: 11px; color: var(--text-muted); margin-bottom: 1.5rem; }
.cta-btn { width: 100%; padding: 1rem; background: linear-gradient(135deg, #b08d5a, #7a5c2e); color: #fff; border: none; border-radius: var(--radius-md); font-family: 'Shippori Mincho', serif; font-size: 16px; cursor: pointer; letter-spacing: 0.05em; transition: all 0.2s; margin-bottom: 0.75rem; }
.cta-btn:hover { background: linear-gradient(135deg, #c9a96e, #8b6d20); transform: translateY(-1px); }
.cta-sub { font-size: 12px; color: var(--text-muted); margin: 0; }

/* ログイン済みメニュー */
.paid-menu { border-top: 2px solid var(--gold); }
.paid-menu-title { font-family: 'Shippori Mincho', serif; font-size: 18px; color: #f0e6d3; margin-bottom: 0.5rem; }
.paid-menu-desc { font-size: 14px; color: var(--text-secondary); margin-bottom: 1.25rem; line-height: 1.8; }
.coin-bar { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; background: rgba(255,255,255,0.04); border: 0.5px solid rgba(255,255,255,0.1); border-radius: var(--radius-md); padding: 0.6rem 1rem; }
.coin-bar-label { font-size: 12px; color: var(--text-secondary); }
.coin-bar-value { font-size: 16px; color: var(--gold); font-weight: 500; }
.coin-bar-cost { font-size: 11px; color: var(--text-muted); margin-left: auto; }
.reading-btn { max-width: 100%; font-size: 16px; }

/* 詳細結果 */
.talent-section { border-left: 3px solid #5ef0c5; }
.weakness-section { border-left: 3px solid #f59e0b; }
.love-section { border-left: 3px solid #fda4af; }
.work-section { border-left: 3px solid #93c5fd; }
.talent-desc { font-size: 16px; color: var(--text-secondary); line-height: 2.1; }

/* 天職 */
.career-section { background: linear-gradient(135deg, rgba(20,36,56,0.6), rgba(10,12,16,0.8)); }
.career-list { display: flex; flex-direction: column; gap: 1rem; }
.career-item { background: rgba(255,255,255,0.04); border-radius: var(--radius-md); padding: 1.25rem; border: 0.5px solid rgba(212,175,55,0.2); }
.career-name { font-family: 'Shippori Mincho', serif; font-size: 18px; color: #fde68a; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem; }
.career-icon { font-size: 20px; }
.career-reason { font-size: 15px; color: var(--text-secondary); line-height: 1.9; }

/* 大運 */
.daiun-section {}
.daiun-intro { font-size: 14px; color: var(--text-secondary); line-height: 1.9; margin-bottom: 1.5rem; padding: 0.875rem 1rem; background: rgba(255,255,255,0.03); border-radius: var(--radius-md); border: 0.5px solid rgba(255,255,255,0.08); }
.daiun-list { display: flex; flex-direction: column; gap: 1.25rem; }
.daiun-item { border-radius: var(--radius-lg); overflow: hidden; border: 0.5px solid rgba(255,255,255,0.08); }
.daiun-header { display: flex; align-items: center; gap: 1rem; padding: 1rem 1.25rem; background: rgba(255,255,255,0.04); }
.daiun-age { font-size: 13px; color: var(--text-secondary); flex-shrink: 0; min-width: 70px; }
.daiun-kanshi { font-family: 'Shippori Mincho', serif; font-size: 22px; color: #f0e6d3; }
.daiun-gogyo-badge { font-size: 12px; padding: 3px 10px; border-radius: 999px; margin-left: auto; flex-shrink: 0; }
.daiun-theme { font-size: 14px; color: var(--gold); flex: 1; text-align: right; }
.daiun-body { padding: 1rem 1.25rem; background: rgba(0,0,0,0.2); }
.daiun-desc { font-size: 15px; color: var(--text-secondary); line-height: 1.9; margin-bottom: 1rem; }
.daiun-detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem; }
.daiun-detail-item { background: rgba(255,255,255,0.04); border-radius: var(--radius-sm); padding: 0.75rem; }
.daiun-detail-label { font-size: 11px; color: var(--gold); margin-bottom: 4px; }
.daiun-detail-text { font-size: 13px; color: var(--text-secondary); line-height: 1.7; }
.daiun-advice { font-size: 14px; color: #f0e6d3; background: rgba(212,175,55,0.06); border-left: 2px solid var(--gold); padding: 0.75rem 1rem; border-radius: 0 var(--radius-sm) var(--radius-sm) 0; line-height: 1.8; }
.daiun-current { border-color: rgba(212,175,55,0.4) !important; }
.daiun-current .daiun-header { background: rgba(212,175,55,0.08); }
.daiun-current-badge { font-size: 10px; background: var(--gold); color: #000; padding: 2px 8px; border-radius: 999px; font-weight: bold; }

.message-card { background: linear-gradient(135deg, rgba(30,24,10,0.8), rgba(10,12,16,0.9)); border-left: 3px solid var(--gold); }
.key-message-text { font-size: 17px; color: #f0e6d3; line-height: 2.2; }

@keyframes twinkle { 0%,100% { opacity: 0.2; } 50% { opacity: 0.8; } }
</style>

<script is:inline>
const WORKERS_URL = 'https://kyusei-api.seiji-tomizawa.workers.dev';
const GOGYO_COLOR = { '木':'#5ef0c5','火':'#ff8e8e','土':'#d4af37','金':'#c0c0c0','水':'#7eb8f7' };

function applyResult(d) {
  // 命式盤
  document.getElementById('nichu-kan').textContent = d.nichu?.kan || '--';
  document.getElementById('nichu-shi').textContent = d.nichu?.shi || '--';
  document.getElementById('getchu-kan').textContent = d.getchu?.kan || '--';
  document.getElementById('getchu-shi').textContent = d.getchu?.shi || '--';
  document.getElementById('nenchu-kan').textContent = d.nenchu?.kan || '--';
  document.getElementById('nenchu-shi').textContent = d.nenchu?.shi || '--';
  document.getElementById('getchu-tsuhen').textContent = d.tsuhensei?.[1] || '';
  document.getElementById('nenchu-tsuhen').textContent = d.tsuhensei?.[0] || '';
  if (d.jichu) {
    document.getElementById('jichu-kan').textContent = d.jichu.kan;
    document.getElementById('jichu-shi').textContent = d.jichu.shi;
    document.getElementById('jichu-tsuhen').textContent = d.tsuhensei?.[2] || '';
  }
  document.getElementById('juniun-chip').textContent = '十二運：' + (d.juniunSelf || '');
  document.getElementById('gogyo-chip').textContent = '五行：' + (d.nikkanGogyo || '');
  document.getElementById('inyo-chip').textContent = d.nikkanInyo || '';

  // 日干
  document.getElementById('nikkan-label').textContent = '日干 · ' + d.nikkan + '（' + (d.nikkanSymbol || d.nikkan) + '）';
  document.getElementById('nikkan-name').textContent = d.nikkan + '（' + (d.nikkanSymbol || '') + '）';
  document.getElementById('nikkan-gogyo').textContent = (d.nikkanGogyo || '') + 'の気 · ' + (d.nikkanInyo || '');
  document.getElementById('nikkan-personality').textContent = d.personality || '';

  // 天中殺
  document.getElementById('tenchusatsu-name').textContent = d.shukumeisei || '';
  document.getElementById('tenchusatsu-desc').textContent = d.tenchusatsuDesc || '';
  if (d.tenchusatsuStrength) {
    document.getElementById('tenchusatsu-strength').textContent = d.tenchusatsuStrength;
    document.getElementById('tenchusatsu-caution').textContent = d.tenchusatsuCaution || '';
    document.getElementById('tenchusatsu-advice').textContent = d.tenchusatsuAdvice || '';
    document.getElementById('tenchusatsu-detail').style.display = 'flex';
  }
}

function applyPremiumResult(d) {
  // 才能・特性（D1テキスト）
  document.getElementById('talent-title').textContent = d.talentTitle || '才能・特性';
  document.getElementById('talent-desc').textContent = d.talentDesc || d.talent || '';
  document.getElementById('weakness-title').textContent = d.weaknessTitle || 'あなたへのやさしい注意点';
  document.getElementById('weakness-desc').textContent = d.weaknessDesc || d.weakness || '';
  document.getElementById('love-title').textContent = d.loveTitle || '恋愛でのあなたらしさ';
  document.getElementById('love-desc').textContent = d.loveDesc || d.love || '';
  document.getElementById('work-title').textContent = d.workTitle || '仕事でのあなたの輝き方';
  document.getElementById('work-desc').textContent = d.workDesc || d.work || '';
  document.getElementById('key-message').textContent = d.keyMessage || '';

  // 天職（D1テキスト）
  const CAREER_ICONS = ['🌟','💼','🎯','✨'];
  const careerList = document.getElementById('career-list');
  careerList.innerHTML = (d.careers || []).map(function(c, i) {
    return '<div class="career-item">' +
      '<p class="career-name"><span class="career-icon">' + (CAREER_ICONS[i] || '✦') + '</span>' + c.career_name + '</p>' +
      '<p class="career-reason">' + c.career_reason + '</p>' +
      '</div>';
  }).join('');

  // 大運（D1テキスト付き）
  const now = new Date();
  const currentYear = now.getFullYear();
  const daiunList = document.getElementById('daiun-list');
  const GOGYO_MAP = {'甲':'木','乙':'木','丙':'火','丁':'火','戊':'土','己':'土','庚':'金','辛':'金','壬':'水','癸':'水'};
  const GOGYO_BG = {'木':'rgba(94,240,197,0.15)','火':'rgba(255,142,142,0.15)','土':'rgba(212,175,55,0.15)','金':'rgba(192,192,192,0.15)','水':'rgba(126,184,247,0.15)'};
  const GOGYO_COLOR2 = {'木':'#5ef0c5','火':'#ff8e8e','土':'#d4af37','金':'#c0c0c0','水':'#7eb8f7'};

  daiunList.innerHTML = (d.enrichedDaiun || d.daiun || []).map(function(u) {
    const gogyo = GOGYO_MAP[u.kan] || '土';
    const color = GOGYO_COLOR2[gogyo] || '#d4af37';
    const bg = GOGYO_BG[gogyo] || 'rgba(212,175,55,0.15)';
    const isCurrent = u.age <= (currentYear - (d.birthYear || 1990)) && (currentYear - (d.birthYear || 1990)) < u.age + 10;
    const t = u.text;

    return '<div class="daiun-item' + (isCurrent ? ' daiun-current' : '') + '">' +
      '<div class="daiun-header">' +
        (isCurrent ? '<span class="daiun-current-badge">現在</span>' : '') +
        '<span class="daiun-age">' + u.age + '歳〜</span>' +
        '<span class="daiun-kanshi">' + u.kan + u.shi + '</span>' +
        (t ? '<span class="daiun-theme">' + t.theme + '</span>' : '') +
        '<span class="daiun-gogyo-badge" style="background:' + bg + ';color:' + color + '">' + gogyo + '</span>' +
      '</div>' +
      (t ? '<div class="daiun-body">' +
        '<p class="daiun-desc">' + t.description + '</p>' +
        '<div class="daiun-detail-grid">' +
          '<div class="daiun-detail-item"><p class="daiun-detail-label">❤️ 恋愛・人間関係</p><p class="daiun-detail-text">' + t.love + '</p></div>' +
          '<div class="daiun-detail-item"><p class="daiun-detail-label">💼 仕事・事業</p><p class="daiun-detail-text">' + t.work + '</p></div>' +
        '</div>' +
        '<p class="daiun-advice">💡 ' + t.advice + '</p>' +
      '</div>' : '') +
    '</div>';
  }).join('');

  document.getElementById('premium-result').style.display = 'block';
}

// 自動入力・ログイン済みは自動鑑定
(function() {
  const token = localStorage.getItem('kyusei_token');
  const user = JSON.parse(localStorage.getItem('kyusei_user') || 'null');
  if (!user || !user.birth_date) return;

  const [y, m, d] = user.birth_date.split('-').map(Number);
  document.getElementById('year').value = y;
  document.getElementById('month').value = m;
  document.getElementById('day').value = d;
  if (user.gender) document.getElementById('gender').value = user.gender;

  if (token) {
    // ログイン済みは自動鑑定
    const formCard = document.getElementById('form-card');
    if (formCard) formCard.style.display = 'none';
    autoRunShichu(y, m, d, user.gender || 'f', token);
  } else {
    // 未ログインはバナー表示
    const banner = document.getElementById('autofill-banner');
    if (banner) {
      banner.textContent = (user.display_name || user.email.split('@')[0]) + 'さんの生年月日を自動入力しました';
      banner.style.display = 'block';
    }
  }
})();

async function autoRunShichu(year, month, day, gender, token) {
  try {
    const res = await fetch(
      WORKERS_URL + '/api/shichu/preview?year=' + year + '&month=' + month + '&day=' + day + '&hour=unknown&gender=' + gender
    );
    const d = await res.json();
    applyResult(d);

    // ログイン済みなので詳細メニューを表示
    document.getElementById('premium-cta').style.display = 'none';
    document.getElementById('paid-menu').style.display = 'block';
    loadBalance(token);

    document.getElementById('result-section').style.display = 'block';
    document.getElementById('result-section').querySelectorAll('.result-item').forEach(function(el, i) {
      setTimeout(function() { el.classList.add('show'); }, i * 150);
    });
  } catch(e) {
    const formCard = document.getElementById('form-card');
    if (formCard) formCard.style.display = 'block';
  }
}

async function loadBalance(token) {
  try {
    const res = await fetch(WORKERS_URL + '/api/coins/balance', { headers: { Authorization: 'Bearer ' + token } });
    const data = await res.json();
    document.getElementById('coin-balance').textContent = data.coins + ' コイン';
  } catch {}
}

window.runShichu = async function() {
  const year = document.getElementById('year').value;
  const month = document.getElementById('month').value;
  const day = document.getElementById('day').value;
  const time = document.getElementById('time').value;
  const gender = document.getElementById('gender').value;
  const errEl = document.getElementById('form-error');

  if (!year || parseInt(year) < 1900 || parseInt(year) > 2010) {
    errEl.textContent = '生年を正しく入力してください（1900〜2010）'; return;
  }
  errEl.textContent = '';

  const btn = document.getElementById('btn');
  btn.textContent = '命式を解析中...'; btn.disabled = true;

  try {
    const res = await fetch(
      WORKERS_URL + '/api/shichu/preview?year=' + year + '&month=' + month + '&day=' + day + '&hour=' + time + '&gender=' + gender
    );
    const d = await res.json();
    applyResult(d);

    // ログイン状態で表示切替
    const token = localStorage.getItem('kyusei_token');
    if (token) {
      document.getElementById('premium-cta').style.display = 'none';
      document.getElementById('paid-menu').style.display = 'block';
      loadBalance(token);
    } else {
      document.getElementById('premium-cta').style.display = 'block';
      document.getElementById('paid-menu').style.display = 'none';
    }

    const section = document.getElementById('result-section');
    section.style.display = 'block';
    setTimeout(function() {
      section.querySelectorAll('.result-item').forEach(function(el, i) {
        setTimeout(function() { el.classList.add('show'); }, i * 150);
      });
      section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 50);
  } catch(e) {
    errEl.textContent = 'エラーが発生しました。しばらくしてお試しください。';
  } finally {
    btn.textContent = '✦ 命式を作成する（無料）'; btn.disabled = false;
  }
};

window.runReading = async function() {
  const token = localStorage.getItem('kyusei_token');
  if (!token) { window.location.href = '/login'; return; }

  const year = document.getElementById('year').value;
  const month = document.getElementById('month').value;
  const day = document.getElementById('day').value;
  const time = document.getElementById('time').value;
  const gender = document.getElementById('gender').value;
  const errEl = document.getElementById('reading-error');
  const btn = document.getElementById('reading-btn');

  errEl.textContent = '';
  btn.textContent = '鑑定中...'; btn.disabled = true;

  try {
    const res = await fetch(
      WORKERS_URL + '/api/shichu/reading?year=' + year + '&month=' + month + '&day=' + day + '&hour=' + time + '&gender=' + gender,
      { headers: { Authorization: 'Bearer ' + token } }
    );
    const d = await res.json();

    if (!res.ok) { errEl.textContent = d.error || 'エラーが発生しました'; return; }

    applyPremiumResult(d);
    document.getElementById('paid-menu').style.display = 'none';
    document.getElementById('coin-balance').textContent = d.remainingCoins + ' コイン';

    document.getElementById('premium-result').scrollIntoView({ behavior: 'smooth', block: 'start' });
  } catch {
    errEl.textContent = '通信エラーが発生しました。しばらくしてお試しください。';
  } finally {
    btn.textContent = '🌳 詳細鑑定を受ける（3コイン）'; btn.disabled = false;
  }
};

// 星背景
const starsEl = document.getElementById('stars');
for (let i = 0; i < 50; i++) {
  const s = document.createElement('div');
  const size = Math.random() * 2 + 1;
  s.style.cssText = 'position:absolute;border-radius:50%;background:#fff;width:' + size + 'px;height:' + size + 'px;top:' + (Math.random()*100) + '%;left:' + (Math.random()*100) + '%;opacity:' + (Math.random()*0.5+0.1) + ';animation:twinkle ' + (2+Math.random()*3) + 's ease-in-out infinite;animation-delay:' + (Math.random()*3) + 's;';
  starsEl.appendChild(s);
}
</script>