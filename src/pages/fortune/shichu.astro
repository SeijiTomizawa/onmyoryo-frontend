</style>

<script is:inline>
const WORKERS_URL = 'https://kyusei-api.seiji-tomizawa.workers.dev';
const GOGYO_COLOR = { '木':'#5ef0c5','火':'#ff8e8e','土':'#d4af37','金':'#c0c0c0','水':'#7eb8f7' };
const GOGYO_BG = { '木':'rgba(94,240,197,0.15)','火':'rgba(255,142,142,0.15)','土':'rgba(212,175,55,0.15)','金':'rgba(192,192,192,0.15)','水':'rgba(126,184,247,0.15)' };
const GOGYO_MAP = {'甲':'木','乙':'木','丙':'火','丁':'火','戊':'土','己':'土','庚':'金','辛':'金','壬':'水','癸':'水'};
const CAREER_ICONS = ['🌟','💼','🎯','✨'];
let currentYear = 0, currentMonth = 0, currentDay = 0;

function applyResult(d) {
  document.getElementById('nichu-kan').textContent = d.nichu?.kan || '--';
  document.getElementById('nichu-shi').textContent = d.nichu?.shi || '--';
  document.getElementById('getchu-kan').textContent = d.getchu?.kan || '--';
  document.getElementById('getchu-shi').textContent = d.getchu?.shi || '--';
  document.getElementById('nenchu-kan').textContent = d.nenchu?.kan || '--';
  document.getElementById('nenchu-shi').textContent = d.nenchu?.shi || '--';
  document.getElementById('getchu-tsuhen').textContent = d.tsuhensei?.[1] || '';
  document.getElementById('nenchu-tsuhen').textContent = d.tsuhensei?.[0] || '';
  if (d.jichu) {
    document.getElementById('jichu-kan').textContent = d.jichu.kan;
    document.getElementById('jichu-shi').textContent = d.jichu.shi;
    document.getElementById('jichu-tsuhen').textContent = d.tsuhensei?.[2] || '';
  }
  document.getElementById('juniun-chip').textContent = '十二運：' + (d.juniunSelf || '');
  document.getElementById('gogyo-chip').textContent = '五行：' + (d.nikkanGogyo || '');
  document.getElementById('inyo-chip').textContent = d.nikkanInyo || '';

  document.getElementById('nikkan-label').textContent = '日干 · ' + d.nikkan + '（' + (d.nikkanSymbol || d.nikkan) + '）';
  document.getElementById('nikkan-name').textContent = d.nikkan + '（' + (d.nikkanSymbol || '') + '）';
  document.getElementById('nikkan-gogyo').textContent = (d.nikkanGogyo || '') + 'の気 · ' + (d.nikkanInyo || '');
  document.getElementById('nikkan-personality').textContent = d.personality || '';

  document.getElementById('tenchusatsu-name').textContent = d.shukumeisei || '';
  document.getElementById('tenchusatsu-desc').textContent = d.tenchusatsuDesc || '';
  document.getElementById('tenchusatsu-strength').textContent = d.tenchusatsuStrength || '';
  document.getElementById('tenchusatsu-caution').textContent = d.tenchusatsuCaution || '';
  document.getElementById('tenchusatsu-advice').textContent = d.tenchusatsuAdvice || '';
}

function applyPremiumResult(d) {
  document.getElementById('talent-title').textContent = d.talentTitle || '才能・特性';
  document.getElementById('talent-desc').textContent = d.talentDesc || d.talent || '';
  document.getElementById('weakness-title').textContent = d.weaknessTitle || 'あなたへのやさしい注意点';
  document.getElementById('weakness-desc').textContent = d.weaknessDesc || d.weakness || '';
  document.getElementById('love-title').textContent = d.loveTitle || '恋愛でのあなたらしさ';
  document.getElementById('love-desc').textContent = d.loveDesc || d.love || '';
  document.getElementById('work-title').textContent = d.workTitle || '仕事でのあなたの輝き方';
  document.getElementById('work-desc').textContent = d.workDesc || d.work || '';
  document.getElementById('key-message').textContent = d.keyMessage || '';

  const careerList = document.getElementById('career-list');
  careerList.innerHTML = (d.careers || []).map(function(c, i) {
    return '<div class="career-item">' +
      '<p class="career-name"><span class="career-icon">' + (CAREER_ICONS[i] || '✦') + '</span>' + c.career_name + '</p>' +
      '<p class="career-reason">' + c.career_reason + '</p>' +
      '</div>';
  }).join('');

  const birthYear = d.birthYear || parseInt(document.getElementById('year').value) || 1990;
  const ageNow = new Date().getFullYear() - birthYear;
  const daiunList = document.getElementById('daiun-list');
  daiunList.innerHTML = (d.enrichedDaiun || d.daiun || []).map(function(u, idx) {
    const gogyo = GOGYO_MAP[u.kan] || '土';
    const color = GOGYO_COLOR[gogyo] || '#d4af37';
    const bg = GOGYO_BG[gogyo] || 'rgba(212,175,55,0.15)';
    const isCurrent = u.age <= ageNow && ageNow < (u.age + 10);
    const t = u.text;
    const bodyId = 'daiun-body-' + idx;
    // 現在の大運は開いた状態、それ以外は閉じた状態
    const isOpen = isCurrent;

    return '<div class="daiun-item' + (isCurrent ? ' daiun-current' : '') + '">' +
      '<div class="daiun-header">' +
        '<div class="daiun-header-left">' +
          '<span class="daiun-age">' + u.age + '歳〜' + (u.age + 9) + '歳</span>' +
          '<span class="daiun-kanshi">' + u.kan + u.shi + '</span>' +
        '</div>' +
        '<div class="daiun-header-center">' +
          (t ? '<span class="daiun-theme">' + t.theme + '</span>' : '') +
          '<span class="daiun-gogyo-badge" style="background:' + bg + ';color:' + color + '">' + gogyo + 'の気</span>' +
        '</div>' +
        '<div class="daiun-header-right">' +
          (isCurrent ? '<span class="daiun-current-badge">✦ 現在の大運</span>' : '') +
          (t ? '<button class="daiun-toggle" onclick="toggleDaiun(\'' + bodyId + '\', this)">' + (isOpen ? '▲ 閉じる' : '▼ 詳細') + '</button>' : '') +
        '</div>' +
      '</div>' +
      (t ? '<div class="daiun-body" id="' + bodyId + '" style="display:' + (isOpen ? 'block' : 'none') + '">' +
        '<p class="daiun-desc">' + t.description + '</p>' +
        '<div class="daiun-detail-grid">' +
          '<div class="daiun-detail-item"><p class="daiun-detail-label">❤️ 恋愛・人間関係</p><p class="daiun-detail-text">' + t.love + '</p></div>' +
          '<div class="daiun-detail-item"><p class="daiun-detail-label">💼 仕事・事業</p><p class="daiun-detail-text">' + t.work + '</p></div>' +
        '</div>' +
        '<p class="daiun-advice">💡 ' + t.advice + '</p>' +
      '</div>' : '') +
    '</div>';
  }).join('');

  document.getElementById('premium-result').style.display = 'block';
}

// 後天天中殺の表示
function applyKochiten(data) {
  const setItem = function(id, kanshi, isTC) {
    const el = document.getElementById(id);
    el.querySelector('.kochiten-kanshi').textContent = kanshi;
    const statusEl = el.querySelector('.kochiten-status');
    if (isTC) {
      el.classList.add('is-tc');
      statusEl.textContent = '⚠ 天中殺';
    } else {
      el.classList.add('not-tc');
      statusEl.textContent = '✓ 通常期';
    }
  };
  setItem('kt-year-item', data.thisYear + '年 ' + data.yearKanshi, data.isYearTC);
  setItem('kt-month-item', data.thisMonth + '月 ' + data.monthKanshi, data.isMonthTC);
  setItem('kt-day-item', '今日 ' + data.dayKanshi, data.isDayTC);

  if (data.tcMonths && data.tcMonths.length > 0) {
    document.getElementById('kochiten-months-chips').innerHTML =
      data.tcMonths.map(function(m) { return '<span class="kochiten-month-chip">' + data.thisYear + '年' + m + '月</span>'; }).join('');
    document.getElementById('kochiten-months-section').style.display = 'block';
  }
  if (data.tcDays && data.tcDays.length > 0) {
    document.getElementById('kochiten-days-chips').innerHTML =
      data.tcDays.map(function(d) { return '<span class="kochiten-day-chip">' + d + '日</span>'; }).join('');
    document.getElementById('kochiten-days-section').style.display = 'block';
  }
  document.getElementById('kochiten-coin-info').textContent = '残りコイン: ' + data.remainingCoins + 'C';
  document.getElementById('kochiten-result').style.display = 'block';
  document.getElementById('kochiten-btn-area').style.display = 'none';
}

// 自動入力・ログイン済みは自動鑑定
(function() {
  const token = localStorage.getItem('kyusei_token');
  const user = JSON.parse(localStorage.getItem('kyusei_user') || 'null');
  if (!user || !user.birth_date) return;

  const [y, m, d] = user.birth_date.split('-').map(Number);
  document.getElementById('year').value = y;
  document.getElementById('month').value = m;
  document.getElementById('day').value = d;
  if (user.gender) document.getElementById('gender').value = user.gender;

  if (token) {
    document.getElementById('form-card').style.display = 'none';
    // 後天天中殺ボタンのログイン状態設定
    document.getElementById('kochiten-login-note').style.display = 'none';
    document.getElementById('kochiten-btn').style.display = 'block';
    loadBalance(token);
    autoRunShichu(y, m, d, user.gender || 'f', token);
  } else {
    const banner = document.getElementById('autofill-banner');
    banner.textContent = (user.display_name || user.email.split('@')[0]) + 'さんの生年月日を自動入力しました';
    banner.style.display = 'block';
    document.getElementById('kochiten-login-note').style.display = 'block';
    document.getElementById('kochiten-btn').style.display = 'none';
  }
})();

async function autoRunShichu(year, month, day, gender, token) {
  try {
    const res = await fetch(
      WORKERS_URL + '/api/shichu/preview?year=' + year + '&month=' + month + '&day=' + day + '&hour=unknown&gender=' + gender
    );
    const d = await res.json();
    applyResult(d);
    document.getElementById('premium-cta').style.display = 'none';
    document.getElementById('paid-menu').style.display = 'block';

    // 鑑定済みの詳細結果をlocalStorageから復元
    const savedKey = 'shichu_premium_' + year + '_' + month + '_' + day;
    const saved = localStorage.getItem(savedKey);
    if (saved) {
      try {
        const savedData = JSON.parse(saved);
        applyPremiumResult(savedData);
        document.getElementById('paid-menu').style.display = 'none';
      } catch(e) {}
    }

    document.getElementById('result-section').style.display = 'block';
    document.getElementById('result-section').querySelectorAll('.result-item').forEach(function(el, i) {
      setTimeout(function() { el.classList.add('show'); }, i * 150);
    });
  } catch(e) {
    document.getElementById('form-card').style.display = 'block';
  }
}

async function loadBalance(token) {
  try {
    const res = await fetch(WORKERS_URL + '/api/coins/balance', { headers: { Authorization: 'Bearer ' + token } });
    const data = await res.json();
    document.getElementById('coin-balance').textContent = data.coins + ' コイン';
  } catch {}
}

window.toggleDaiun = function(id, btn) {
  const body = document.getElementById(id);
  if (!body) return;
  if (body.style.display === 'none') {
    body.style.display = 'block';
    if (btn) btn.textContent = '▲';
  } else {
    body.style.display = 'none';
    if (btn) btn.textContent = '▼';
  }
};

window.runShichu = async function() {
  const year = document.getElementById('year').value;
  const month = document.getElementById('month').value;
  const day = document.getElementById('day').value;
  const time = document.getElementById('time').value;
  const gender = document.getElementById('gender').value;
  const errEl = document.getElementById('form-error');
  if (!year || parseInt(year) < 1900 || parseInt(year) > 2010) { errEl.textContent = '生年を正しく入力してください（1900〜2010）'; return; }
  errEl.textContent = '';
  const btn = document.getElementById('btn');
  btn.textContent = '命式を解析中...'; btn.disabled = true;
  try {
    const res = await fetch(WORKERS_URL + '/api/shichu/preview?year=' + year + '&month=' + month + '&day=' + day + '&hour=' + time + '&gender=' + gender);
    const d = await res.json();
    applyResult(d);
    const token = localStorage.getItem('kyusei_token');
    if (token) {
      document.getElementById('premium-cta').style.display = 'none';
      document.getElementById('paid-menu').style.display = 'block';
      loadBalance(token);
      document.getElementById('kochiten-login-note').style.display = 'none';
      document.getElementById('kochiten-btn').style.display = 'block';
    } else {
      document.getElementById('premium-cta').style.display = 'block';
      document.getElementById('paid-menu').style.display = 'none';
      document.getElementById('kochiten-login-note').style.display = 'block';
      document.getElementById('kochiten-btn').style.display = 'none';
    }
    const section = document.getElementById('result-section');
    section.style.display = 'block';
    setTimeout(function() {
      section.querySelectorAll('.result-item').forEach(function(el, i) {
        setTimeout(function() { el.classList.add('show'); }, i * 150);
      });
      section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 50);
  } catch(e) {
    errEl.textContent = 'エラーが発生しました。しばらくしてお試しください。';
  } finally {
    btn.textContent = '✦ 命式を作成する（無料）'; btn.disabled = false;
  }
};

window.runReading = async function() {
  const token = localStorage.getItem('kyusei_token');
  if (!token) { window.location.href = '/login'; return; }
  const year = document.getElementById('year').value;
  const month = document.getElementById('month').value;
  const day = document.getElementById('day').value;
  const time = document.getElementById('time').value;
  const gender = document.getElementById('gender').value;
  const errEl = document.getElementById('reading-error');
  const btn = document.getElementById('reading-btn');
  errEl.textContent = '';
  btn.textContent = '鑑定中...'; btn.disabled = true;
  try {
    const res = await fetch(
      WORKERS_URL + '/api/shichu/reading?year=' + year + '&month=' + month + '&day=' + day + '&hour=' + time + '&gender=' + gender,
      { headers: { Authorization: 'Bearer ' + token } }
    );
    const d = await res.json();
    if (!res.ok) { errEl.textContent = d.error || 'エラーが発生しました'; return; }
    applyPremiumResult(d);
    // localStorageに保存（次回自動表示用）
    const savedKey = 'shichu_premium_' + year + '_' + month + '_' + day;
    localStorage.setItem(savedKey, JSON.stringify(d));
    document.getElementById('paid-menu').style.display = 'none';
    const coinEl = document.getElementById('coin-balance');
    if (coinEl) coinEl.textContent = d.remainingCoins + ' コイン';
    document.getElementById('premium-result').scrollIntoView({ behavior: 'smooth', block: 'start' });
  } catch {
    errEl.textContent = '通信エラーが発生しました。しばらくしてお試しください。';
  } finally {
    btn.textContent = '🌳 詳細鑑定を受ける（3コイン）'; btn.disabled = false;
  }
};

