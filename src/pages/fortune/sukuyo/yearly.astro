---
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/global.css';
---
<Layout title="宿曜 年間運勢 | 陰陽寮">
  <div class="page">
    <div class="stars" id="stars"></div>
    <div class="page-inner">

      <header class="page-header fade-in-up">
        <a href="/fortune/sukuyo" class="back-link">← 宿曜占星術に戻る</a>
        <h1 class="page-title">📅 年間運勢</h1>
        <p class="page-desc">あなたの本宿が今年・来年に迎える運気の波と、最も輝く月を解き明かします</p>
      </header>

      <!-- コイン残高 -->
      <div class="coin-bar fade-in-up delay-1" id="coin-bar" style="display:none">
        <span class="coin-bar-label">保有コイン</span>
        <span class="coin-bar-value" id="coin-balance">-- コイン</span>
        <span class="coin-bar-cost">年間運勢 3コイン</span>
      </div>

      <!-- 確認カード -->
      <div class="glass-card confirm-card fade-in-up delay-1" id="confirm-card">
        <div class="confirm-shuku">
          <div class="confirm-symbol" id="c-symbol">🌙</div>
          <div>
            <p class="confirm-num" id="c-num">—</p>
            <h2 class="confirm-name" id="c-name">—</h2>
          </div>
        </div>

        <!-- 年選択 -->
        <div class="year-select-row">
          <label class="year-label">対象年を選択</label>
          <div class="year-btns">
            <button class="year-btn active" onclick="selectYear(this, 0)" id="btn-this-year">今年</button>
            <button class="year-btn" onclick="selectYear(this, 1)" id="btn-next-year">来年</button>
          </div>
        </div>

        <div class="confirm-contents">
          <p class="contents-label">✦ 鑑定内容</p>
          <div class="contents-grid">
            <span class="content-chip">🌟 年間総合運</span>
            <span class="content-chip">📅 月別運気チャート</span>
            <span class="content-chip">🔴 要注意月・時期</span>
            <span class="content-chip">💫 絶好調の吉月</span>
            <span class="content-chip">💡 年間アドバイス</span>
          </div>
        </div>

        <div id="login-note" style="display:none">
          <p class="login-text">鑑定にはログインが必要です</p>
          <a href="/login" class="btn-primary" style="display:inline-block;text-decoration:none;text-align:center">ログイン・新規登録</a>
        </div>
        <button class="btn-primary reading-btn" id="reading-btn" onclick="runYearly()" style="display:none">📅 年間運勢を見る（3コイン）</button>
        <p class="error-msg" id="reading-error"></p>
      </div>

      <!-- 結果セクション -->
      <div id="result-section" style="display:none">
        <div class="result-grid">

          <!-- ヒーローカード -->
          <div class="glass-card yearly-hero fade-in-up">
            <div class="hero-row">
              <div>
                <p class="hero-shuku-label" id="r-shuku-label"></p>
                <h2 class="hero-year" id="r-year-title"></h2>
              </div>
              <div class="hero-symbol" id="r-symbol"></div>
            </div>
            <p class="hero-overview" id="r-overview"></p>
            <div class="hero-tags" id="r-tags"></div>
          </div>

          <!-- 月別運気チャート -->
          <div class="glass-card result-block fade-in-up">
            <div class="block-header">
              <span class="block-icon">📊</span>
              <h3 class="block-title">月別運気チャート</h3>
            </div>
            <div class="month-chart" id="month-chart"></div>
            <div class="chart-legend">
              <span class="legend-item"><span class="legend-dot great"></span>絶好調</span>
              <span class="legend-item"><span class="legend-dot good"></span>好調</span>
              <span class="legend-item"><span class="legend-dot normal"></span>普通</span>
              <span class="legend-item"><span class="legend-dot caution"></span>注意</span>
            </div>
          </div>

          <!-- 吉月 -->
          <div class="glass-card result-block lucky-months-block fade-in-up">
            <div class="block-header">
              <span class="block-icon">💫</span>
              <h3 class="block-title">絶好調の吉月</h3>
            </div>
            <div class="lucky-months" id="r-lucky-months"></div>
          </div>

          <!-- 注意月 -->
          <div class="glass-card result-block caution-block fade-in-up">
            <div class="block-header">
              <span class="block-icon">🔴</span>
              <h3 class="block-title">要注意の時期</h3>
            </div>
            <div id="r-caution-months"></div>
          </div>

          <!-- 月別詳細 -->
          <div class="glass-card result-block fade-in-up">
            <div class="block-header">
              <span class="block-icon">📅</span>
              <h3 class="block-title">月別メッセージ</h3>
            </div>
            <div class="month-details" id="r-month-details"></div>
          </div>

          <!-- 年間アドバイス -->
          <div class="glass-card result-block advice-block fade-in-up">
            <div class="block-header">
              <span class="block-icon">💡</span>
              <h3 class="block-title">今年のあなたへ</h3>
            </div>
            <p class="block-text" id="r-advice"></p>
          </div>

          <!-- 次のアクション -->
          <div class="glass-card result-block next-block fade-in-up" style="text-align:center">
            <p class="next-title">さらに深く読み解きましょう</p>
            <div class="next-grid">
              <a href="#" id="reading-link" class="next-btn"><span>🔮</span><span>詳細鑑定</span><span class="next-cost">2C</span></a>
              <a href="/fortune/compat" class="next-btn"><span>❤️</span><span>相性鑑定</span><span class="next-cost">3C</span></a>
              <a href="/fortune/eki" class="next-btn"><span>☯️</span><span>易占い</span><span class="next-cost">1C</span></a>
            </div>
            <button class="btn-secondary" onclick="resetResult()" style="margin-top:1.25rem">別の年を見る</button>
          </div>

        </div>
      </div>

    </div>
  </div>
</Layout>

<style>
.page { padding: 3rem 1.5rem; min-height: 100vh; position: relative; }
.stars { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
.page-inner { max-width: 680px; margin: 0 auto; position: relative; z-index: 1; }
.back-link { display: inline-block; font-size: 13px; color: var(--text-secondary); text-decoration: none; margin-bottom: 1rem; transition: color 0.2s; }
.back-link:hover { color: #c4b5fd; }
.page-header { margin-bottom: 1.5rem; }
.page-title { font-family: 'Shippori Mincho', serif; font-size: 1.75rem; color: #c4b5fd; margin-bottom: 0.4rem; }
.page-desc { font-size: 13px; color: var(--text-secondary); line-height: 1.8; }

.coin-bar { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem; background: rgba(124,111,205,0.08); border: 0.5px solid rgba(124,111,205,0.25); border-radius: var(--radius-md); padding: 0.75rem 1rem; }
.coin-bar-label { font-size: 12px; color: var(--text-secondary); }
.coin-bar-value { font-size: 16px; color: #c4b5fd; font-weight: 500; }
.coin-bar-cost { font-size: 11px; color: var(--text-muted); margin-left: auto; }

.confirm-card { border-top: 2px solid #7c6fcd; margin-bottom: 1.25rem; }
.confirm-shuku { display: flex; align-items: center; gap: 1.25rem; margin-bottom: 1.5rem; }
.confirm-symbol { font-size: 52px; color: #c4b5fd; line-height: 1; filter: drop-shadow(0 0 12px rgba(124,111,205,0.5)); }
.confirm-num { font-size: 11px; color: #c4b5fd; letter-spacing: 0.15em; margin-bottom: 4px; }
.confirm-name { font-family: 'Shippori Mincho', serif; font-size: 1.75rem; color: #f0e6d3; }

.year-select-row { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.25rem; }
.year-label { font-size: 13px; color: var(--text-secondary); }
.year-btns { display: flex; gap: 8px; }
.year-btn { padding: 0.5rem 1.25rem; background: #ffffff08; border: 0.5px solid #ffffff22; color: var(--text-secondary); border-radius: var(--radius-md); font-size: 14px; cursor: pointer; transition: all 0.15s; font-family: 'Noto Serif JP', serif; }
.year-btn.active { background: rgba(124,111,205,0.2); border-color: rgba(124,111,205,0.5); color: #c4b5fd; font-weight: bold; }

.confirm-contents { background: rgba(124,111,205,0.07); border-radius: var(--radius-md); padding: 1rem; margin-bottom: 1.25rem; }
.contents-label { font-size: 11px; color: #c4b5fd; letter-spacing: 0.1em; margin-bottom: 0.75rem; }
.contents-grid { display: flex; flex-wrap: wrap; gap: 8px; }
.content-chip { font-size: 13px; padding: 5px 12px; border-radius: 999px; background: rgba(124,111,205,0.12); color: #c4b5fd; border: 0.5px solid rgba(124,111,205,0.25); }
.login-text { font-size: 13px; color: var(--text-secondary); text-align: center; margin-bottom: 0.75rem; }
.reading-btn { width: 100%; }
.error-msg { font-size: 13px; color: #ff8e8e; min-height: 1.2em; margin-top: 0.5rem; }

.result-grid { display: flex; flex-direction: column; gap: 1.25rem; }
.result-block { padding: 1.5rem; }
.block-header { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; padding-bottom: 0.75rem; border-bottom: 0.5px solid rgba(124,111,205,0.2); }
.block-icon { font-size: 20px; }
.block-title { font-family: 'Shippori Mincho', serif; font-size: 17px; color: #c4b5fd; margin: 0; }
.block-text { font-size: 15px; color: var(--text-secondary); line-height: 2.1; }

/* ヒーロー */
.yearly-hero { border-top: 3px solid #7c6fcd; padding: 2rem; background: linear-gradient(160deg, rgba(20,16,40,0.9), rgba(10,12,16,0.95)); }
.hero-row { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.25rem; }
.hero-shuku-label { font-size: 12px; color: #c4b5fd; letter-spacing: 0.1em; margin-bottom: 0.5rem; }
.hero-year { font-family: 'Shippori Mincho', serif; font-size: 1.75rem; color: #f0e6d3; }
.hero-symbol { font-size: 52px; color: #c4b5fd; filter: drop-shadow(0 0 15px rgba(124,111,205,0.5)); }
.hero-overview { font-size: 15px; color: #d4c5a9; line-height: 2.1; border-left: 3px solid #7c6fcd; padding-left: 1rem; margin-bottom: 1rem; }
.hero-tags { display: flex; flex-wrap: wrap; gap: 8px; }
.hero-tag { font-size: 12px; padding: 4px 12px; border-radius: 999px; background: rgba(124,111,205,0.12); color: #c4b5fd; border: 0.5px solid rgba(124,111,205,0.25); }

/* 月別チャート */
.month-chart { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; margin-bottom: 1rem; }
.month-bar-wrap { display: flex; flex-direction: column; align-items: center; gap: 4px; }
.month-label { font-size: 10px; color: var(--text-secondary); }
.month-bar { width: 100%; border-radius: 4px 4px 0 0; min-height: 8px; transition: all 0.3s; }
.month-bar.great { background: linear-gradient(180deg, #5ef0c5, #2dd4bf); }
.month-bar.good { background: linear-gradient(180deg, #c4b5fd, #7c6fcd); }
.month-bar.normal { background: rgba(255,255,255,0.15); }
.month-bar.caution { background: linear-gradient(180deg, #fca5a5, #ef4444); }
.month-score { font-size: 10px; color: var(--text-secondary); }
.chart-legend { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; }
.legend-item { display: flex; align-items: center; gap: 4px; font-size: 11px; color: var(--text-secondary); }
.legend-dot { width: 10px; height: 10px; border-radius: 50%; }
.legend-dot.great { background: #5ef0c5; }
.legend-dot.good { background: #c4b5fd; }
.legend-dot.normal { background: rgba(255,255,255,0.2); }
.legend-dot.caution { background: #fca5a5; }

/* 吉月・注意月 */
.lucky-months { display: flex; flex-wrap: wrap; gap: 10px; }
.lucky-month-item { display: flex; flex-direction: column; align-items: center; gap: 4px; background: rgba(94,240,197,0.08); border: 0.5px solid rgba(94,240,197,0.25); border-radius: var(--radius-md); padding: 0.875rem 1.25rem; }
.lucky-month-num { font-family: 'Shippori Mincho', serif; font-size: 1.4rem; color: #5ef0c5; font-weight: bold; }
.lucky-month-label { font-size: 10px; color: var(--text-secondary); }
.lucky-month-desc { font-size: 11px; color: #6ee7b7; text-align: center; max-width: 80px; line-height: 1.5; }

.lucky-months-block { border-left: 3px solid #5ef0c5; }
.caution-block { border-left: 3px solid #ef4444; }
.caution-items { display: flex; flex-direction: column; gap: 0.75rem; }
.caution-item { background: rgba(239,68,68,0.06); border: 0.5px solid rgba(239,68,68,0.2); border-radius: var(--radius-md); padding: 0.875rem 1rem; }
.caution-month { font-family: 'Shippori Mincho', serif; font-size: 15px; color: #fca5a5; margin-bottom: 4px; }
.caution-desc { font-size: 13px; color: var(--text-secondary); line-height: 1.8; }

/* 月別詳細 */
.month-details { display: flex; flex-direction: column; gap: 0.75rem; }
.month-detail-item { display: flex; gap: 1rem; padding: 0.875rem; background: rgba(255,255,255,0.03); border-radius: var(--radius-md); border: 0.5px solid rgba(255,255,255,0.07); align-items: flex-start; }
.month-detail-num { font-family: 'Shippori Mincho', serif; font-size: 1.25rem; color: #c4b5fd; white-space: nowrap; min-width: 36px; padding-top: 2px; }
.month-detail-text { font-size: 13px; color: var(--text-secondary); line-height: 1.9; }

.advice-block { border-top: 3px solid #f59e0b; background: linear-gradient(135deg, rgba(20,16,5,0.5), rgba(10,8,3,0.7)); }
.next-block { background: linear-gradient(135deg, rgba(20,16,40,0.6), rgba(10,12,16,0.8)); }
.next-title { font-size: 14px; color: var(--text-secondary); margin-bottom: 1.25rem; }
.next-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.next-btn { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 1rem 0.5rem; background: rgba(255,255,255,0.04); border: 0.5px solid rgba(255,255,255,0.1); border-radius: var(--radius-md); text-decoration: none; transition: all 0.2s; font-size: 13px; color: #f0e6d3; }
.next-btn:hover { border-color: #7c6fcd; background: rgba(124,111,205,0.1); transform: translateY(-2px); }
.next-btn span:first-child { font-size: 22px; }
.next-cost { font-size: 11px; color: #c4b5fd; background: rgba(124,111,205,0.15); padding: 2px 10px; border-radius: 999px; }
.btn-secondary { background: transparent; border: 0.5px solid rgba(255,255,255,0.2); color: var(--text-secondary); padding: 0.6rem 1.5rem; border-radius: var(--radius-md); font-size: 14px; cursor: pointer; font-family: 'Noto Serif JP', serif; }

@keyframes twinkle { 0%,100%{opacity:0.15}50%{opacity:0.7} }
</style>

<script is:inline>
const WORKERS_URL = 'https://kyusei-api.seiji-tomizawa.workers.dev';
const LEVEL_MAP = { 5: 'great', 4: 'good', 3: 'normal', 2: 'caution', 1: 'caution' };
const LEVEL_HEIGHT = { 5: 60, 4: 44, 3: 28, 2: 16, 1: 8 };

const params = new URLSearchParams(location.search);
const qYear = params.get('year');
const qMonth = params.get('month');
const qDay = params.get('day');
let targetYearOffset = 0;
const currentYear = new Date().getFullYear();

(async function init() {
  const token = localStorage.getItem('kyusei_token');
  const user = JSON.parse(localStorage.getItem('kyusei_user') || 'null');
  const year = qYear || user?.birth_date?.split('-')[0];
  const month = qMonth || user?.birth_date?.split('-')[1];
  const day = qDay || user?.birth_date?.split('-')[2];

  // ボタンのテキスト設定
  document.getElementById('btn-this-year').textContent = `今年（${currentYear}年）`;
  document.getElementById('btn-next-year').textContent = `来年（${currentYear + 1}年）`;

  if (!year) return;

  try {
    const res = await fetch(`${WORKERS_URL}/api/sukuyo/preview?year=${year}&month=${month}&day=${day}`);
    const data = await res.json();
    document.getElementById('c-symbol').textContent = data.symbol || '🌙';
    document.getElementById('c-num').textContent = '第' + (data.shukuIndex + 1) + '宿';
    document.getElementById('c-name').textContent = data.shuku;
  } catch {}

  document.getElementById('reading-link').href = `/fortune/sukuyo/reading?year=${year}&month=${month}&day=${day}`;

  if (token) {
    document.getElementById('coin-bar').style.display = 'flex';
    document.getElementById('reading-btn').style.display = 'block';
    document.getElementById('login-note').style.display = 'none';
    loadBalance(token);
  } else {
    document.getElementById('login-note').style.display = 'block';
    document.getElementById('reading-btn').style.display = 'none';
  }
})();

async function loadBalance(token) {
  try {
    const res = await fetch(`${WORKERS_URL}/api/coins/balance`, { headers: { Authorization: 'Bearer ' + token } });
    const data = await res.json();
    document.getElementById('coin-balance').textContent = data.coins + ' コイン';
  } catch {}
}

window.selectYear = function(btn, offset) {
  targetYearOffset = offset;
  document.querySelectorAll('.year-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
};

window.runYearly = async function() {
  const token = localStorage.getItem('kyusei_token');
  if (!token) { window.location.href = '/login'; return; }
  const user = JSON.parse(localStorage.getItem('kyusei_user') || 'null');
  const year = qYear || user?.birth_date?.split('-')[0];
  const month = qMonth || user?.birth_date?.split('-')[1];
  const day = qDay || user?.birth_date?.split('-')[2];
  const targetYear = currentYear + targetYearOffset;

  const errEl = document.getElementById('reading-error');
  const btn = document.getElementById('reading-btn');
  errEl.textContent = '';
  btn.textContent = '鑑定中...'; btn.disabled = true;

  try {
    const res = await fetch(`${WORKERS_URL}/api/sukuyo/yearly`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
      body: JSON.stringify({ year: parseInt(year), month: parseInt(month), day: parseInt(day), targetYear }),
    });
    const data = await res.json();
    if (!res.ok) { errEl.textContent = data.error || 'エラーが発生しました'; return; }
    displayResult(data, targetYear);
  } catch {
    errEl.textContent = '通信エラーが発生しました。';
  } finally {
    btn.textContent = '📅 年間運勢を見る（3コイン）'; btn.disabled = false;
  }
};

function displayResult(data, targetYear) {
  document.getElementById('r-symbol').textContent = data.symbol || '🌙';
  document.getElementById('r-shuku-label').textContent = data.shuku + 'の';
  document.getElementById('r-year-title').textContent = `${targetYear}年 年間運勢`;
  document.getElementById('r-overview').textContent = data.overview || '';
  document.getElementById('r-advice').textContent = data.advice || '';

  // タグ
  document.getElementById('r-tags').innerHTML = (data.keywords || []).map(k =>
    `<span class="hero-tag">${k}</span>`
  ).join('');

  // 月別チャート
  const months = data.months || [];
  document.getElementById('month-chart').innerHTML = months.map((m, i) => {
    const level = m.level || 3;
    const cls = LEVEL_MAP[level] || 'normal';
    const h = LEVEL_HEIGHT[level] || 28;
    return `<div class="month-bar-wrap">
      <div class="month-bar ${cls}" style="height:${h}px"></div>
      <span class="month-label">${i+1}月</span>
    </div>`;
  }).join('');

  // 吉月
  const luckyMonths = months.filter(m => m.level >= 4);
  document.getElementById('r-lucky-months').innerHTML = luckyMonths.map(m =>
    `<div class="lucky-month-item">
      <span class="lucky-month-num">${m.month}月</span>
      <span class="lucky-month-label">${m.level === 5 ? '🌟 絶好調' : '✨ 好調'}</span>
      <span class="lucky-month-desc">${m.keyword || ''}</span>
    </div>`
  ).join('') || '<p style="font-size:13px;color:var(--text-secondary)">今年は着実に積み上げる年です</p>';

  // 注意月
  const cautionMonths = months.filter(m => m.level <= 2);
  document.getElementById('r-caution-months').innerHTML = `<div class="caution-items">` +
    (cautionMonths.map(m =>
      `<div class="caution-item">
        <p class="caution-month">${m.month}月</p>
        <p class="caution-desc">${m.advice || m.message || '慎重に行動しましょう'}</p>
      </div>`
    ).join('') || '<p style="font-size:13px;color:var(--text-secondary)">今年は大きな低迷期はありません</p>') +
  `</div>`;

  // 月別詳細
  document.getElementById('r-month-details').innerHTML = months.map(m =>
    `<div class="month-detail-item">
      <span class="month-detail-num">${m.month}月</span>
      <p class="month-detail-text">${m.message || ''}</p>
    </div>`
  ).join('');

  if (data.remainingCoins !== undefined) {
    document.getElementById('coin-balance').textContent = data.remainingCoins + ' コイン';
  }

  document.getElementById('confirm-card').style.display = 'none';
  document.getElementById('coin-bar').style.display = 'none';
  document.getElementById('result-section').style.display = 'block';
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

window.resetResult = function() {
  document.getElementById('result-section').style.display = 'none';
  document.getElementById('confirm-card').style.display = 'block';
  document.getElementById('coin-bar').style.display = 'flex';
  window.scrollTo({ top: 0, behavior: 'smooth' });
};

const starsEl = document.getElementById('stars');
for (let i = 0; i < 60; i++) {
  const s = document.createElement('div');
  const size = Math.random() * 2 + 1;
  s.style.cssText = `position:absolute;border-radius:50%;background:#fff;width:${size}px;height:${size}px;top:${Math.random()*100}%;left:${Math.random()*100}%;opacity:${Math.random()*0.4+0.1};animation:twinkle ${2+Math.random()*3}s ease-in-out infinite;animation-delay:${Math.random()*3}s;`;
  starsEl.appendChild(s);
}
</script>