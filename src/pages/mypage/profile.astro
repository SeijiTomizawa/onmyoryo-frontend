---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
---
<Layout title="プロフィール管理 | 陰陽寮">
  <div class="page">
    <div class="stars" id="stars"></div>
    <div class="page-inner">

      <header class="page-header fade-in-up">
        <a href="/mypage" class="back-link">← マイページへ戻る</a>
        <h1 class="page-title">プロフィール管理</h1>
        <p class="page-desc">登録情報の確認・変更ができます</p>
      </header>

      <!-- 基本情報 -->
      <div class="glass-card section-card fade-in-up delay-1">
        <h2 class="section-title">基本情報</h2>
        <p class="section-note">登録した生年月日は各占いページで自動的に入力されます</p>

        <div class="form-group">
          <label class="form-label">表示名（ニックネーム）</label>
          <input type="text" id="display-name" placeholder="例：さとみ" maxlength="20" />
          <p class="form-hint">占い結果のお呼びかけに使われます</p>
        </div>

        <div class="form-group">
          <label class="form-label">生年月日</label>
          <div class="date-row">
            <div class="field">
              <label class="field-label">年</label>
              <input type="number" id="birth-year" placeholder="1990" min="1900" max="2010" />
            </div>
            <div class="field">
              <label class="field-label">月</label>
              <select id="birth-month">
                {Array.from({length:12},(_,i)=>(
                  <option value={i+1}>{i+1}月</option>
                ))}
              </select>
            </div>
            <div class="field">
              <label class="field-label">日</label>
              <select id="birth-day">
                {Array.from({length:31},(_,i)=>(
                  <option value={i+1}>{i+1}日</option>
                ))}
              </select>
            </div>
          </div>
          <p class="form-hint">各占いページで自動入力されます</p>
        </div>

        <div class="form-group">
          <label class="form-label">性別</label>
          <div class="gender-row">
            <button class="gender-btn" id="gender-f" onclick="setGender('f')">女性</button>
            <button class="gender-btn" id="gender-m" onclick="setGender('m')">男性</button>
          </div>
          <p class="form-hint">四柱推命の大運計算に使用されます</p>
        </div>

        <p class="success-msg" id="profile-success" style="display:none">✓ プロフィールを更新しました</p>
        <p class="error-msg" id="profile-error"></p>
        <button class="btn-primary save-btn" onclick="saveProfile()">プロフィールを保存する</button>
      </div>

      <!-- メールアドレス -->
      <div class="glass-card section-card fade-in-up delay-2">
        <h2 class="section-title">メールアドレス</h2>
        <div class="form-group">
          <label class="form-label">現在のメールアドレス</label>
          <div class="email-display" id="email-display">読み込み中...</div>
        </div>
        <p class="form-note">※ メールアドレスの変更は現在サポートしていません</p>
      </div>

      <!-- パスワード変更 -->
      <div class="glass-card section-card fade-in-up delay-3">
        <h2 class="section-title">パスワード変更</h2>

        <div class="form-group">
          <label class="form-label">現在のパスワード</label>
          <div class="password-wrap">
            <input type="password" id="current-password" placeholder="現在のパスワード" />
            <button class="toggle-pw" onclick="togglePw('current-password', this)">表示</button>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">新しいパスワード</label>
          <div class="password-wrap">
            <input type="password" id="new-password" placeholder="8文字以上" />
            <button class="toggle-pw" onclick="togglePw('new-password', this)">表示</button>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">新しいパスワード（確認）</label>
          <div class="password-wrap">
            <input type="password" id="confirm-password" placeholder="もう一度入力" />
            <button class="toggle-pw" onclick="togglePw('confirm-password', this)">表示</button>
          </div>
        </div>

        <p class="success-msg" id="password-success" style="display:none">✓ パスワードを変更しました</p>
        <p class="error-msg" id="password-error"></p>
        <button class="btn-primary save-btn" onclick="savePassword()">パスワードを変更する</button>
      </div>

      <!-- アカウント情報 -->
      <div class="glass-card section-card fade-in-up delay-4">
        <h2 class="section-title">アカウント情報</h2>
        <div class="info-row">
          <span class="info-label">登録日</span>
          <span class="info-value" id="created-at">--</span>
        </div>
        <div class="info-row">
          <span class="info-label">保有コイン</span>
          <span class="info-value coin-value" id="coin-count">--</span>
        </div>
      </div>

    </div>
  </div>
</Layout>

<style>
.page { padding: 2rem 1.5rem; min-height: 100vh; position: relative; }
.stars { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
.page-inner { max-width: 560px; margin: 0 auto; position: relative; z-index: 1; }
.page-header { margin-bottom: 2rem; }
.back-link { font-size: 13px; color: var(--text-secondary); text-decoration: none; display: inline-block; margin-bottom: 0.75rem; }
.back-link:hover { color: var(--gold); }
.page-title { font-family: 'Shippori Mincho', serif; font-size: 24px; margin-bottom: 0.25rem; }
.page-desc { font-size: 13px; color: var(--text-secondary); }

.section-card { margin-bottom: 1.25rem; }
.section-title { font-family: 'Shippori Mincho', serif; font-size: 18px; margin-bottom: 0.375rem; color: #f0e6d3; }
.section-note { font-size: 13px; color: var(--gold); margin-bottom: 1.5rem; }
.section-sub { font-size: 13px; color: var(--text-secondary); margin-bottom: 1.5rem; }
.form-note { font-size: 12px; color: var(--text-muted); margin-top: 0.5rem; }

.form-group { margin-bottom: 1.25rem; }
.form-label { font-size: 13px; color: var(--text-secondary); display: block; margin-bottom: 0.4rem; }
.form-hint { font-size: 11px; color: var(--text-muted); margin-top: 4px; }

.date-row { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 8px; }
.field { display: flex; flex-direction: column; gap: 4px; }
.field-label { font-size: 11px; color: var(--text-muted); }

.password-wrap { display: flex; gap: 8px; align-items: center; }
.password-wrap input { flex: 1; }
.toggle-pw {
  background: transparent; border: 0.5px solid #ffffff22;
  color: var(--text-secondary); padding: 0.5rem 0.75rem;
  border-radius: var(--radius-sm); font-size: 12px; cursor: pointer;
  font-family: 'Noto Serif JP', serif; white-space: nowrap; flex-shrink: 0;
}
.toggle-pw:hover { border-color: var(--gold); color: var(--gold); }

.save-btn { max-width: 100%; margin-top: 0.5rem; }
.gender-row { display: flex; gap: 10px; }
.gender-btn {
  flex: 1; padding: 0.6rem; background: rgba(255,255,255,0.05);
  border: 0.5px solid rgba(255,255,255,0.2); border-radius: var(--radius-md);
  color: var(--text-secondary); font-family: 'Noto Serif JP', serif;
  font-size: 15px; cursor: pointer; transition: all 0.2s;
}
.gender-btn.active {
  border-color: var(--gold); background: rgba(212,175,55,0.15);
  color: var(--gold);
}
.success-msg { font-size: 14px; color: #1d9e75; margin-bottom: 0.75rem; }

.email-display {
  font-size: 16px; color: #f0e6d3; padding: 0.6rem 0.875rem;
  background: #ffffff08; border: 0.5px solid #ffffff15;
  border-radius: var(--radius-sm);
}

.info-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 0.875rem 0; border-bottom: 0.5px solid #ffffff0d;
}
.info-row:last-child { border-bottom: none; }
.info-label { font-size: 14px; color: var(--text-secondary); }
.info-value { font-size: 15px; color: #f0e6d3; }
.coin-value { color: var(--gold); font-weight: 500; }

@keyframes twinkle { 0%,100% { opacity: 0.2; } 50% { opacity: 0.8; } }
</style>

<script is:inline>
const WORKERS_URL = 'https://kyusei-api.seiji-tomizawa.workers.dev';

async function init() {
  const token = localStorage.getItem('kyusei_token');
  if (!token) { window.location.href = '/login'; return; }

  try {
    const res = await fetch(`${WORKERS_URL}/api/profile`, {
      headers: { Authorization: `Bearer ${token}` }
    });
    const data = await res.json();
    if (!res.ok) { window.location.href = '/login'; return; }

    const u = data.user;

    // 基本情報を表示
    document.getElementById('display-name').value = u.display_name || '';
    document.getElementById('email-display').textContent = u.email;

    // 生年月日をセット
    if (u.birth_date) {
      const [y, m, d] = u.birth_date.split('-').map(Number);
      document.getElementById('birth-year').value = y;
      document.getElementById('birth-month').value = m;
      document.getElementById('birth-day').value = d;
    }

    // アカウント情報
    document.getElementById('coin-count').textContent = `${u.coins} コイン`;
    document.getElementById('created-at').textContent =
      new Date(u.created_at).toLocaleDateString('ja-JP');

  } catch {
    window.location.href = '/login';
  }
}

async function saveProfile() {
  const token = localStorage.getItem('kyusei_token');
  const display_name = document.getElementById('display-name').value.trim();
  const year = document.getElementById('birth-year').value;
  const month = String(document.getElementById('birth-month').value).padStart(2, '0');
  const day = String(document.getElementById('birth-day').value).padStart(2, '0');
  const errEl = document.getElementById('profile-error');
  const sucEl = document.getElementById('profile-success');

  errEl.textContent = '';
  sucEl.style.display = 'none';

  if (!year || parseInt(year) < 1900 || parseInt(year) > 2010) {
    errEl.textContent = '生年を正しく入力してください'; return;
  }

  const birth_date = `${year}-${month}-${day}`;
  const gender = document.querySelector('.gender-btn.active')?.id === 'gender-m' ? 'm' : 'f';

  try {
    const res = await fetch(`${WORKERS_URL}/api/profile`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ display_name, birth_date, gender }),
    });
    const data = await res.json();
    if (!res.ok) { errEl.textContent = data.error; return; }

    // localStorageのユーザー情報を更新
    const user = JSON.parse(localStorage.getItem('kyusei_user') || '{}');
    user.display_name = display_name;
    user.birth_date = birth_date;
    user.gender = gender;
    localStorage.setItem('kyusei_user', JSON.stringify(user));

    sucEl.style.display = 'block';
    setTimeout(() => sucEl.style.display = 'none', 3000);
  } catch {
    errEl.textContent = 'エラーが発生しました。しばらくしてお試しください。';
  }
}

async function savePassword() {
  const token = localStorage.getItem('kyusei_token');
  const current = document.getElementById('current-password').value;
  const newPw = document.getElementById('new-password').value;
  const confirm = document.getElementById('confirm-password').value;
  const errEl = document.getElementById('password-error');
  const sucEl = document.getElementById('password-success');

  errEl.textContent = '';
  sucEl.style.display = 'none';

  if (!current || !newPw || !confirm) { errEl.textContent = 'すべての項目を入力してください'; return; }
  if (newPw.length < 8) { errEl.textContent = '新しいパスワードは8文字以上にしてください'; return; }
  if (newPw !== confirm) { errEl.textContent = '新しいパスワードが一致しません'; return; }

  try {
    const res = await fetch(`${WORKERS_URL}/api/profile/password`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ current_password: current, new_password: newPw }),
    });
    const data = await res.json();
    if (!res.ok) { errEl.textContent = data.error; return; }

    document.getElementById('current-password').value = '';
    document.getElementById('new-password').value = '';
    document.getElementById('confirm-password').value = '';
    sucEl.style.display = 'block';
    setTimeout(() => sucEl.style.display = 'none', 3000);
  } catch {
    errEl.textContent = 'エラーが発生しました。しばらくしてお試しください。';
  }
}

function setGender(g) {
  document.getElementById('gender-f').classList.toggle('active', g === 'f');
  document.getElementById('gender-m').classList.toggle('active', g === 'm');
}

function togglePw(id, btn) {
  const input = document.getElementById(id);
  if (input.type === 'password') {
    input.type = 'text'; btn.textContent = '隠す';
  } else {
    input.type = 'password'; btn.textContent = '表示';
  }
}

// 星背景
const starsEl = document.getElementById('stars');
for (let i = 0; i < 40; i++) {
  const s = document.createElement('div');
  const size = Math.random() * 2 + 1;
  s.style.cssText = `position:absolute;border-radius:50%;background:#fff;width:${size}px;height:${size}px;top:${Math.random()*100}%;left:${Math.random()*100}%;opacity:${Math.random()*0.4+0.1};animation:twinkle ${2+Math.random()*3}s ease-in-out infinite;animation-delay:${Math.random()*3}s;`;
  starsEl.appendChild(s);
}

init();
</script>
