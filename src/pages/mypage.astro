---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---
<Layout title="マイページ | 陰陽寮">
  <div class="page">
    <div class="stars" id="stars"></div>
    <div class="page-inner">

      <!-- プロフィールヘッダー -->
      <div class="profile-header fade-in-up">
        <div class="profile-card glass-card">
          <div class="profile-left">
            <div class="avatar" id="user-avatar">陰</div>
            <div class="profile-info">
              <p class="welcome-text">ようこそ</p>
              <h1 class="user-name" id="user-greeting">--様</h1>
              <div class="star-badges" id="star-badges"></div>
            </div>
          </div>
          <div class="profile-right">
            <div class="coin-block">
              <p class="coin-label">保有コイン</p>
              <p class="coin-amount" id="coin-amount">--<span>C</span></p>
              <button class="btn-charge" onclick="window.location.href='/mypage/charge'">＋ チャージ</button>
            </div>
          </div>
        </div>
      </div>

      <!-- 今日のダッシュボード -->
      <div class="today-section fade-in-up delay-1">
        <div class="today-card glass-card">
          <div class="today-header">
            <div>
              <p class="today-date" id="today-date"></p>
              <h2 class="today-title">今日のあなた</h2>
              <p class="today-star" id="today-star"></p>
            </div>
            <div class="score-ring-wrap">
              <div class="score-ring">
                <svg viewBox="0 0 80 80">
                  <circle cx="40" cy="40" r="34" fill="none" stroke="#ffffff10" stroke-width="6"/>
                  <circle cx="40" cy="40" r="34" fill="none" stroke-width="6"
                    stroke-dasharray="213.6" stroke-linecap="round"
                    transform="rotate(-90 40 40)" id="score-circle" stroke="#1d9e75"/>
                </svg>
                <div class="ring-num" id="today-score">--</div>
              </div>
              <p class="score-label" id="score-label-text">運気スコア</p>
            </div>
          </div>
          <div class="today-lucky" id="today-lucky" style="display:none">
            <div class="lucky-row">
              <div class="lucky-chip" id="lc-color"></div>
              <div class="lucky-chip" id="lc-direction"></div>
              <div class="lucky-chip" id="lc-item"></div>
              <div class="lucky-chip" id="lc-food"></div>
            </div>
          </div>
          <div class="today-actions">
            <button class="btn-today-detail" id="btn-today-detail" onclick="goToDaily()">
              ☀️ 本日の詳細運勢を鑑定する
              <span class="btn-cost">1C</span>
            </button>
          </div>
        </div>
      </div>

      <!-- 占術メニュー -->
      <div class="section fade-in-up delay-2">
        <h2 class="section-title">✦ 占術メニュー</h2>
        <div class="fortune-menu">

          <div class="menu-group">
            <p class="menu-group-label">無料鑑定</p>
            <a href="/fortune/kyuseiki" class="menu-item free">
              <span class="menu-icon">☯️</span>
              <div class="menu-info">
                <p class="menu-name">九星気学</p>
                <p class="menu-desc">本命星・月命星・性格・年運・月運</p>
              </div>
              <span class="menu-badge free-badge">無料</span>
            </a>
            <a href="/fortune/shichu" class="menu-item free">
              <span class="menu-icon">🌳</span>
              <div class="menu-info">
                <p class="menu-name">四柱推命・算命学</p>
                <p class="menu-desc">命式盤・日干・宿命天中殺</p>
              </div>
              <span class="menu-badge free-badge">無料</span>
            </a>
          </div>

          <div class="menu-group">
            <p class="menu-group-label">1コイン鑑定</p>
            <a href="/fortune/daily" class="menu-item">
              <span class="menu-icon">☀️</span>
              <div class="menu-info">
                <p class="menu-name">本日の運勢</p>
                <p class="menu-desc">ラッキーカラー・方角・おすすめ行動</p>
              </div>
              <span class="menu-badge">1C</span>
            </a>
            <a href="/fortune/eki" class="menu-item">
              <span class="menu-icon">☰</span>
              <div class="menu-info">
                <p class="menu-name">易占い</p>
                <p class="menu-desc">64卦から今の問いへの答えを導く</p>
              </div>
              <span class="menu-badge">1C</span>
            </a>
            <a href="/fortune/shichu" class="menu-item">
              <span class="menu-icon">⛓️</span>
              <div class="menu-info">
                <p class="menu-name">後天天中殺</p>
                <p class="menu-desc">今年・今月・今日の天中殺を確認</p>
              </div>
              <span class="menu-badge">1C</span>
            </a>
          </div>

          <div class="menu-group">
            <p class="menu-group-label">2コイン鑑定</p>
            <a href="/fortune/monthly" class="menu-item">
              <span class="menu-icon">🌙</span>
              <div class="menu-info">
                <p class="menu-name">月運詳細</p>
                <p class="menu-desc">今月の運気・吉日・恋愛・仕事・金運</p>
              </div>
              <span class="menu-badge">2C</span>
            </a>
            <a href="/fortune/sukuyo" class="menu-item">
              <span class="menu-icon">🌟</span>
              <div class="menu-info">
                <p class="menu-name">宿曜占星術</p>
                <p class="menu-desc">27宿から読む宿命と今月の運勢</p>
              </div>
              <span class="menu-badge">2C</span>
            </a>
          </div>

          <div class="menu-group">
            <p class="menu-group-label">3コイン鑑定</p>
            <a href="/fortune/compat" class="menu-item">
              <span class="menu-icon">❤️</span>
              <div class="menu-info">
                <p class="menu-name">相性鑑定</p>
                <p class="menu-desc">九星気学で読む相手との縁と相性</p>
              </div>
              <span class="menu-badge premium-badge">3C</span>
            </a>
            <a href="/fortune/shichu" class="menu-item">
              <span class="menu-icon">💎</span>
              <div class="menu-info">
                <p class="menu-name">四柱推命 詳細鑑定</p>
                <p class="menu-desc">才能・天職・恋愛・大運の完全鑑定</p>
              </div>
              <span class="menu-badge premium-badge">3C</span>
            </a>
          </div>

        </div>
      </div>

      <!-- 最近の鑑定履歴 -->
      <div class="section fade-in-up delay-3">
        <h2 class="section-title">✦ 最近の鑑定履歴</h2>
        <div class="history-list" id="history-list">
          <div class="history-loading">読み込み中...</div>
        </div>
        <button class="btn-more-history" id="btn-more-history" style="display:none" onclick="loadMoreHistory()">
          もっと見る
        </button>
      </div>

      <!-- プロフィール設定 -->
      <div class="section fade-in-up delay-3">
        <div class="settings-card glass-card">
          <h2 class="settings-title">プロフィール設定</h2>
          <div class="settings-links">
            <a href="/mypage/profile" class="settings-link">
              <span>👤</span>
              <span>生年月日・性別・表示名の変更</span>
              <span class="settings-arrow">›</span>
            </a>
            <a href="/mypage/charge" class="settings-link">
              <span>💰</span>
              <span>コインをチャージする</span>
              <span class="settings-arrow">›</span>
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</Layout>

<style>
.page { padding: 2rem 1.25rem 4rem; min-height: 100vh; position: relative; }
.stars { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
.page-inner { max-width: 720px; margin: 0 auto; position: relative; z-index: 1; display: flex; flex-direction: column; gap: 1.5rem; }

/* プロフィールカード */
.profile-card { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.5rem; flex-wrap: wrap; }
.profile-left { display: flex; align-items: center; gap: 1.25rem; }
.avatar { width: 64px; height: 64px; border-radius: 50%; background: linear-gradient(135deg, #b08d5a, #7a5c2e); display: flex; align-items: center; justify-content: center; font-family: 'Shippori Mincho', serif; font-size: 26px; color: #fff; flex-shrink: 0; border: 2px solid rgba(212,175,55,0.4); }
.welcome-text { font-size: 11px; color: var(--text-muted); margin-bottom: 2px; letter-spacing: 0.1em; }
.user-name { font-family: 'Shippori Mincho', serif; font-size: 24px; color: #f0e6d3; margin-bottom: 6px; }
.star-badges { display: flex; gap: 6px; flex-wrap: wrap; }
.star-badge { font-size: 12px; padding: 3px 10px; border-radius: 999px; background: rgba(212,175,55,0.12); color: var(--gold); border: 0.5px solid rgba(212,175,55,0.3); }
.profile-right { text-align: right; }
.coin-label { font-size: 11px; color: var(--text-muted); margin-bottom: 4px; }
.coin-amount { font-size: 32px; font-weight: bold; color: var(--gold); line-height: 1; margin-bottom: 8px; }
.coin-amount span { font-size: 18px; }
.btn-charge { background: linear-gradient(135deg, #b08d5a, #7a5c2e); color: #fff; border: none; padding: 8px 20px; border-radius: var(--radius-md); font-size: 14px; cursor: pointer; font-family: 'Noto Serif JP', serif; transition: all 0.2s; white-space: nowrap; }
.btn-charge:hover { background: linear-gradient(135deg, #c9a96e, #8b6d20); transform: translateY(-1px); }

/* 今日のカード */
.today-card { padding: 1.5rem; }
.today-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
.today-date { font-size: 12px; color: var(--text-muted); margin-bottom: 4px; }
.today-title { font-family: 'Shippori Mincho', serif; font-size: 20px; color: #f0e6d3; margin-bottom: 4px; }
.today-star { font-size: 13px; color: var(--gold); }
.score-ring-wrap { display: flex; flex-direction: column; align-items: center; gap: 4px; flex-shrink: 0; }
.score-ring { position: relative; width: 72px; height: 72px; }
.score-ring svg { width: 72px; height: 72px; }
.ring-num { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 22px; font-weight: bold; color: #f0e6d3; }
.score-label { font-size: 11px; color: var(--text-muted); text-align: center; }

.today-lucky { margin-bottom: 1.25rem; }
.lucky-row { display: flex; gap: 8px; flex-wrap: wrap; }
.lucky-chip { font-size: 13px; padding: 5px 12px; border-radius: 999px; background: rgba(212,175,55,0.1); color: #fde68a; border: 0.5px solid rgba(212,175,55,0.25); }

.today-actions { display: flex; gap: 8px; }
.btn-today-detail { flex: 1; display: flex; align-items: center; justify-content: center; gap: 8px; padding: 0.875rem; background: linear-gradient(135deg, rgba(176,141,90,0.2), rgba(122,92,46,0.2)); border: 0.5px solid rgba(212,175,55,0.3); border-radius: var(--radius-md); color: #fde68a; font-family: 'Noto Serif JP', serif; font-size: 14px; cursor: pointer; transition: all 0.2s; }
.btn-today-detail:hover { background: linear-gradient(135deg, rgba(176,141,90,0.3), rgba(122,92,46,0.3)); transform: translateY(-1px); }
.btn-cost { font-size: 11px; background: rgba(212,175,55,0.2); padding: 2px 8px; border-radius: 999px; color: var(--gold); }

/* セクション */
.section { display: flex; flex-direction: column; gap: 0.875rem; }
.section-title { font-family: 'Shippori Mincho', serif; font-size: 16px; color: var(--gold); letter-spacing: 0.1em; }

/* 占術メニュー */
.fortune-menu { display: flex; flex-direction: column; gap: 1.25rem; }
.menu-group { background: var(--dark-card); border: 0.5px solid rgba(255,255,255,0.08); border-radius: var(--radius-lg); overflow: hidden; }
.menu-group-label { font-size: 11px; color: var(--text-muted); padding: 0.625rem 1rem; background: rgba(255,255,255,0.03); border-bottom: 0.5px solid rgba(255,255,255,0.06); letter-spacing: 0.1em; }
.menu-item { display: flex; align-items: center; gap: 1rem; padding: 1rem; text-decoration: none; border-bottom: 0.5px solid rgba(255,255,255,0.05); transition: all 0.15s; }
.menu-item:last-child { border-bottom: none; }
.menu-item:hover { background: rgba(212,175,55,0.06); }
.menu-icon { font-size: 22px; flex-shrink: 0; width: 36px; text-align: center; }
.menu-info { flex: 1; }
.menu-name { font-size: 15px; color: #f0e6d3; margin-bottom: 2px; font-family: 'Shippori Mincho', serif; }
.menu-desc { font-size: 12px; color: var(--text-muted); }
.menu-badge { font-size: 11px; padding: 3px 12px; border-radius: 999px; flex-shrink: 0; }
.free-badge { background: rgba(29,158,117,0.15); color: #1d9e75; border: 0.5px solid rgba(29,158,117,0.3); }
.menu-badge:not(.free-badge):not(.premium-badge) { background: rgba(212,175,55,0.12); color: var(--gold); border: 0.5px solid rgba(212,175,55,0.3); }
.premium-badge { background: rgba(124,111,205,0.15); color: #a78bfa; border: 0.5px solid rgba(124,111,205,0.3); }

/* 履歴 */
.history-list { display: flex; flex-direction: column; gap: 8px; }
.history-loading { text-align: center; color: var(--text-muted); font-size: 14px; padding: 2rem; }
.history-empty { text-align: center; color: var(--text-muted); font-size: 14px; padding: 2rem; background: var(--dark-card); border-radius: var(--radius-md); border: 0.5px solid rgba(255,255,255,0.06); }
.history-item { display: flex; align-items: center; gap: 1rem; padding: 1rem; background: var(--dark-card); border: 0.5px solid rgba(255,255,255,0.08); border-radius: var(--radius-md); cursor: pointer; transition: all 0.15s; }
.history-item:hover { border-color: rgba(212,175,55,0.3); background: rgba(212,175,55,0.04); }
.history-icon { font-size: 20px; flex-shrink: 0; width: 36px; text-align: center; }
.history-info { flex: 1; }
.history-type { font-size: 14px; color: #f0e6d3; margin-bottom: 2px; }
.history-date { font-size: 12px; color: var(--text-muted); }
.history-cost { font-size: 12px; color: var(--gold); flex-shrink: 0; }
.btn-more-history { width: 100%; padding: 0.75rem; background: transparent; border: 0.5px solid rgba(255,255,255,0.15); color: var(--text-secondary); border-radius: var(--radius-md); font-size: 14px; cursor: pointer; font-family: 'Noto Serif JP', serif; transition: all 0.2s; }
.btn-more-history:hover { border-color: var(--gold); color: var(--gold); }

/* 設定 */
.settings-card { padding: 1.25rem; }
.settings-title { font-family: 'Shippori Mincho', serif; font-size: 16px; color: #f0e6d3; margin-bottom: 1rem; }
.settings-links { display: flex; flex-direction: column; gap: 0; }
.settings-link { display: flex; align-items: center; gap: 1rem; padding: 0.875rem 0.5rem; text-decoration: none; color: var(--text-secondary); font-size: 14px; border-bottom: 0.5px solid rgba(255,255,255,0.06); transition: all 0.15s; }
.settings-link:last-child { border-bottom: none; }
.settings-link:hover { color: #f0e6d3; }
.settings-arrow { margin-left: auto; color: var(--text-muted); font-size: 18px; }

@keyframes twinkle { 0%,100%{opacity:0.2}50%{opacity:0.8} }
</style>

<script is:inline>
const WORKERS_URL = 'https://kyusei-api.seiji-tomizawa.workers.dev';
const READING_TYPES = {
  'basic': { name: '四柱推命鑑定', icon: '🌳' },
  'monthly': { name: '月運詳細鑑定', icon: '🌙' },
  'yearly': { name: '年運鑑定', icon: '📅' },
  'compat': { name: '相性鑑定', icon: '❤️' },
  'daily': { name: '本日の運勢', icon: '☀️' },
  'eki': { name: '易占い', icon: '☰' },
  'sukuyo': { name: '宿曜占星術', icon: '🌟' },
};

const STAR_NAMES = {
  1:'一白水星',2:'二黒土星',3:'三碧木星',4:'四緑木星',5:'五黄土星',
  6:'六白金星',7:'七赤金星',8:'八白土星',9:'九紫火星'
};

const SCORE_COLOR = (s) => s >= 85 ? '#1d9e75' : s >= 70 ? '#f59e0b' : s >= 55 ? '#fb923c' : '#f43f5e';

let historyPage = 0;
const historyPerPage = 5;
let allHistory = [];

async function init() {
  const token = localStorage.getItem('kyusei_token');
  const user = JSON.parse(localStorage.getItem('kyusei_user') || 'null');

  if (!token || !user) {
    window.location.href = '/login';
    return;
  }

  // ユーザー情報
  const name = user.display_name || user.email.split('@')[0];
  document.getElementById('user-greeting').textContent = name + '様';
  document.getElementById('user-avatar').textContent = name.charAt(0);

  // 今日の日付
  const now = new Date();
  const days = ['日','月','火','水','木','金','土'];
  document.getElementById('today-date').textContent =
    now.getFullYear() + '年' + (now.getMonth()+1) + '月' + now.getDate() + '日（' + days[now.getDay()] + '）';

  // 九星気学から本命星・月命星を計算
  if (user.birth_date) {
    const [y, m, d] = user.birth_date.split('-').map(Number);
    const honmei = calcHonmei(y);
    const tsuki = calcTsuki(honmei, m, d);
    const starBadges = document.getElementById('star-badges');
    starBadges.innerHTML =
      '<span class="star-badge">本命星：' + (STAR_NAMES[honmei] || '') + '</span>' +
      '<span class="star-badge">月命星：' + (STAR_NAMES[tsuki] || '') + '</span>';
    document.getElementById('today-star').textContent = STAR_NAMES[honmei] || '';

    // 今日の運気スコアを計算
    const base = new Date(2024, 0, 1);
    const diff = Math.floor((now.getTime() - base.getTime()) / (1000 * 60 * 60 * 24));
    const dayStar = ((9 - (diff % 9)) % 9) + 1;
    const score = calcScore(honmei, dayStar === 0 ? 9 : dayStar);
    document.getElementById('today-score').textContent = score;
    const circle = document.getElementById('score-circle');
    const offset = 213.6 - (213.6 * score / 100);
    circle.setAttribute('stroke-dashoffset', String(offset));
    circle.setAttribute('stroke', SCORE_COLOR(score));
    const label = score >= 85 ? '大吉' : score >= 70 ? '吉' : score >= 55 ? '中吉' : '注意';
    document.getElementById('score-label-text').textContent = label + ' ' + score + '点';
  }

  // コイン残高
  try {
    const res = await fetch(WORKERS_URL + '/api/coins/balance', { headers: { Authorization: 'Bearer ' + token } });
    const data = await res.json();
    document.getElementById('coin-amount').innerHTML = data.coins + '<span>C</span>';
  } catch {}

  // 履歴
  loadHistory(token);
}

async function loadHistory(token) {
  try {
    const res = await fetch(WORKERS_URL + '/api/fortune/history?limit=20', {
      headers: { Authorization: 'Bearer ' + token }
    });
    const data = await res.json();
    allHistory = data.readings || [];
    renderHistory();
  } catch {
    document.getElementById('history-list').innerHTML =
      '<div class="history-empty">履歴を読み込めませんでした</div>';
  }
}

function renderHistory() {
  const list = document.getElementById('history-list');
  if (allHistory.length === 0) {
    list.innerHTML = '<div class="history-empty">まだ鑑定履歴がありません。<br>上のメニューから鑑定を始めてみてください。</div>';
    return;
  }

  const items = allHistory.slice(0, (historyPage + 1) * historyPerPage);
  list.innerHTML = items.map(function(r) {
    const type = READING_TYPES[r.reading_type] || { name: r.reading_type, icon: '✦' };
    const date = new Date(r.created_at);
    const dateStr = date.getFullYear() + '/' + (date.getMonth()+1) + '/' + date.getDate() + ' ' +
      date.getHours() + ':' + String(date.getMinutes()).padStart(2,'0');
    return '<div class="history-item">' +
      '<span class="history-icon">' + type.icon + '</span>' +
      '<div class="history-info">' +
        '<p class="history-type">' + type.name + '</p>' +
        '<p class="history-date">' + dateStr + '</p>' +
      '</div>' +
      '<span class="history-cost">' + r.coins_used + 'C</span>' +
    '</div>';
  }).join('');

  const moreBtn = document.getElementById('btn-more-history');
  if (allHistory.length > (historyPage + 1) * historyPerPage) {
    moreBtn.style.display = 'block';
  } else {
    moreBtn.style.display = 'none';
  }
}

window.loadMoreHistory = function() {
  historyPage++;
  renderHistory();
};

window.goToDaily = function() {
  window.location.href = '/fortune/daily';
};

function calcHonmei(year) {
  const h = (11 - (year % 9)) % 9;
  return h === 0 ? 9 : h;
}

function calcTsuki(honmei, month, day) {
  const cutoffs = [0,6,5,6,5,6,6,7,8,9,8,7,7];
  const adjustedMonth = day < cutoffs[month] ? month - 1 : month;
  const m = ((adjustedMonth - 1) + 12) % 12;
  const base = [8,7,6,5,4,3,2,1,9,8,7,6];
  const offset = base[m];
  const TSUKI_TABLE = [
    [8,7,6,5,4,3,2,1,9,8,7,6],
    [2,1,9,8,7,6,5,4,3,2,1,9],
    [5,4,3,2,1,9,8,7,6,5,4,3],
  ];
  const groupIdx = [1,4,7].includes(honmei) ? 0 : [2,5,8].includes(honmei) ? 1 : 2;
  const t = TSUKI_TABLE[groupIdx][((adjustedMonth - 1) + 12) % 12];
  return t === 0 ? 9 : t;
}

function calcScore(honmei, dayStar) {
  const map = {
    '1-1':65,'1-2':70,'1-3':75,'1-4':80,'1-5':45,'1-6':78,'1-7':82,'1-8':60,'1-9':88,
